{
  "schema_version": 1,
  "_说明": "流程数值与枚举的唯一出处（定稿 P4、H8）。规则、角色、模板只引用键名，不写字面值。改动走普通文档 PR，正文引用 intent。约定：值为 null 表示「待定」，读取方按最保守处理（拦截类不开、上限类不放宽），例外在键旁注明；delegate.billing 用 no_cap: true 表示不设上限（D34）。枚举：budget_check.mode 与 budget.level_mode 取 warn｜enforce。",
  "rules": {
    "claude_md_max_kb": 1.8,
    "rules_md_max_kb": 5,
    "rules_md_max_items": 12,
    "role_file_max_kb": 3,
    "role_files_max": 8,
    "role_rules_max": 3,
    "total_max_kb": 20,
    "total_max_items": 25,
    "branch_rule_change_alert_hours": 24
  },
  "start": {
    "inject_max_kb": 8,
    "required_read_max_kb": 15,
    "start_sheet_p99_seconds": 2,
    "handoff_max_kb": 2,
    "context_remind_pct": 70
  },
  "gates": {
    "_说明": "max_lines.start_sheet 管工具库 ~/.modernize/psa/tools/one-session/start_sheet/start_sheet.py（O23a 起仓库内已无此文件）；它只用标准库，SessionStart 挂载与门一致用 /usr/bin/python3 -I，不吃 PATH（调度 10-27）。",
    "runtime_max_lines": 1500,
    "runtime_max_files": 8,
    "hook_p99_ms": 100,
    "per_call_total_ms": 300,
    "precommit_max_seconds": 10,
    "max_lines": {
      "prod_write_gate": 1250,
      "pre_tool_dispatch": 80,
      "main_checkout_gate": 120,
      "commit_msg_gate": 60,
      "install": 60,
      "selftest": 1250,
      "stop_check": 120,
      "agent_tier_gate": 40,
      "post_review": 200,
      "budget_check": 450,
      "light_sh": 120,
      "relevant_change": 600,
      "relevant_change_selftest": 330,
      "build_all": 150,
      "build_decisions": 200,
      "new_intent": 90,
      "start_sheet": 300,
      "delegate": 350,
      "mq": 1200,
      "mq_selftest": 1200
    },
    "install_dir": "~/.modernize/psa/tools/hooks",
    "install_current_link": "current"
  },
  "review": {
    "no_verdict_alert_minutes": 30,
    "verdicts": [
      "通过",
      "必改"
    ],
    "header_fields": [
      "复审结论",
      "commit",
      "复审者"
    ],
    "final_paths": [
      "scripts/gates/",
      "scripts/hooks/",
      "scripts/merge/",
      "scripts/queue/",
      "scripts/review/",
      "scripts/ci/",
      ".claude/",
      ".github/",
      "policy.json",
      ".gitleaks.toml",
      ".pre-commit-config.yaml",
      "scripts/release/",
      "docs/modernization/phase1a/infra/handoff/B-5-dba/",
      "docs/modernization/phase1a/infra/runbooks/files/",
      "docs/modernization/phase1a/infra/runbooks/scripts/",
      "docs/modernization/phase1a/infra/PREDEPLOY_CHECKLIST.md",
      "docs/modernization/phase1a/infra/deploy_gate.json",
      "docs/modernization/new_intent.py",
      "docs/modernization/phase1a/infra/new_legacy_read.py",
      "docs/modernization/phase1a/infra/build_legacy_read_register.py",
      "docs/modernization/glossary/new_term_issue.py",
      "docs/modernization/phase1a/infra/runbooks/prod-approvals.txt",
      "backend/glossary/build_proposed_index.py",
      "docs/modernization/adr/build_adrs.py",
      "docs/modernization/adr/new_adr.py",
      "docs/modernization/adr/selftest_build_adrs.py",
      "docs/modernization/build_all.py",
      "docs/modernization/build_decisions.py",
      "docs/modernization/build_oa_inventory.py",
      "docs/modernization/build_records.py",
      "docs/modernization/check_legacy_name.py",
      "docs/modernization/check_tasks.py",
      "docs/modernization/describe_nodes.py",
      "docs/modernization/extract_topology.py",
      "docs/modernization/glossary/apply_nm.py",
      "docs/modernization/glossary/apply_recon.py",
      "docs/modernization/glossary/apply_recon_selftest.py",
      "docs/modernization/glossary/apply_rulings.py",
      "docs/modernization/glossary/build_confirm_page.py",
