      "docs/modernization/r0/build_finance_decisions.py",
      "docs/modernization/rules/decide/answered_pages.txt",
      "docs/modernization/rules/decide/build_decision_page.py",
      "docs/modernization/rules/decide/check_pages.py",
      "docs/modernization/rules/decide/decide_sync.py",
      "docs/modernization/rules/decide/export_answers.py",
      "docs/modernization/rules/decide/page-template.html",
      "scripts/delegate.py",
      "scripts/evidence/"
    ],
    "_final_paths_说明": "仓库根起的完整前缀，改动路径以任一项开头即须 opus 终审。不得写裸目录名或空表（空表等于关闭终审）。生产写门的可信脚本（DOC_SCRIPTS、只读取证工具）运行时会加载或会被比对的文件也在表内，由 gates_selftest 的 layout 段对照门的 closure 核对（K18 续）。"
  },
  "labels": {
    "review_passed": "复审通过",
    "hold": "hold",
    "integration": "整合"
  },
  "mq": {
    "batch_max_prs": 5,
    "batch_branch_prefix": "mq/batch-",
    "enqueue_alert_minutes": 45,
    "ready_to_merged_p90_minutes": 45,
    "merged_per_hour_min": 8,
    "merge_method": {
      "default": "squash",
      "integration": "merge"
    },
    "max_lines_total": 2500
  },
  "ci": {
    "light_job_p90_minutes": 2,
    "light_job_cancel_rate_max": 0.05,
    "infra_pr_weekly_share_max": 0.2,
    "infra_release_weekday": "monday",
    "new_test_repeat": 3
  },
  "retention_days": {
    "worktree_after_merge": 1,
    "branch_cleanup_backup": 7,
    "handoff_history": 7,
    "jsonl_logs": 14,
    "snapshot_backup": 7,
    "evidence": 7
  },
  "janitor": {
    "daily_at": "03:00"
  },
  "board": {
    "interval_minutes": 10
  },
  "decisions": {
    "current_page_max_kb": 10,
    "daily_decide_at": "20:00"
  },
  "memory_max_kb": 2,
  "budget": {
    "level_interval_minutes": 30,
    "level_file": "~/.modernize/psa/budget/level.json",
    "line": {
      "from_pct": 0,
      "to_pct": 95,
      "end_hours_before_reset": 12
    },
    "ladder": {
      "L0": {
        "over_line_max_pts": 3
      },
      "L1": {
        "over_line_min_pts": 3,
        "over_line_max_pts": 8
      },
      "L2": {
        "over_line_min_pts": 8,
        "keep_sessions": [
          "one-lead",
          "one-platform"
        ],
        "platform_scope": "blocking_fixes_only",
        "keep_business_line_key": "budget.l2_keep_business_line"
      },
      "L3": {
        "usage_min_pct": 95
      }
    },
    "l2_keep_business_line": "one-dev-par",
    "agent_tier_gate_enabled": false,
    "reading_validation_days": 7,
    "reading_max_deviation_pts": 5,
    "share_overrun_factor": 1.5,
    "night_window": {
      "from": "22:00",
      "to": "08:00"
    },
    "level_mode": "warn",
    "_level_mode_说明": "验证期只告警（D32）。reading_max_deviation_pts 为 null 时，budget_level 与 agent_tier_gate 一律按不开拦截处理，失败关闭。",
    "review_days_after_enable": [
      7,
      14
    ],
    "revoke_no_l1_weeks": 2,
    "revoke_l2_stuck_hours": 24,
    "coordinator_model": {
      "day": "opus",
      "night": "sonnet",
      "level_ge_L1": "sonnet"
    },
    "weekly_share": {
      "coordinator": 0.08,
      "design": 0.2,
      "opus_review_security": 0.15,
      "business": 0.35,
      "quality_infra": 0.07,
      "language_ops_evidence": 0.1,
      "reserve": 0.05
    },
    "weekly_share_capped": [
      "coordinator",
      "design",
      "quality_infra"
    ],
    "week_reset_anchor": "2026-10-26T09:00Z",
    "reading_max_age_min": 360,
    "_reading_说明": "week_reset_anchor 取自用量页周重置时间（北京时间周一 17:00），按 7 天推算；reading_max_age_min：读数源每天只采样 3～4 次，超过即视为无读数；reading_max_deviation_pts=5 为验证期暂定（本地 80%、用量页 82% 一次对照），验证满一周后复核再定。"
  },
  "budget_check": {
    "mode": "warn"
  },
  "machine": {
    "ci_runners": 4,
    "heavy_parallel_max": null,
    "delegate_nice": 10,
    "_说明": "heavy_parallel_max、delegate_nice 定稿 1.15 点名未给数，由 one-ops 与 one-platform 定；delegate_nice 调度 10-26 晚签值（b2b-plan 第 3 节第 4 条），heavy_parallel_max 推后（b2b-plan 0.1）。"
  },
  "sessions": {
    "resident_max": 4,
    "config": {}
  },
  "measures": [
    {
      "id": "budget-ladder",
      "措施": "额度预算线加 L0～L3 梯子（D32）",
      "指标": [
        "每日超速量",
        "各档停留时长",
        "降级期间合入数",
        "降级期间 High 数"
      ],
      "基线": null,
      "_基线说明": "拦截开启前一周的读数，由 one-platform 落实读数后填",
      "复盘日": "budget.review_days_after_enable",
      "撤销条件": [
        "连续 budget.revoke_no_l1_weeks 周没进过 L1",
        "进入 L2 后 budget.revoke_l2_stuck_hours 小时仍回不到线下"
      ]
    }
  ],
  "tools_lib": {
    "max_lines_total": 1800,
    "dir": "~/.modernize/psa/tools/one-session",
    "checks": [
      "board",
      "budget_level",
      "handoff",
      "janitor",
      "node_ready",
      "ops_venv_lock",
      "start_sheet",
      "stop_check"
    ]
  },
  "delegate": {
    "_说明": "scripts/delegate.py 的准入与运行参数（O20；b2b-plan #1、#2）。forbidden_paths 为仓库相对路径的 fnmatch 通配（* 跨目录），命中的文件不进外包 worktree、不许出现在范围与改动里；forbidden_categories 为不外包类别（roles/platform.md「delegate 准入」），与类别名互相包含即拒；env_allow 是 env -i 后唯一透传的变量名，凭据由本机配置提供（TEAM-34 现行做法），不在这里加密钥变量；缺键或 null 时 delegate 失败关闭。forbidden_paths、forbidden_categories、env_allow、engines、timeout_minutes 为 ops 起草的最小可用值，待调度定稿。",
    "forbidden_paths": [
      "scripts/hooks/*",
      "scripts/gates/*",
      "scripts/evidence/*",
      "scripts/release/*",
      "scripts/ops/*",
      "scripts/coord/*",
      "scripts/delegate*",
      ".claude/*",
      ".github/workflows/*",
      "policy.json",
      ".gitleaks.toml",
      ".pre-commit-config.yaml",
      "*/acceptance/*",
      "docs/modernization/phase1a/infra/*",
      "*SECRETS*",
      "*.env",
      "*.env.*",
      "*合同*"
    ],
    "forbidden_categories": [
      "生产取证",
      "连生产操作",
      "安全改动",
      "复审",
      "验收测试",
      "对用户与会话的沟通",
      "语义、权限、越权边界判断",
      "钩子、并发、解析类守护代码"
    ],
    "env_allow": [
      "HOME",
      "PATH",
      "LANG",
      "LC_ALL",
      "TMPDIR",
      "USER",
      "LOGNAME"
    ],
    "engines": {
      "codex": {
        "model": "gpt-6.1-sol"
      },
      "deepseek": {
        "model": "deepseek/deepseek-flash",
        "tools": "read,edit,write"
      }
    },
    "timeout_minutes": 60,
    "real_run_enabled": false,
    "_real_run_说明": "调度 10-26 深夜定方案 A：false 时 delegate 只许自测桩，真引擎一律拒（失败关闭、台账记拒绝）；pi 系统沙箱与 codex 限读（终审 79afae290 必改 2、3 后半）在 V16 前实测处理，处理完并经批准才改 true。review.final_paths 全部并入禁区。",
    "ledger": "~/.modernize/psa/state/delegate/ledger.jsonl",
    "runs_dir": "~/.modernize/psa/state/delegate/runs",
    "billing": {
      "codex": {
        "mode": "subscription",
        "no_cap": true
      },
      "deepseek": {
        "mode": "record_only",
        "no_cap": true
      }
    },
    "pilot": {
      "categories": [
        "写测试",
        "机械改写",
        "长文阅读"
      ],
      "cards_per_category": 5,
      "first_pass_rate_min_vs_sonnet_pts": -10,
      "claude_cost_max_vs_sonnet_self": 0.5
    }
  },
  "shell": {
    "foreground_max_seconds": 60
  }
}
