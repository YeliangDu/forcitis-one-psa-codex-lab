{
  "schema_version": 1,
  "_说明": "流程数值与枚举的唯一出处（定稿 P4、H8）。规则、角色、模板只引用键名，不写字面值。改动走普通文档 PR，正文引用 intent。约定：值为 null 表示「待定」，读取方按最保守处理（拦截类不开、上限类不放宽），例外在键旁注明；delegate.billing 用 no_cap: true 表示不设上限（D34）。枚举：budget_check.mode 与 budget.level_mode 取 warn｜enforce。",
  "rules": {
    "_note": "Size limits of agent-read rule files, 1 KB = 1024 UTF-8 bytes (decision 2026-10-29-144628). The layer A/B keys arrive with the #810 size check that reads them; scripts/guards/policy_keys_read.py fails on a numeric key here that nothing reads."
  },
  "start": {
    "_说明": "handoff_max_kb：工具库 handoff.py 写交接的上限，开工单注入交接时也截到这个长度（#752）；sheet_max_kb：开工单 start_sheet 注入的总上限；playbook_max_kb：一份剧本的上限（check_playbooks P1）。1 KB = 1024 字节；数值键须有脚本读（policy_keys_read.py，#822）。",
    "handoff_max_kb": 2,
    "sheet_max_kb": 4,
    "playbook_max_kb": 2
  },
  "gates": {
    "_说明": "行数上限（max_lines、runtime_max_lines、mq 与 tools_lib 的 max_lines_total、自测不多于运行代码）按卡 #736 删去（用户 intent 2026-10-28-171123）。node_record_max_age_seconds 管 clear_session 门（工具库 node_ready.py --gate，用户 intent 2026-10-27-171036）：它只读 node_ready --record 的结果，判定时间超过这个秒数即拒（二乙 #14，调度 10-27「先判后清」）。",
    "runtime_max_files": 8,
    "hook_p99_ms": 100,
    "per_call_total_ms": 300,
    "node_record_max_age_seconds": 600,
    "precommit_max_seconds": 10,
    "install_dir": "~/.modernize/psa/tools/hooks",
    "install_current_link": "current"
  },
  "review": {
    "no_verdict_alert_minutes": 30,
    "verdicts": [
      "通过",
      "必改"
    ],
    "header_fields": [
      "复审结论",
      "commit",
      "复审者"
    ],
    "final_paths": [
      "scripts/gates/",
      "scripts/hooks/",
      "scripts/merge/",
      "scripts/review/",
      "scripts/ci/",
      "scripts/guards/",
      "scripts/session/",
      ".claude/",
      ".github/",
      "policy.json",
      ".gitleaks.toml",
      ".pre-commit-config.yaml",
      "scripts/release/",
      "docs/ops/dba-scripts/",
      "docs/data/evidence/dba-handoff/",
      "tools/ops/ecs/files/",
      "tools/ops/ecs/scripts/",
      "docs/ops/predeploy-checklist.md",
      "docs/ops/deploy-gate.json",
      "docs/ops/runbooks/prod-approvals.txt",
      "docs/decisions/decision-pages/answered-pages.txt",
      "docs/decisions/decision-pages/page-template.html",
      "tools/"
    ],
    "_final_paths_说明": "仓库根起的完整前缀，改动路径以任一项开头即须 opus 终审。不得写裸目录名或空表（空表等于关闭终审）。表里原为生产写门可信脚本（DOC_SCRIPTS、只读取证工具）列的前缀，卡 #736 起门不再认可信脚本，暂留作守护路径。"
  },
  "labels": {
    "review_passed": "复审通过",
    "hold": "hold",
    "integration": "整合"
  },
  "ci": {
    "light_job_p90_minutes": 2,
    "light_job_cancel_rate_max": 0.05,
    "infra_pr_weekly_share_max": 0.2,
    "infra_release_weekday": "monday",
    "new_test_repeat": 3
  },
  "retention_days": {
    "worktree_after_merge": 1,
    "branch_cleanup_backup": 7,
    "handoff_history": 7,
    "jsonl_logs": 14,
    "snapshot_backup": 7,
    "evidence": 7
  },
  "decisions": {
    "current_page_max_kb": 6,
    "daily_decide_at": "20:00"
  },
  "sessions": {
