{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/run_from_main.sh --stdout-warn git_ceiling_env.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/run_from_main.sh --stdout-warn start_sheet.py --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/run_from_main.sh --strict gates/pre_tool_dispatch.py",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$HOME\"/.modernize/psa/tools/one-session/stop_check/stop_check.py && python3 -I \"$HOME\"/.modernize/psa/tools/one-session/stop_check/stop_check.py; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "code-modernization@claude-plugins-official": false
  }
}
