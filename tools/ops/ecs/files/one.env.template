# /etc/forcitis-one/one.env 的模板：只有变量名与非机密默认值。机密一律留空，由运维在服务器上填写。
# 安装：install -o root -g forcitis -m 0640 one.env.template /etc/forcitis-one/one.env，再在服务器上编辑。
# 变量含义见 INFRA_RUNBOOK §5；以 backend/src/main/resources 下的配置为准。
# 含 & ; | \ 等字符的值用单引号括起：systemd 与 shell（B-9 与部署步骤会 source 本文件）都按字面读取。

# ---- 环境与监听（E-7）----
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
# 生产另加：SPRINGDOC_API_DOCS_ENABLED=false

# 只信任本机 nginx；值是正则
FORCITIS_TRUSTED_PROXIES='127\.0\.0\.1|\[?::1\]?'

# ---- PostgreSQL 运行连接（one_dev_app）----
SPRING_DATASOURCE_URL='jdbc:postgresql://<RDS 内网地址>:5432/forcitis_one_dev?sslmode=verify-full&sslrootcert=/etc/forcitis-one/rds-ca.pem&logServerErrorDetail=false'
SPRING_DATASOURCE_USERNAME=one_dev_app
SPRING_DATASOURCE_PASSWORD=
# 迁移凭据（one_dev_migrator）不放这里：只在部署步骤以单独文件注入，见 docs/ops/runbooks/ecs-init.md「首次部署」与 docs/ops/runbooks/release.md
# 常驻进程不跑 Flyway：one_dev_app 对 one_migration 无 USAGE，启动时的 Flyway 会因读不到历史表而拒绝启动；迁移由发布脚本以迁移账号单独执行
SPRING_FLYWAY_ENABLED=false

# ---- 流程引擎 ----
FLOWABLE_SCHEMA_UPDATE=false
FLOWABLE_ASYNC_EXECUTOR=true

# ---- 审批 ----
APPROVAL_PROCESS_ADMINISTRATOR_USER_ID=
APPROVAL_TASK_URL_TEMPLATE=https://one.forcitis.com/approval/tasks/{taskId}
APPROVAL_DEADLINE_ENABLED=true

# ---- 登录 ----
EMERGENCY_TOTP_ENCRYPTION_KEY=
FORCITIS_PLATFORM_IDENTITY_SSO_ENABLED=false
SEEYON_OA_BASE_URL=
LEGACY_LOGIN_URL=
# 签名票据签发方默认关闭；按 D-1a-56 逐个批准后才增加 FORCITIS_TICKET_KEY_<名称>

# ---- 企业微信（B-2 的新应用；老应用的值不得使用）----
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_RESTRICT_RECIPIENTS=true
WECOM_RECIPIENT_ALLOWLIST=
# B-9 核实后填写：
FORCITIS_PLATFORM_INTEGRATION_WECOM_DELIVERY_DUPLICATE_TASK_ERROR_CODES=

# ---- A8 组织视图（B-5 的 one_a8_views_ro；配置了就启动校验，无开关，ADR-0037 第 4 项）----
INTEGRATION_SEEYON_VIEWS_ENABLED=false
A8_DB_URL='jdbc:sqlserver://<A8 地址>:1433;databaseName=a8_db;encrypt=true'
A8_DB_USERNAME=one_a8_views_ro
A8_DB_PASSWORD=

# ---- 老系统部门简称视图（B-5 的 one_legacy_names_ro）----
INTEGRATION_LEGACY_ENABLED=false
LEGACY_DB_RO_URL='jdbc:sqlserver://<老系统 RDS 内网地址>:1433;databaseName=ruoyi-vue-pro;encrypt=true'
LEGACY_DB_RO_USERNAME=one_legacy_names_ro
LEGACY_DB_RO_PASSWORD=

# 同步根单位的层级路径（A8，`forcitis.platform.integration.seeyon.views.root-path`）；没有默认值，启用视图读取而缺此项应用启动失败。dev 取规则卡 A8_DEPT_ROOT_PATH
FORCITIS_PLATFORM_INTEGRATION_SEEYON_VIEWS_ROOT_PATH=00000001

# ---- 定时作业开关 ----
# 总开关，只能是 true 或 false，没有默认值（缺失或为空应用起不来）；所有实例中至少一个为 true，否则全部定时作业停止
FORCITIS_JOBS_ENABLED=true
WORKFORCE_SYNC_ENABLED=false
WORKFORCE_SHORT_NAME_ENABLED=false
EVENT_PUBLICATION_JOBS_ENABLED=true
