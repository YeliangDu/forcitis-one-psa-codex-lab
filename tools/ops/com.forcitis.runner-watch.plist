<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CI 运行器巡检（卡 #736 第 9 项）。安装与卸载用 tools/ops/runner_watch_install.sh [--dry-run] [--uninstall]（同时给 mac-one-1～4 的 plist 加 KeepAlive、ThrottleInterval）；脚本更新后重跑一次。临时停巡检：touch __HOME__/.modernize/psa/ops/runner-watch/pause，用完删。撤销见 RESOURCES.md -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.forcitis.runner-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.modernize/psa/ops/bin/runner_watch.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/.modernize/psa/ops/runner-watch/launchd.err.log</string>
  <key>StandardOutPath</key><string>__HOME__/.modernize/psa/ops/runner-watch/launchd.out.log</string>
</dict>
</plist>
