<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version></parent>
  <groupId>com.forcitis</groupId><artifactId>forcitis-one</artifactId><version>${revision}</version>
  <properties><revision>0.0.1</revision><java.version>25</java.version><spring-modulith.version>2.1.1</spring-modulith.version><shedlock.version>7.10.1</shedlock.version><error-prone.version>2.50.0</error-prone.version><nullaway.version>0.14.2</nullaway.version><argLine></argLine><test.forks>4</test.forks><it.forks>${test.forks}</it.forks><test.fork.timeout>0</test.fork.timeout><test.jvm>-XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xshare:auto -Duser.timezone=UTC</test.jvm>
    <!-- QUAL-CARD-H, user decision 2026-10-17: SQL Server runs on relevant paths and nightly.
         Single list, also read by acceptance_reports.py and legacy_it.sh; includes the OrgSourceWorldSupport subclasses. -->
    <legacy.it.acceptance>
      com/forcitis/one/acceptance/platform/integration/A8SourceFlagsIT.java,
      com/forcitis/one/acceptance/platform/integration/ReadOnlyAccountCheckIT.java,
      com/forcitis/one/acceptance/platform/integration/ReadOnlyVerificationCommandIT.java,
      com/forcitis/one/acceptance/platform/integration/StalledExternalSourceIT.java
    </legacy.it.acceptance>
    <integration.reports>${project.build.directory}/failsafe-reports</integration.reports>
  </properties>
  <dependencyManagement><dependencies><dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-bom</artifactId><version>${spring-modulith.version}</version><type>pom</type><scope>import</scope></dependency></dependencies></dependencyManagement>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-core</artifactId></dependency>
    <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-core</artifactId></dependency>
    <!-- Event publication registry (JDBC): at-least-once delivery of module events (RULE-295/303/304) - added by platform.approval -->
    <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <!-- OpenAPI contract (G42 reads /v3/api-docs); 3.1.x is built on Boot 4.1 -->
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-api</artifactId><version>3.1.1</version></dependency>
    <!-- ADR-0002: @Scheduled + ShedLock (JDBC); lock table owned by platform.scheduling -->
    <dependency><groupId>org.aspectj</groupId><artifactId>aspectjweaver</artifactId></dependency>
    <dependency><groupId>net.javacrumbs.shedlock</groupId><artifactId>shedlock-spring</artifactId><version>${shedlock.version}</version></dependency>
    <dependency><groupId>net.javacrumbs.shedlock</groupId><artifactId>shedlock-provider-jdbc-template</artifactId><version>${shedlock.version}</version></dependency>
    <!-- platform.integration: object store for archives (China-region OSS, archive storage class, WORM); official SDK, pinned -->
    <dependency><groupId>com.aliyun.oss</groupId><artifactId>aliyun-sdk-oss</artifactId><version>3.18.1</version></dependency>
    <dependency><groupId>org.flowable</groupId><artifactId>flowable-spring-boot-starter-process</artifactId><version>8.0.0</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency>
    <!-- Phase 1a: server-side sessions (ADR-0009), caches (no Redis), metrics to ARMS, read-only SQL Server for A8 / legacy views -->
    <dependency><groupId>org.springframework.session</groupId><artifactId>spring-session-jdbc</artifactId></dependency>
    <!-- platform.identity: Boot 4 auto-configures Spring Session JDBC (cookie, table name, cleanup) from this starter -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-session-jdbc</artifactId></dependency>
    <!-- platform.identity: Argon2id for emergency-admin passwords (Spring Security's Argon2PasswordEncoder needs BouncyCastle); not managed by the Boot BOM -->
    <!-- platform.identity: @ApplicationModuleListener (reacts to workforce events); a no-op duplicate if the event registry starter is added later -->
    <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-events-api</artifactId></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.82</version></dependency>
    <dependency><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
    <dependency><groupId>com.microsoft.sqlserver</groupId><artifactId>mssql-jdbc</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
    <!-- used directly by tests (LegacyApiGuardTest LA-8 bans Thread.sleep); version managed by the Boot parent -->
    <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-testcontainers</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.wiremock</groupId><artifactId>wiremock-standalone</artifactId><version>3.13.1</version><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit</artifactId><version>1.4.2</version></dependency>
    <!-- archunit stays in the runtime: spring-modulith-core depends on it (compile) to detect modules; test scope here would strip it from the jar -->
  </dependencies>
  <build>
    <plugins>
      <!-- Start-Class is the application even though the replay command also has a main; the ZIP layout (PropertiesLauncher) lets operators run
           that command offline from the same jar with -Dloader.main (TIMESHEET_REPLAY.md). The release pipeline passes -Drevision. -->
      <plugin>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
        <configuration><mainClass>com.forcitis.one.OneApplication</mainClass><layout>ZIP</layout></configuration>
        <executions><execution><goals><goal>build-info</goal><goal>repackage</goal></goals></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.14</version>
        <executions>
          <execution><id>prepare</id><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
      <!-- kernel.SystemActors reads the declared system actors (RULING-P2-C5) and IdempotencyScope the idempotent endpoints from the class path; the catalogue stays in architecture/ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>system-actor-catalogue</id><phase>process-resources</phase><goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/architecture</outputDirectory>
              <resources><resource><directory>${project.basedir}/architecture</directory><includes><include>system-actors.txt</include><include>idempotent-endpoints.txt</include></includes></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- SQL Server integration tests (*MssqlIT) need the profile legacy-it: neither compiled nor run by default -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testExcludes><testExclude>**/*MssqlIT.java</testExclude></testExcludes>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- NullAway (#810): named explicitly at ERROR, since -XepDisableAllChecks switches off every check it does not name; only @NullMarked packages are checked -->
            <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:CollectionIncompatibleType:ERROR -Xep:EqualsIncompatibleType:ERROR -Xep:UnusedVariable:ERROR -Xep:IdentityBinaryExpression:ERROR -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path><groupId>com.google.errorprone</groupId><artifactId>error_prone_core</artifactId><version>${error-prone.version}</version></path>
            <path><groupId>com.uber.nullaway</groupId><artifactId>nullaway</artifactId><version>${nullaway.version}</version></path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <!-- Test classes share their packages with the code they test, so @NullMarked reaches them too; tests pass null on purpose to prove
               the guards, so test compilation keeps the two Error Prone checks above without NullAway -->
          <execution><id>default-testCompile</id><configuration><compilerArgs combine.self="override">
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:CollectionIncompatibleType:ERROR -Xep:EqualsIncompatibleType:ERROR -Xep:UnusedVariable:ERROR -Xep:IdentityBinaryExpression:ERROR</arg>
          </compilerArgs></configuration></execution>
        </executions>
      </plugin>
      <!-- Mockito as a java agent (its javadoc: dependency:properties exports the jar path, argLine loads it), so it needs no self-attach, which a sandboxed JVM refuses -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><executions><execution><id>mockito-agent-path</id><goals><goal>properties</goal></goals></execution></executions></plugin>
      <!-- *IT classes (Testcontainers) run in the integration-test phase; surefire only runs *Test (Boot parent) - added by platform.approval -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><configuration><excludes><exclude>${legacy.it.acceptance}</exclude><exclude>**/*MssqlIT.java</exclude><exclude>**/*$*</exclude></excludes><reportsDirectory>${integration.reports}</reportsDirectory><summaryFile>${integration.reports}/failsafe-summary.xml</summaryFile><forkCount>${it.forks}</forkCount><reuseForks>true</reuseForks><argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} ${test.jvm}</argLine><forkedProcessExitTimeoutInSeconds>180</forkedProcessExitTimeoutInSeconds><forkedProcessTimeoutInSeconds>${test.fork.timeout}</forkedProcessTimeoutInSeconds></configuration></plugin>
      <!-- At JVM exit the cached Spring contexts close after Testcontainers stopped the database; each waits for its connection timeout, so a fork with many contexts needs more than the default 30 s to leave. -->
      <!-- every test class owns its Testcontainers database, so classes run in parallel JVMs: ./mvnw verify -Dtest.forks=1 restores serial runs -->
      <!-- test.fork.timeout: total seconds a reused fork may run (0 = no limit); CI sets it so a hung fork is killed, after its watchdog took thread dumps -->
      <!-- OpenAPI is not tracked. Bootstrap with bash scripts/codegen/generate_api.sh before verify (acceptance tests also read generated TS).
           The lifecycle exports JSON at process-test-classes, before surefire/failsafe; direct plugin calls require that bootstrap first. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>${test.forks}</forkCount><reuseForks>true</reuseForks><argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} ${test.jvm}</argLine><forkedProcessTimeoutInSeconds>${test.fork.timeout}</forkedProcessTimeoutInSeconds>
          <excludes><exclude>**/OpenApiExportTest.java</exclude></excludes>
        </configuration>
        <executions>
          <execution>
            <id>export-openapi</id><phase>process-test-classes</phase><goals><goal>test</goal></goals>
            <configuration><test>OpenApiExportTest</test><forkCount>1</forkCount></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- SQL Server tests (the list above and *MssqlIT) against real SQL Server (Testcontainers), off by default. Run: ./mvnw -B verify -Plegacy-it; they end in IT, so only failsafe runs them, once -->
    <profile>
      <id>legacy-it</id>
      <dependencies>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-mssqlserver</artifactId><scope>test</scope></dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
            <configuration><testExcludes combine.self="override"/></configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
            <!-- Full profile keeps the default ITs too; legacy_it.sh selects just SQL Server for PRs. -->
            <configuration><excludes combine.self="override"/></configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
