<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:flowable="http://flowable.org/dmn" id="cutoff_nodes_definitions" name="cutoff variant" namespace="http://forcitis.com/psa/approval/dmn">
  <decision id="cost_timesheet_approval_nodes" name="cutoff variant">
    <description>Test-only decision table of the cut-off variant.</description>
    <decisionTable id="cutoff_nodes_table" hitPolicy="FIRST">
      <input id="input_node" label="node"><inputExpression id="inputExpression_node" typeRef="string"><text>node</text></inputExpression></input>
      <output id="output_routed" label="routed" name="routed" typeRef="boolean"/>
      <output id="output_skipWhenEmpty" label="skipWhenEmpty" name="skipWhenEmpty" typeRef="boolean"/>
      <output id="output_autoApproveRepeat" label="autoApproveRepeat" name="autoApproveRepeat" typeRef="boolean"/>
      <rule id="rule_1">
        <inputEntry id="inputEntry_1_0"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="outputEntry_1_0"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_1_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_1_2"><text><![CDATA[false]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
