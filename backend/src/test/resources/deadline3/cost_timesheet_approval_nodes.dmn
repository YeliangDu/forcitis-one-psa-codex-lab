<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20180521/MODEL/" xmlns:flowable="http://flowable.org/dmn" id="deadline3_definitions" name="工时审批节点决策" namespace="http://forcitis.com/psa/approval/dmn">
  <decision id="cost_timesheet_approval_nodes" name="工时审批节点决策">
    <description>Test-only decision table: deadline 3 workdays, escalation 2 workdays after it.</description>
    <decisionTable id="cost_timesheet_approval_nodes_table" hitPolicy="FIRST">
      <input id="input_node" label="节点"><inputExpression id="inputExpression_node" typeRef="string"><text>node</text></inputExpression></input>
      <input id="input_projectHours" label="项目工时"><inputExpression id="inputExpression_projectHours" typeRef="boolean"><text>projectHours</text></inputExpression></input>
      <input id="input_preSalesHours" label="售前工时"><inputExpression id="inputExpression_preSalesHours" typeRef="boolean"><text>preSalesHours</text></inputExpression></input>
      <input id="input_overheadHours" label="OH 工时"><inputExpression id="inputExpression_overheadHours" typeRef="boolean"><text>overheadHours</text></inputExpression></input>
      <output id="output_routed" label="走此路" name="routed" typeRef="boolean"/>
      <output id="output_skipWhenEmpty" label="取不到人可跳过" name="skipWhenEmpty" typeRef="boolean"/>
      <output id="output_autoApproveRepeat" label="重复审批人可自动通过" name="autoApproveRepeat" typeRef="boolean"/>
      <output id="output_deadlineWorkdays" label="审批时限（工作日）" name="deadlineWorkdays" typeRef="number"/>
      <output id="output_escalationWorkdays" label="升级间隔（工作日）" name="escalationWorkdays" typeRef="number"/>
      <rule id="rule_1">
        <inputEntry id="inputEntry_1_0"><text><![CDATA[== "projectManagerReview"]]></text></inputEntry>
        <inputEntry id="inputEntry_1_1"><text><![CDATA[== true]]></text></inputEntry>
        <inputEntry id="inputEntry_1_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_1_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="outputEntry_1_0"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_1_1"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_1_2"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_1_3"><text><![CDATA[3]]></text></outputEntry>
        <outputEntry id="outputEntry_1_4"><text><![CDATA[2]]></text></outputEntry>
      </rule>
      <rule id="rule_2">
        <inputEntry id="inputEntry_2_0"><text><![CDATA[== "projectManagerReview"]]></text></inputEntry>
        <inputEntry id="inputEntry_2_1"><text><![CDATA[== false]]></text></inputEntry>
        <inputEntry id="inputEntry_2_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_2_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="outputEntry_2_0"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_2_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_2_2"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_2_3"><text><![CDATA[3]]></text></outputEntry>
        <outputEntry id="outputEntry_2_4"><text><![CDATA[2]]></text></outputEntry>
      </rule>
      <rule id="rule_3">
        <inputEntry id="inputEntry_3_0"><text><![CDATA[== "regionalHeadReview"]]></text></inputEntry>
        <inputEntry id="inputEntry_3_1"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_3_2"><text><![CDATA[== true]]></text></inputEntry>
        <inputEntry id="inputEntry_3_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="outputEntry_3_0"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_3_1"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_3_2"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_3_3"><text><![CDATA[3]]></text></outputEntry>
        <outputEntry id="outputEntry_3_4"><text><![CDATA[2]]></text></outputEntry>
      </rule>
      <rule id="rule_4">
        <inputEntry id="inputEntry_4_0"><text><![CDATA[== "regionalHeadReview"]]></text></inputEntry>
        <inputEntry id="inputEntry_4_1"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_4_2"><text><![CDATA[== false]]></text></inputEntry>
        <inputEntry id="inputEntry_4_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="outputEntry_4_0"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_4_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_4_2"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_4_3"><text><![CDATA[3]]></text></outputEntry>
        <outputEntry id="outputEntry_4_4"><text><![CDATA[2]]></text></outputEntry>
      </rule>
      <rule id="rule_5">
        <inputEntry id="inputEntry_5_0"><text><![CDATA[== "supervisorReview"]]></text></inputEntry>
        <inputEntry id="inputEntry_5_1"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_5_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_5_3"><text><![CDATA[== true]]></text></inputEntry>
        <outputEntry id="outputEntry_5_0"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_5_1"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_5_2"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="outputEntry_5_3"><text><![CDATA[3]]></text></outputEntry>
        <outputEntry id="outputEntry_5_4"><text><![CDATA[2]]></text></outputEntry>
      </rule>
      <rule id="rule_6">
        <inputEntry id="inputEntry_6_0"><text><![CDATA[== "supervisorReview"]]></text></inputEntry>
        <inputEntry id="inputEntry_6_1"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_6_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="inputEntry_6_3"><text><![CDATA[== false]]></text></inputEntry>
        <outputEntry id="outputEntry_6_0"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_6_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_6_2"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="outputEntry_6_3"><text><![CDATA[3]]></text></outputEntry>
        <outputEntry id="outputEntry_6_4"><text><![CDATA[2]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
