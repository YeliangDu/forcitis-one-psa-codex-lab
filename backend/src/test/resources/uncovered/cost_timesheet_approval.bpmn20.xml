<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only variant whose nodes the production decision table does not cover: starting it must fail. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:forcitis="https://forcitis.com/psa/approval/extension"
             targetNamespace="https://forcitis.com/psa/approval">
  <process id="cost_timesheet_approval" name="Timesheet approval (node without a rule)" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toReviewStage" sourceRef="start" targetRef="reviewStage"/>
    <subProcess id="reviewStage" name="Manager review">
      <startEvent id="reviewStart"/>
      <sequenceFlow id="toApproverReview" sourceRef="reviewStart" targetRef="uncoveredReview"/>
      <userTask id="uncoveredReview" name="Approver review">
        <extensionElements>
          <forcitis:assignmentRule type="FORM_FIELD_USERS" field="projectManagerId"/>
        </extensionElements>
      </userTask>
      <sequenceFlow id="toReviewEnd" sourceRef="uncoveredReview" targetRef="reviewEnd"/>
      <endEvent id="reviewEnd"/>
    </subProcess>
    <sequenceFlow id="toDepartmentReview" sourceRef="reviewStage" targetRef="uncoveredSecond"/>
    <userTask id="uncoveredSecond" name="Department review">
      <extensionElements>
        <forcitis:assignmentRule type="DEPARTMENT_HEAD"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toEnd" sourceRef="uncoveredSecond" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
