<?xml version="1.0" encoding="UTF-8"?>
<!-- Test fixture for #1436: ONE pool task for the people named in a form field, and the node takes no fallback, so a transfer or a reassignment may only go to one of them. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:forcitis="https://forcitis.com/psa/approval/extension"
             targetNamespace="https://forcitis.com/psa/approval">
  <process id="cost_demo_pool_review" name="演示池复核" isExecutable="true">
    <extensionElements>
      <forcitis:documentType code="TIMESHEET"/>
      <forcitis:routingFlagRequired value="false"/>
    </extensionElements>
    <startEvent id="start"/>
    <sequenceFlow id="toReview" sourceRef="start" targetRef="review"/>
    <userTask id="review" name="复核">
      <extensionElements>
        <forcitis:assignmentRule type="FORM_FIELD_USERS" field="projectManagerId" noFallback="true"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toEnd" sourceRef="review" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
