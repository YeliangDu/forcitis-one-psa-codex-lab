<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:forcitis="https://forcitis.com/psa/approval/extension"
             targetNamespace="https://forcitis.com/psa/approval">
  <!-- Bonus input approval (#1436, PY3). Routing is the user's decision of 2026-11-05 (docs/decisions/2026-11-05-195500-one-lead-均采纳推荐.md, item 1): one stage, the
       initiator's line manager (INITIATOR_SUPERVISOR level 1), then a holder of the payroll role. The platform never offers the initiator as a candidate of the
       second stage while another holder exists. No routing flags, no deadlines (none decided). The five fields are data only: no node reads them for an approver, payroll
       reads them back through ApprovalProcesses.formFields when the approval completes. Each node is a countersign: one task per distinct approver, all must approve. -->
  <process id="organization_payroll_bonus_input" name="奖金输入审批" isExecutable="true">
    <extensionElements>
      <forcitis:documentType code="BONUS_INPUT"/>
      <forcitis:routingFlagRequired value="false"/>
      <forcitis:formField name="employmentRelationshipId"/>
      <forcitis:formField name="payrollMonthStartDate"/>
      <forcitis:formField name="bonusAmount"/>
      <forcitis:formField name="bonusCurrency"/>
      <forcitis:formField name="reasonKey"/>
    </extensionElements>
    <startEvent id="start"/>
    <sequenceFlow id="toSupervisorReview" sourceRef="start" targetRef="supervisorReview"/>
    <userTask id="supervisorReview" name="一级汇报人审批">
      <extensionElements>
        <forcitis:assignmentRule type="INITIATOR_SUPERVISOR" level="1"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${approverResolution.apply(execution)}"
                                        flowable:elementVariable="approver"/>
    </userTask>
    <sequenceFlow id="toPayrollReview" sourceRef="supervisorReview" targetRef="payrollReview"/>
    <userTask id="payrollReview" name="薪资专员审批">
      <extensionElements>
        <forcitis:assignmentRule type="ROLE" role="payroll_specialist"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${approverResolution.apply(execution)}"
                                        flowable:elementVariable="approver"/>
    </userTask>
    <sequenceFlow id="toEnd" sourceRef="payrollReview" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
