<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:forcitis="https://forcitis.com/psa/approval/extension"
             targetNamespace="https://forcitis.com/psa/approval">
  <!--
    process id = ProcessKey.COST_TIMESHEET_APPROVAL.key(): {subdomain}_{bc}_{snake} of the owning module (G47).

    Assignment rules live in the forcitis:assignmentRule extension element of each user task, exactly one per task
    (RULE-262). The Java AssigneeResolver evaluates them; BPMN holds no scripts and no business rules.
      type    ROLE | DEPARTMENT_HEAD | INITIATOR_SUPERVISOR | NAMED_USERS | REGIONAL_RECEIVABLES_MANAGER | DEPARTMENT_DIRECTOR
              | FORM_FIELD_USERS | FORM_FIELD_USER_SUPERVISORS | PROCESS_VARIABLE_USERS | INITIATOR
      initiatorNode="true"      the rework node the initiator resubmits from; skipped on the first pass (RULE-267/301)
      selfApproval="allowed"    exempts the node from the self-approval guard (RULE-307)
      beforeHook="KEY"          names the BEFORE hook the node runs inside the decide transaction (RULE-277/283)

    A user task INSIDE the sub-process returns to the initiator when it is rejected; a top-level user task ends the
    approval when it is rejected (RULE-271/290). Timesheet shape of the old system: manager_id nodes in a sub-process,
    then the department head.
  -->
  <process id="cost_timesheet_approval" name="Timesheet approval" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toInitiatorRework" sourceRef="start" targetRef="initiatorRework"/>
    <userTask id="initiatorRework" name="Initiator rework" flowable:skipExpression="${!returned}">
      <extensionElements>
        <forcitis:assignmentRule type="INITIATOR" initiatorNode="true"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toReviewStage" sourceRef="initiatorRework" targetRef="reviewStage"/>
    <subProcess id="reviewStage" name="Manager review">
      <startEvent id="reviewStart"/>
      <sequenceFlow id="toApproverReview" sourceRef="reviewStart" targetRef="approverReview"/>
      <userTask id="approverReview" name="Approver review">
        <extensionElements>
          <forcitis:assignmentRule type="FORM_FIELD_USERS" field="manager_id"/>
        </extensionElements>
      </userTask>
      <sequenceFlow id="toReviewEnd" sourceRef="approverReview" targetRef="reviewEnd"/>
      <endEvent id="reviewEnd"/>
    </subProcess>
    <sequenceFlow id="toDepartmentReview" sourceRef="reviewStage" targetRef="departmentReview"/>
    <userTask id="departmentReview" name="Department review">
      <extensionElements>
        <forcitis:assignmentRule type="DEPARTMENT_HEAD"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toEnd" sourceRef="departmentReview" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
