<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:forcitis="https://forcitis.com/psa/approval/extension"
             targetNamespace="https://forcitis.com/psa/approval">
  <!-- Branch conditions and field names are the ones cost.timesheet.api publishes; BpmnRuleConventionsTest keeps them equal. -->
  <process id="cost_timesheet_approval" name="工时审批" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="toReviewStage" sourceRef="start" targetRef="reviewStage"/>
    <subProcess id="reviewStage" name="审核">
      <startEvent id="reviewStart"/>
      <sequenceFlow id="toReviewFork" sourceRef="reviewStart" targetRef="reviewFork"/>
      <inclusiveGateway id="reviewFork"/>
      <sequenceFlow id="toProjectManagerReview" sourceRef="reviewFork" targetRef="projectManagerReview">
        <conditionExpression xsi:type="tFormalExpression">${vars:getOrDefault('projectHours', false)}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="toRegionalHeadReview" sourceRef="reviewFork" targetRef="regionalHeadReview">
        <conditionExpression xsi:type="tFormalExpression">${vars:getOrDefault('preSalesHours', false)}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="toSupervisorReview" sourceRef="reviewFork" targetRef="supervisorReview">
        <conditionExpression xsi:type="tFormalExpression">${vars:getOrDefault('overheadHours', false)}</conditionExpression>
      </sequenceFlow>
      <userTask id="projectManagerReview" name="项目经理审批">
        <extensionElements>
          <forcitis:assignmentRule type="FORM_FIELD_USERS" field="projectManagerId" skipWhenEmpty="true"/>
        </extensionElements>
      </userTask>
      <userTask id="regionalHeadReview" name="区域负责人审批">
        <extensionElements>
          <forcitis:assignmentRule type="FORM_FIELD_USERS" field="regionalHeadId" skipWhenEmpty="true"/>
        </extensionElements>
      </userTask>
      <userTask id="supervisorReview" name="一级汇报人审批">
        <extensionElements>
          <forcitis:assignmentRule type="INITIATOR_SUPERVISOR" level="1" skipWhenEmpty="true"/>
        </extensionElements>
      </userTask>
      <sequenceFlow id="fromProjectManagerReview" sourceRef="projectManagerReview" targetRef="reviewJoin"/>
      <sequenceFlow id="fromRegionalHeadReview" sourceRef="regionalHeadReview" targetRef="reviewJoin"/>
      <sequenceFlow id="fromSupervisorReview" sourceRef="supervisorReview" targetRef="reviewJoin"/>
      <inclusiveGateway id="reviewJoin"/>
      <sequenceFlow id="toReviewEnd" sourceRef="reviewJoin" targetRef="reviewEnd"/>
      <endEvent id="reviewEnd"/>
    </subProcess>
    <sequenceFlow id="toEnd" sourceRef="reviewStage" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
