<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:forcitis="https://forcitis.com/psa/approval/extension"
             targetNamespace="https://forcitis.com/psa/approval">
  <!-- Everything a node needs is an attribute of its forcitis:assignmentRule: routingFlag (the node runs only when the owning module set the
       flag), skipWhenEmpty, autoApproveRepeat, and deadlineWorkdays with escalationWorkdays (both or neither; D-1a-110..113: the deadline is
       23:59 of the n-th workday after the day the task is created, the reminder 09:00 of the next workday, the escalation 09:00 of the m-th
       workday after the reminder). A new version of this file applies to the approvals started after it is deployed.
       Each node is a countersign: one task per distinct approver, all must approve. -->
  <process id="cost_timesheet_approval" name="工时审批" isExecutable="true">
    <extensionElements>
      <forcitis:documentType code="TIMESHEET"/>
    </extensionElements>
    <startEvent id="start"/>
    <sequenceFlow id="toReviewStage" sourceRef="start" targetRef="reviewStage"/>
    <subProcess id="reviewStage" name="审核">
      <startEvent id="reviewStart"/>
      <sequenceFlow id="toReviewFork" sourceRef="reviewStart" targetRef="reviewFork"/>
      <inclusiveGateway id="reviewFork"/>
      <sequenceFlow id="toProjectManagerReview" sourceRef="reviewFork" targetRef="projectManagerReview">
        <conditionExpression xsi:type="tFormalExpression">${vars:getOrDefault('routed_projectManagerReview', false)}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="toOrgUnitHeadApproval" sourceRef="reviewFork" targetRef="orgUnitHeadApproval">
        <conditionExpression xsi:type="tFormalExpression">${vars:getOrDefault('routed_orgUnitHeadApproval', false)}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="toSupervisorReview" sourceRef="reviewFork" targetRef="supervisorReview">
        <conditionExpression xsi:type="tFormalExpression">${vars:getOrDefault('routed_supervisorReview', false)}</conditionExpression>
      </sequenceFlow>
      <userTask id="projectManagerReview" name="项目经理审批">
        <extensionElements>
          <forcitis:assignmentRule type="FORM_FIELD_USERS" field="projectManagerId" routingFlag="projectHours" skipWhenEmpty="true"
                                   autoApproveRepeat="true" deadlineWorkdays="1" escalationWorkdays="1"/>
        </extensionElements>
        <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${approverResolution.apply(execution)}"
                                          flowable:elementVariable="approver"/>
      </userTask>
      <userTask id="orgUnitHeadApproval" name="部门负责人审批">
        <extensionElements>
          <forcitis:assignmentRule type="FORM_FIELD_USERS" field="orgUnitHeadId" routingFlag="preSalesHours" skipWhenEmpty="true"
                                   autoApproveRepeat="true" deadlineWorkdays="1" escalationWorkdays="1"/>
        </extensionElements>
        <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${approverResolution.apply(execution)}"
                                          flowable:elementVariable="approver"/>
      </userTask>
      <userTask id="supervisorReview" name="一级汇报人审批">
        <extensionElements>
          <forcitis:assignmentRule type="INITIATOR_SUPERVISOR" level="1" routingFlag="overheadHours" skipWhenEmpty="true"
                                   autoApproveRepeat="true" deadlineWorkdays="1" escalationWorkdays="1"/>
        </extensionElements>
        <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${approverResolution.apply(execution)}"
                                          flowable:elementVariable="approver"/>
      </userTask>
      <sequenceFlow id="fromProjectManagerReview" sourceRef="projectManagerReview" targetRef="reviewJoin"/>
      <sequenceFlow id="fromOrgUnitHeadApproval" sourceRef="orgUnitHeadApproval" targetRef="reviewJoin"/>
      <sequenceFlow id="fromSupervisorReview" sourceRef="supervisorReview" targetRef="reviewJoin"/>
      <inclusiveGateway id="reviewJoin"/>
      <sequenceFlow id="toReviewEnd" sourceRef="reviewJoin" targetRef="reviewEnd"/>
      <endEvent id="reviewEnd"/>
    </subProcess>
    <sequenceFlow id="toEnd" sourceRef="reviewStage" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
