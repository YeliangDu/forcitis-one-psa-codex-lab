<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-30" targetNamespace="https://forcitis.one/bpmn/PRC-30" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-23" name="AGG-23"/>
  <collaboration id="Collab_PRC-30">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-30"/>
  </collaboration>
  <process id="PRC-30" name="提出并批准完工估算" isExecutable="false">
    <documentation>owner B-04；VS-02.0、VS-02.1、VS-02.2、VS-02.3、VS-02.4、VS-02.5、VS-02.6、VS-02.7</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S2_3</flowNodeRef>
        <flowNodeRef>S2_gw_4</flowNodeRef>
        <flowNodeRef>End_5</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S2_3</flowNodeRef>
        <flowNodeRef>S2_gw_4</flowNodeRef>
        <flowNodeRef>End_5</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目总监在阶段门处更新完工估算">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="提出完工估算">
      <documentation>AGG-23 提出完工估算；B-04；in_system；完工估算.提出；完工估算编制页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <userTask id="S2_3" name="批准完工估算">
      <documentation>AGG-23 批准完工估算；B-04；in_system；完工估算.批准；完工估算批准页；审批（aggregate）：完工估算批准</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S2_3">
        <dataOutput id="DOut_S2_3_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_3_1"><sourceRef>DOut_S2_3_1</sourceRef><targetRef>SR_S2_3_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_4" name="批准完工估算？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <endEvent id="End_5" name="已批准">
      <incoming>Flow_4</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S2_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S2_3" targetRef="S2_gw_4"/>
    <sequenceFlow id="Flow_4" name="批准" sourceRef="S2_gw_4" targetRef="End_5"/>
    <sequenceFlow id="Flow_5" name="其他" sourceRef="S2_gw_4" targetRef="S1_2"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-23" dataStoreRef="DS_AGG-23"/>
    <dataStoreReference id="SR_S2_3_w1" name="AGG-23" dataStoreRef="DS_AGG-23"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-30">
    <bpmndi:BPMNPlane id="Plane_PRC-30" bpmnElement="Collab_PRC-30">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="700" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SH-M1" bpmnElement="Lane_SH-M1" isHorizontal="true">
        <dc:Bounds x="30" y="130" width="670" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SH-M1" bpmnElement="Lane_SH-M1" isHorizontal="true">
        <dc:Bounds x="30" y="130" width="670" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_2" bpmnElement="S1_2">
        <dc:Bounds x="185" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_3" bpmnElement="S2_3">
        <dc:Bounds x="355" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_gw_4" bpmnElement="S2_gw_4" isMarkerVisible="true">
        <dc:Bounds x="510" y="170" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="490" y="136" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_5" bpmnElement="End_5">
        <dc:Bounds x="607" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_2_w1" bpmnElement="SR_S1_2_w1">
        <dc:Bounds x="217" y="134" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_3_w1" bpmnElement="SR_S2_3_w1">
        <dc:Bounds x="387" y="134" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="123" y="195"/>
        <di:waypoint x="185" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="195"/>
        <di:waypoint x="355" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="455" y="195"/>
        <di:waypoint x="510" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="560" y="195"/>
        <di:waypoint x="607" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="535" y="220"/>
        <di:waypoint x="535" y="124"/>
        <di:waypoint x="235" y="124"/>
        <di:waypoint x="235" y="225"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S1_2_1" bpmnElement="DOA_S1_2_1">
        <di:waypoint x="235" y="165"/>
        <di:waypoint x="235" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S2_3_1" bpmnElement="DOA_S2_3_1">
        <di:waypoint x="405" y="165"/>
        <di:waypoint x="405" y="160"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
