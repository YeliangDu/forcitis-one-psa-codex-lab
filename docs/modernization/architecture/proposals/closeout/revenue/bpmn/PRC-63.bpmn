<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-63" targetNamespace="https://forcitis.one/bpmn/PRC-63" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-50" name="AGG-50"/>
  <dataStore id="DS_AGG-49" name="AGG-49"/>
  <collaboration id="Collab_PRC-63">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-63"/>
    <participant id="Pool_1" name="银行"/>
    <messageFlow id="Msg_1" name="登记商票兑付" sourceRef="S1_2" targetRef="Pool_1"/>
    <messageFlow id="Msg_2" name="银行返回结果" sourceRef="Pool_1" targetRef="S1_recv_5"/>
  </collaboration>
  <process id="PRC-63" name="商业汇票兑付与逾期" isExecutable="false">
    <documentation>owner B-09；VS-04.4</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_recv_5</flowNodeRef>
        <flowNodeRef>S1_gw_6</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>S1_2_bd_3</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S1_2_esc_4</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S2_7</flowNodeRef>
        <flowNodeRef>S3_8</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="商票到期日">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <sendTask id="S1_2" name="登记商票兑付">
      <documentation>AGG-50 登记商票兑付；B-09；external:银行；收款.登记商票兑付；商票兑付登记页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <dataOutput id="DOut_S1_2_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs><dataOutputRefs>DOut_S1_2_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S1_2_2"><sourceRef>DOut_S1_2_2</sourceRef><targetRef>OR_S1_2_1</targetRef></dataOutputAssociation>
    </sendTask>
    <boundaryEvent id="S1_2_bd_3" name="期限 商票到期日" cancelActivity="false" attachedToRef="S1_2">
      <outgoing>Flow_8</outgoing>
      <timerEventDefinition><timeDuration>商票到期日</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_2_esc_4" name="处理超时：登记商票兑付">
      <documentation>升级给 SH-M1；期限 商票到期日</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S1_2_esc_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <intermediateCatchEvent id="S1_recv_5" name="银行返回结果">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <exclusiveGateway id="S1_gw_6" name="登记商票兑付？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_7" name="标记商票已逾期">
      <documentation>AGG-50 标记商票已逾期；B-09；automatic</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_7">
        <dataOutput id="DOut_S2_7_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_7_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_7_1"><sourceRef>DOut_S2_7_1</sourceRef><targetRef>SR_S2_7_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <serviceTask id="S3_8" name="释放占用、恢复应收">
      <documentation>AGG-49 释放占用、恢复应收；B-09；automatic</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S3_8">
        <dataOutput id="DOut_S3_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_8_1"><sourceRef>DOut_S3_8_1</sourceRef><targetRef>SR_S3_8_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_9" name="商票已贴现或背书转让">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_10" name="暂挂待跨年处理">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_11" name="已兑付">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_12" name="已提醒">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_13" name="商票已逾期">
      <incoming>Flow_11</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_recv_5"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_recv_5" targetRef="S1_gw_6"/>
    <sequenceFlow id="Flow_4" name="到期日已过仍未收到兑付款" sourceRef="S1_gw_6" targetRef="S2_7"/>
    <sequenceFlow id="Flow_5" name="到期前已贴现或背书转让（商票不再由本公司持有）" sourceRef="S1_gw_6" targetRef="End_9"/>
    <sequenceFlow id="Flow_6" name="原期间所在年度已年结" sourceRef="S1_gw_6" targetRef="End_10"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S1_gw_6" targetRef="End_11"/>
    <sequenceFlow id="Flow_8" sourceRef="S1_2_bd_3" targetRef="S1_2_esc_4"/>
    <sequenceFlow id="Flow_9" sourceRef="S1_2_esc_4" targetRef="End_12"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_7" targetRef="S3_8"/>
    <sequenceFlow id="Flow_11" sourceRef="S3_8" targetRef="End_13"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-50" dataStoreRef="DS_AGG-50"/>
    <dataObject id="DObj_OR_S1_2_1"/>
    <dataObjectReference id="OR_S1_2_1" name="银行到账回单或承兑人兑付…" dataObjectRef="DObj_OR_S1_2_1"/>
    <dataStoreReference id="SR_S2_7_w1" name="AGG-50" dataStoreRef="DS_AGG-50"/>
    <dataStoreReference id="SR_S3_8_w1" name="AGG-49" dataStoreRef="DS_AGG-49"/>
  </process>
