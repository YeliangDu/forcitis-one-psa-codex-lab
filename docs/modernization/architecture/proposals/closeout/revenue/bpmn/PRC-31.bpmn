  <process id="PRC-31" name="提出并发出设计变更" isExecutable="false">
    <documentation>owner B-28；VS-02.2、VS-02.3、VS-02.4、VS-02.5、VS-02.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E3" name="设计师和顾问（SH-E3）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
