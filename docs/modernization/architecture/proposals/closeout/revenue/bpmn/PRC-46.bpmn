      <dataOutputAssociation id="DOA_S2_reg_7_2"><sourceRef>DOut_S2_reg_7_2</sourceRef><targetRef>OR_S2_reg_7_1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_api_8" name="采集证据 → B-28">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_api_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <userTask id="S3_9" name="登记外部检测报告">
      <documentation>AGG-37 登记外部检测报告；B-26；in_system；外部检测.登记报告；外部检测登记页</documentation>
