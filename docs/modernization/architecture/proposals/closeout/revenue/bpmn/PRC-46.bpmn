  <process id="PRC-46" name="采信外部检测报告" isExecutable="false">
    <documentation>owner B-26；VS-03.4</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E4" name="技术专家（SH-E4）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S2_manual_4</flowNodeRef>
        <flowNodeRef>S2_manual_4_esc_6</flowNodeRef>
