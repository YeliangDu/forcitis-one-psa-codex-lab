        <flowNodeRef>End_16</flowNodeRef>
        <flowNodeRef>End_17</flowNodeRef>
        <flowNodeRef>S2_manual_4_bd_5</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_3</flowNodeRef>
        <flowNodeRef>S2_api_8</flowNodeRef>
        <flowNodeRef>S3_api_10</flowNodeRef>
        <flowNodeRef>S3_api_11</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="业主委托外部检测并取得报告，检查负责人登记">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="登记业主委托外部检测">
      <documentation>AGG-37 登记业主委托外部检测；B-26；in_system；外部检测.登记委托；外部检测登记页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S1_api_3" name="读检测机构 → B-01">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_3">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <manualTask id="S2_manual_4" name="线下办理采集证据">
      <documentation>线下办理；证据：外部检测报告原件（电子文件或纸质扫描，计内容哈希）；收到日、转交人与出具机构资质证明</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S2_manual_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <boundaryEvent id="S2_manual_4_bd_5" name="期限 P30D" cancelActivity="false" attachedToRef="S2_manual_4">
      <outgoing>Flow_7</outgoing>
      <timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_manual_4_esc_6" name="处理超时：采集证据">
      <documentation>升级给 SH-E4；期限 P30D</documentation>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S2_manual_4_esc_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <userTask id="S2_reg_7" name="登记采集证据">
      <documentation>AGG-38 采集证据；B-26；offline；证据.采集；证据上传页</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S2_reg_7">
