  <process id="PRC-16" name="申请并转正风险交付授权" isExecutable="false">
    <documentation>owner B-05；VS-01.2、VS-02.0、VS-04.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>S2_3</flowNodeRef>
        <flowNodeRef>S2_gw_5</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S7_12</flowNodeRef>
        <flowNodeRef>End_17</flowNodeRef>
      </lane>
