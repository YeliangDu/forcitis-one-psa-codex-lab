    </userTask>
    <exclusiveGateway id="S3_gw_14" name="登记协议归还？">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <outgoing>Flow_17</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="S4_time_15" name="预计归还日届满且未归还">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_20</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <serviceTask id="S4_16" name="标记协议借阅逾期">
      <documentation>AGG-13 标记协议借阅逾期；B-05；automatic</documentation>
