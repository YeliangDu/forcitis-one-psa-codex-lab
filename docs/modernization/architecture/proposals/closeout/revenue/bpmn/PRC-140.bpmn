      <outgoing>Flow_18</outgoing>
      <timerEventDefinition><timeDuration>预计归还日（取自审批载荷）</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S3_manual_10_esc_12" name="处理超时：登记协议归还">
      <documentation>升级给 SH-E6；期限 预计归还日（取自审批载荷）</documentation>
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
      <ioSpecification id="IO_S3_manual_10_esc_12">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <userTask id="S3_reg_13" name="登记协议归还">
      <documentation>AGG-13 登记协议归还；B-05；offline；协议借阅.登记归还；协议归还登记页</documentation>
