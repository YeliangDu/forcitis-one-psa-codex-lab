      <dataOutputAssociation id="DOA_S2_reg_8_2"><sourceRef>DOut_S2_reg_8_2</sourceRef><targetRef>OR_S2_reg_8_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_9" name="登记协议借出？">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_13</outgoing>
    </exclusiveGateway>
    <manualTask id="S3_manual_10" name="线下办理协议归还">
      <documentation>线下办理；证据：归还签收单（归还日、接收人、份数）</documentation>
      <incoming>Flow_13</incoming>
      <incoming>Flow_21</incoming>
      <outgoing>Flow_14</outgoing>
      <ioSpecification id="IO_S3_manual_10">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
