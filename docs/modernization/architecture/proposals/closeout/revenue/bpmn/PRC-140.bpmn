      </lane>
    </laneSet>
    <startEvent id="Start_1" name="员工提交合同借阅申请">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="借阅人选已归档协议，在审批载荷中写借阅目的、借阅形式">
      <documentation>借阅人选已归档协议，在审批载荷中写借阅目的、借阅形式；B-05；in_system；合同借阅.申请；合同借阅申请页；审批平台：合同借阅审批</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S1_2_bd_3" name="期限 P3D" cancelActivity="false" attachedToRef="S1_2">
      <outgoing>Flow_8</outgoing>
      <timerEventDefinition><timeDuration>P3D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_2_esc_4" name="处理超时：借阅人选已归档协议，在审批载荷中写借阅目的、借阅形式">
      <documentation>升级给 SH-M1；期限 P3D</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S1_2_esc_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S1_api_5" name="发起合同借阅审批 → platform.approval">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S1_gw_6" name="借阅人选已归档协议，在审批载荷中写借阅目的、借阅形式？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <manualTask id="S2_manual_7" name="线下办理协议借出">
      <documentation>线下办理；证据：借阅人签收的借出单（借出日、原件或复印件、份数）；合同借阅审批实例编号</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_manual_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S2_reg_8" name="登记协议借出">
      <documentation>AGG-13 登记协议借出；B-05；offline；协议借阅.登记借出；协议借出登记页</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
