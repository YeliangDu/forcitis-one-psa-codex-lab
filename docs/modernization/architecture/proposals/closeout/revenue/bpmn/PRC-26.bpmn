    <participant id="P_main" name="FORCITIS one" processRef="PRC-26"/>
  </collaboration>
  <process id="PRC-26" name="接收并确认发包人提供资料" isExecutable="false">
    <documentation>owner B-28；VS-02.0、VS-02.1、VS-02.2、VS-02.3、VS-02.4</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S2_manual_6</flowNodeRef>
        <flowNodeRef>S2_reg_7</flowNodeRef>
        <flowNodeRef>S1_3_bd_4</flowNodeRef>
      </lane>
      <lane id="Lane_SH-E3" name="设计师和顾问（SH-E3）">
        <flowNodeRef>S3_9</flowNodeRef>
        <flowNodeRef>S3_gw_10</flowNodeRef>
        <flowNodeRef>S4_11</flowNodeRef>
        <flowNodeRef>S4_gw_12</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
        <flowNodeRef>End_15</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S1_3_esc_5</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S2_api_8</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目经理按交付需要登记所需发包人资料及计划提供日">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="发包人主动提供首批或后续资料，项目经理收件">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <userTask id="S1_3" name="登记资料需求">
      <documentation>AGG-32 登记资料需求；B-28；in_system；发包人资料.登记需求；发包人资料需求页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataOutput id="DOut_S1_3_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>SR_S1_3_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S1_3_bd_4" name="期限 计划提供日" cancelActivity="false" attachedToRef="S1_3">
      <outgoing>Flow_4</outgoing>
      <timerEventDefinition><timeDuration>计划提供日</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_3_esc_5" name="处理超时：登记资料需求">
      <documentation>升级给 SH-M1；期限 计划提供日</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S1_3_esc_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <manualTask id="S2_manual_6" name="线下办理资料已提供">
      <documentation>线下办理；证据：收件凭证：发包人资料清单签收单、邮件原始报文或网盘交接记录之一；提供日与提供人（发包人代表或授权人）</documentation>
      <incoming>Flow_3</incoming>
      <incoming>Flow_14</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_manual_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S2_reg_7" name="登记资料已提供">
      <documentation>AGG-32 登记资料已提供；B-28；offline；发包人资料.登记提供；发包人资料登记页；调用 PRC-33</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_reg_7">
        <dataOutput id="DOut_S2_reg_7_1"/>
        <dataOutput id="DOut_S2_reg_7_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_reg_7_1</dataOutputRefs><dataOutputRefs>DOut_S2_reg_7_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_reg_7_1"><sourceRef>DOut_S2_reg_7_1</sourceRef><targetRef>SR_S2_reg_7_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S2_reg_7_2"><sourceRef>DOut_S2_reg_7_2</sourceRef><targetRef>OR_S2_reg_7_1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_api_8" name="关联项目 → B-04">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S2_api_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <userTask id="S3_9" name="确认发包人资料">
      <documentation>AGG-32 确认发包人资料；B-28；in_system；发包人资料.确认；发包人资料确认页；审批（aggregate）：发包人资料确认</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S3_9">
        <dataOutput id="DOut_S3_9_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_9_1</dataOutputRefs></outputSet>
