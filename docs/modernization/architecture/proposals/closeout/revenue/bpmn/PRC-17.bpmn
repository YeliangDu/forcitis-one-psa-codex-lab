      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="先行投入路径（风险交付授权已批准）由项目经理人工发起建项">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="读来源商机与建设工程 → B-03、B-01">
