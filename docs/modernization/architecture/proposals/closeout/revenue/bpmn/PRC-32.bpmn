    <startEvent id="Start_1" name="出现影响进度的客观原因，项目经理向发包人发出延期通知">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="发包人答复期满仍未答复（定时命令，按延期申请幂等）">
