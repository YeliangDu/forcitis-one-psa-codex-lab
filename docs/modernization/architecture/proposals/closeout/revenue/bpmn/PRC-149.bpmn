<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-149" targetNamespace="https://forcitis.one/bpmn/PRC-149" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="协议已结算（B-05 发出；最终价款低于累计确认时冲销，高于时转补充确认）"/>
  <signal id="Signal_2" name="协议已终止（B-05 发出；已确认但终止后不再成立的部分冲销）"/>
  <dataStore id="DS_AGG-44" name="AGG-44"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <collaboration id="Collab_PRC-149">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-149"/>
  </collaboration>
  <process id="PRC-149" name="冲销收入确认" isExecutable="false">
    <documentation>owner B-08；VS-04.2、VS-04.5</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>End_22</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S4_10_esc_12</flowNodeRef>
        <flowNodeRef>End_23</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>Start_3</flowNodeRef>
        <flowNodeRef>S1_4</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>S3_8</flowNodeRef>
        <flowNodeRef>S3_gw_9</flowNodeRef>
        <flowNodeRef>S4_10</flowNodeRef>
        <flowNodeRef>S4_api_13</flowNodeRef>
        <flowNodeRef>S4_gw_14</flowNodeRef>
        <flowNodeRef>S5_15</flowNodeRef>
        <flowNodeRef>S5_gw_16</flowNodeRef>
        <flowNodeRef>S6_17</flowNodeRef>
        <flowNodeRef>S6_gw_18</flowNodeRef>
        <flowNodeRef>S7_19</flowNodeRef>
        <flowNodeRef>End_20</flowNodeRef>
        <flowNodeRef>End_21</flowNodeRef>
        <flowNodeRef>End_24</flowNodeRef>
        <flowNodeRef>End_25</flowNodeRef>
        <flowNodeRef>End_26</flowNodeRef>
        <flowNodeRef>S4_10_bd_11</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="财务或项目经理发起冲销（客户撤回认可、证据事后失效、审批误批）">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="协议已结算（B-05 发出；最终价款低于累计确认时冲销，高于时转补充确认）">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_3" name="协议已终止（B-05 发出；已确认但终止后不再成立的部分冲销）">
      <outgoing>Flow_3</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <serviceTask id="S1_4" name="读原收入确认事实、累计确认与分摊价格，以及协议结算或终止状态 → B-05">
      <documentation>读原收入确认事实、累计确认与分摊价格，以及协议结算或终止状态；B-08；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_4">
        <dataInput id="DIn_S1_4_1"/>
        <dataInput id="DIn_S1_4_2"/>
        <inputSet><dataInputRefs>DIn_S1_4_1</dataInputRefs><dataInputRefs>DIn_S1_4_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_4_1"><sourceRef>SR_S1_4_r1</sourceRef><targetRef>DIn_S1_4_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_4_2"><sourceRef>SR_S1_4_r2</sourceRef><targetRef>DIn_S1_4_2</targetRef></dataInputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_5" name="读原收入确认事实、累计确认与分摊价格，以及协议结算或终止状态？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <userTask id="S2_6" name="冲销收入确认">
      <documentation>AGG-44 冲销收入确认；B-08；in_system；收入冲销.提交；收入冲销申请页</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataOutput id="DOut_S2_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_6_1"><sourceRef>DOut_S2_6_1</sourceRef><targetRef>SR_S2_6_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_7" name="冲销收入确认？">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_8" name="占用冲销额度">
      <documentation>AGG-44 占用冲销额度；B-08；automatic</documentation>
      <incoming>Flow_7</incoming>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S3_8">
        <dataOutput id="DOut_S3_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_8_1"><sourceRef>DOut_S3_8_1</sourceRef><targetRef>SR_S3_8_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S3_gw_9" name="占用冲销额度？">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <outgoing>Flow_14</outgoing>
    </exclusiveGateway>
    <userTask id="S4_10" name="收入冲销审批">
      <documentation>收入冲销审批；B-08；in_system；收入冲销.审批；审批待办页；审批平台：收入冲销审批单</documentation>
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
      <ioSpecification id="IO_S4_10">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S4_10_bd_11" name="期限 P5D" cancelActivity="false" attachedToRef="S4_10">
      <outgoing>Flow_20</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S4_10_esc_12" name="处理超时：收入冲销审批">
      <documentation>升级给 SH-M1；期限 P5D</documentation>
      <incoming>Flow_20</incoming>
      <outgoing>Flow_21</outgoing>
      <ioSpecification id="IO_S4_10_esc_12">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S4_api_13" name="发起收入冲销审批 → platform.approval">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <ioSpecification id="IO_S4_api_13">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S4_gw_14" name="收入冲销审批？">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <outgoing>Flow_18</outgoing>
      <outgoing>Flow_19</outgoing>
    </exclusiveGateway>
    <serviceTask id="S5_15" name="追加冲销行并占用转实">
      <documentation>AGG-44 追加冲销行并占用转实；B-08；automatic</documentation>
      <incoming>Flow_17</incoming>
      <outgoing>Flow_22</outgoing>
      <ioSpecification id="IO_S5_15">
        <dataOutput id="DOut_S5_15_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_15_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_15_1"><sourceRef>DOut_S5_15_1</sourceRef><targetRef>SR_S5_15_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S5_gw_16" name="追加冲销行并占用转实？">
      <incoming>Flow_22</incoming>
      <outgoing>Flow_23</outgoing>
      <outgoing>Flow_24</outgoing>
    </exclusiveGateway>
    <serviceTask id="S6_17" name="提交过账候选 → B-16">
      <documentation>AGG-44 提交过账候选；B-08；automatic；调用 PRC-92</documentation>
      <incoming>Flow_24</incoming>
      <outgoing>Flow_25</outgoing>
      <ioSpecification id="IO_S6_17">
        <dataOutput id="DOut_S6_17_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S6_17_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S6_17_1"><sourceRef>DOut_S6_17_1</sourceRef><targetRef>SR_S6_17_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S6_gw_18" name="提交过账候选？">
      <incoming>Flow_25</incoming>
      <outgoing>Flow_26</outgoing>
      <outgoing>Flow_27</outgoing>
    </exclusiveGateway>
    <serviceTask id="S7_19" name="释放收入额度占用">
      <documentation>AGG-44 释放收入额度占用；B-08；automatic</documentation>
      <incoming>Flow_18</incoming>
      <incoming>Flow_19</incoming>
      <incoming>Flow_23</incoming>
      <outgoing>Flow_28</outgoing>
      <ioSpecification id="IO_S7_19">
        <dataOutput id="DOut_S7_19_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S7_19_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S7_19_1"><sourceRef>DOut_S7_19_1</sourceRef><targetRef>SR_S7_19_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_20" name="已转 PRC-53">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_21" name="无需冲销">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_22" name="冲销被拒">
      <incoming>Flow_10</incoming>
      <incoming>Flow_13</incoming>
    </endEvent>
    <endEvent id="End_23" name="已提醒">
      <incoming>Flow_21</incoming>
    </endEvent>
    <endEvent id="End_24" name="暂挂待跨年处理">
      <incoming>Flow_26</incoming>
    </endEvent>
    <endEvent id="End_25" name="收入已冲销">
      <incoming>Flow_27</incoming>
    </endEvent>
    <endEvent id="End_26" name="冲销已驳回">
      <incoming>Flow_28</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_4"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_4"/>
