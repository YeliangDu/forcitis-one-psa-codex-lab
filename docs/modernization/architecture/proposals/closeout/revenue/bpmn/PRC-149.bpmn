    <sequenceFlow id="Flow_12" sourceRef="S3_8" targetRef="S3_gw_9"/>
    <sequenceFlow id="Flow_13" name="在途冲销与已冲销合计超过原确认事实" sourceRef="S3_gw_9" targetRef="End_22"/>
    <sequenceFlow id="Flow_14" name="其他" sourceRef="S3_gw_9" targetRef="S4_10"/>
    <sequenceFlow id="Flow_15" sourceRef="S4_10" targetRef="S4_api_13"/>
    <sequenceFlow id="Flow_16" sourceRef="S4_api_13" targetRef="S4_gw_14"/>
    <sequenceFlow id="Flow_17" name="审批通过" sourceRef="S4_gw_14" targetRef="S5_15"/>
    <sequenceFlow id="Flow_18" name="提交人撤回冲销申请" sourceRef="S4_gw_14" targetRef="S7_19"/>
    <sequenceFlow id="Flow_19" name="其他" sourceRef="S4_gw_14" targetRef="S7_19"/>
    <sequenceFlow id="Flow_20" sourceRef="S4_10_bd_11" targetRef="S4_10_esc_12"/>
    <sequenceFlow id="Flow_21" sourceRef="S4_10_esc_12" targetRef="End_23"/>
    <sequenceFlow id="Flow_22" sourceRef="S5_15" targetRef="S5_gw_16"/>
    <sequenceFlow id="Flow_23" name="二次校验失败（原确认事实已被其他冲销占满）" sourceRef="S5_gw_16" targetRef="S7_19"/>
    <sequenceFlow id="Flow_24" name="其他" sourceRef="S5_gw_16" targetRef="S6_17"/>
    <sequenceFlow id="Flow_25" sourceRef="S6_17" targetRef="S6_gw_18"/>
    <sequenceFlow id="Flow_26" name="原期间所在年度已年结" sourceRef="S6_gw_18" targetRef="End_24"/>
    <sequenceFlow id="Flow_27" name="其他" sourceRef="S6_gw_18" targetRef="End_25"/>
    <sequenceFlow id="Flow_28" sourceRef="S7_19" targetRef="End_26"/>
    <dataStoreReference id="SR_S1_4_r1" name="AGG-44" dataStoreRef="DS_AGG-44"/>
    <dataStoreReference id="SR_S1_4_r2" name="AGG-13" dataStoreRef="DS_AGG-13"/>
