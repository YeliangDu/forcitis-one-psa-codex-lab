    <sequenceFlow id="Flow_5" name="协议已结算且最终价款高于累计确认（差额为正）" sourceRef="S1_gw_5" targetRef="End_20"/>
    <sequenceFlow id="Flow_6" name="协议已结算且最终价款不低于累计确认，或协议终止后已确认部分仍成立" sourceRef="S1_gw_5" targetRef="End_21"/>
    <sequenceFlow id="Flow_7" name="协议已结算（差额为负）或协议已终止（已确认部分不再成立）" sourceRef="S1_gw_5" targetRef="S3_8"/>
