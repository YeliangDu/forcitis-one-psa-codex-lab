  <process id="PRC-78" name="年检、核查与延续企业资质" isExecutable="false">
    <documentation>owner B-01；VS-06.2</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S3_manual_5</flowNodeRef>
        <flowNodeRef>S3_reg_6</flowNodeRef>
        <flowNodeRef>S3_gw_7</flowNodeRef>
        <flowNodeRef>S4_manual_8</flowNodeRef>
        <flowNodeRef>S4_reg_9</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
        <flowNodeRef>End_15</flowNodeRef>
        <flowNodeRef>End_16</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S5_10</flowNodeRef>
        <flowNodeRef>S5_gw_11</flowNodeRef>
        <flowNodeRef>End_17</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S6_time_12</flowNodeRef>
        <flowNodeRef>S6_13</flowNodeRef>
        <flowNodeRef>End_18</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="资质有效期临近到期（P-02 提醒）">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <startEvent id="Start_2" name="收到发证机关下发的年检或动态核查通知（SH-R2），职能人员发起核查">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="发起核查前读持证法人主体 → B-13">
      <documentation>发起核查前读持证法人主体；B-01；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
    </serviceTask>
    <userTask id="S2_4" name="发起资质核查">
      <documentation>AGG-02 发起资质核查；B-01；in_system；资质证书.发起核查；资质核查页</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <manualTask id="S3_manual_5" name="线下办理核查结果">
      <documentation>线下办理；证据：年检回执或核查结论通知书（扫描件）；核查日期与发证机关</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S3_manual_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S3_reg_6" name="登记核查结果">
      <documentation>AGG-02 登记核查结果；B-01；offline；资质证书.登记核查结果；资质核查页</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S3_reg_6">
        <dataOutput id="DOut_S3_reg_6_1"/>
        <dataOutput id="DOut_S3_reg_6_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_reg_6_1</dataOutputRefs><dataOutputRefs>DOut_S3_reg_6_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_reg_6_1"><sourceRef>DOut_S3_reg_6_1</sourceRef><targetRef>SR_S3_reg_6_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S3_reg_6_2"><sourceRef>DOut_S3_reg_6_2</sourceRef><targetRef>OR_S3_reg_6_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_7" name="登记核查结果？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <manualTask id="S4_manual_8" name="线下办理资质延续申请">
      <documentation>线下办理；证据：延续申请受理回执（发证机关）；申请材料清单</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S4_manual_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S4_reg_9" name="登记资质延续申请">
      <documentation>AGG-02 登记资质延续申请；B-01；offline；资质证书.登记延续申请；资质延续申请登记页</documentation>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S4_reg_9">
        <dataOutput id="DOut_S4_reg_9_1"/>
        <dataOutput id="DOut_S4_reg_9_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_reg_9_1</dataOutputRefs><dataOutputRefs>DOut_S4_reg_9_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_reg_9_1"><sourceRef>DOut_S4_reg_9_1</sourceRef><targetRef>SR_S4_reg_9_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S4_reg_9_2"><sourceRef>DOut_S4_reg_9_2</sourceRef><targetRef>OR_S4_reg_9_1</targetRef></dataOutputAssociation>
    </userTask>
    <userTask id="S5_10" name="延续资质">
      <documentation>AGG-02 延续资质；B-01；in_system；资质证书.延续；资质延续批准页；审批（aggregate）：资质延续审批单</documentation>
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <ioSpecification id="IO_S5_10">
        <dataOutput id="DOut_S5_10_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_10_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_10_1"><sourceRef>DOut_S5_10_1</sourceRef><targetRef>SR_S5_10_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S5_gw_11" name="延续资质？">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <outgoing>Flow_15</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="S6_time_12" name="到期日届满">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <serviceTask id="S6_13" name="标记资质已到期">
      <documentation>AGG-02 标记资质已到期；B-01；automatic</documentation>
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <ioSpecification id="IO_S6_13">
        <dataOutput id="DOut_S6_13_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S6_13_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S6_13_1"><sourceRef>DOut_S6_13_1</sourceRef><targetRef>SR_S6_13_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_14" name="资质已撤销">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_15" name="资质已降级">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_16" name="核查通过">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_17" name="资质已延续">
      <incoming>Flow_14</incoming>
    </endEvent>
    <endEvent id="End_18" name="资质已到期">
      <incoming>Flow_17</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
