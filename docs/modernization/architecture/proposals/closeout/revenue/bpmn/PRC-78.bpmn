    <sequenceFlow id="Flow_8" name="核查结论为降级，资质已降级" sourceRef="S3_gw_7" targetRef="End_15"/>
    <sequenceFlow id="Flow_9" name="核查结论为有效且无需延续，核查通过" sourceRef="S3_gw_7" targetRef="End_16"/>
