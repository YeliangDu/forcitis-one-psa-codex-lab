    <sequenceFlow id="Flow_15" name="其他" sourceRef="S5_gw_11" targetRef="S6_time_12"/>
    <sequenceFlow id="Flow_16" sourceRef="S6_time_12" targetRef="S6_13"/>
    <sequenceFlow id="Flow_17" sourceRef="S6_13" targetRef="End_18"/>
