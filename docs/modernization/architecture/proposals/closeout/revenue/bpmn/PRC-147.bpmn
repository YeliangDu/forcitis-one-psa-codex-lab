      <dataOutputAssociation id="DOA_S3_6_1"><sourceRef>DOut_S3_6_1</sourceRef><targetRef>SR_S3_6_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <serviceTask id="S4_7" name="标记费用报销已付 → B-12">
      <documentation>AGG-59 标记费用报销已付；B-09；automatic</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S4_7">
        <dataOutput id="DOut_S4_7_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_7_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_7_1"><sourceRef>DOut_S4_7_1</sourceRef><targetRef>SR_S4_7_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_8" name="暂挂待跨年处理">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_9" name="应付已确认">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_10" name="报销已置已付">
      <incoming>Flow_11</incoming>
    </endEvent>
