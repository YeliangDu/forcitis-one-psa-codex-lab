    </laneSet>
    <startEvent id="Start_1" name="费用报销已核定">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <serviceTask id="S1_2" name="冲抵员工借款 → B-13">
      <documentation>AGG-49 冲抵员工借款；B-09；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_3" name="冲抵员工借款？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_4" name="提交过账候选 → B-16">
      <documentation>AGG-49 提交过账候选；B-09；automatic；调用 PRC-92</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S2_gw_5" name="提交过账候选？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_6" name="确认应付 → B-10">
      <documentation>AGG-52 确认应付；B-09；automatic</documentation>
      <incoming>Flow_3</incoming>
      <incoming>Flow_4</incoming>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S3_6">
