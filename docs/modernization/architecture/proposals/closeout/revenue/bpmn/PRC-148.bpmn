      <dataOutputAssociation id="DOA_S4_8_1"><sourceRef>DOut_S4_8_1</sourceRef><targetRef>SR_S4_8_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S4_8_bd_9" name="期限 P5D" cancelActivity="false" attachedToRef="S4_8">
      <outgoing>Flow_14</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S4_8_esc_10" name="处理超时：释放收入额度占用">
      <documentation>升级给 SH-M1；期限 P5D</documentation>
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
      <ioSpecification id="IO_S4_8_esc_10">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
