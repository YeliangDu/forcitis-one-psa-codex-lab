    </laneSet>
    <startEvent id="Start_1" name="审批已通过（单据类型：收入确认审批）">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="审批已驳回（单据类型：收入确认审批）">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <serviceTask id="S1_3" name="追加收入确认事实并占用转实 → B-28、B-13">
      <documentation>AGG-44 追加收入确认事实并占用转实；B-08；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <dataOutput id="DOut_S1_3_1"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>SR_S1_3_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="追加收入确认事实并占用转实？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_5" name="提交过账候选 → B-16">
      <documentation>AGG-44 提交过账候选；B-08；automatic；调用 PRC-92</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S2_gw_6" name="提交过账候选？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_7" name="释放收入额度占用">
      <documentation>AGG-44 释放收入额度占用；B-08；automatic</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S3_7">
        <dataOutput id="DOut_S3_7_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_7_1</dataOutputRefs></outputSet>
