      <dataOutputAssociation id="DOA_S3_7_1"><sourceRef>DOut_S3_7_1</sourceRef><targetRef>SR_S3_7_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <userTask id="S4_8" name="释放收入额度占用">
      <documentation>AGG-44 释放收入额度占用；B-08；in_system；收入确认.处置占用；占用待处置页</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S4_8">
        <dataOutput id="DOut_S4_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_8_1</dataOutputRefs></outputSet>
