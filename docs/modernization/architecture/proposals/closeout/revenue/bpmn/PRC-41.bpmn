      <dataOutputAssociation id="DOA_S5_10_1"><sourceRef>DOut_S5_10_1</sourceRef><targetRef>SR_S5_10_w1</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="End_11" name="无需检查计划">
      <incoming>Flow_4</incoming>
    </endEvent>
    <endEvent id="End_12" name="计划已生效">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_13" name="已提醒">
      <incoming>Flow_11</incoming>
    </endEvent>
    <endEvent id="End_14" name="不再受托">
      <incoming>Flow_12</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_3"/>
