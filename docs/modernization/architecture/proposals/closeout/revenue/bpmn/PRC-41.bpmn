      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S5_10">
        <dataOutput id="DOut_S5_10_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_10_1</dataOutputRefs></outputSet>
