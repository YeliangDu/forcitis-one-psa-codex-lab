  <signal id="Signal_1" name="协议已生效"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <dataStore id="DS_AGG-33" name="AGG-33"/>
  <dataStore id="DS_AGG-34" name="AGG-34"/>
  <collaboration id="Collab_PRC-41">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-41"/>
  </collaboration>
  <process id="PRC-41" name="制定并生效检查计划" isExecutable="false">
    <documentation>owner B-26；VS-03.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E4" name="技术专家（SH-E4）">
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S3_5</flowNodeRef>
        <flowNodeRef>S4_6_esc_8</flowNodeRef>
        <flowNodeRef>S5_10</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_3</flowNodeRef>
        <flowNodeRef>S4_6</flowNodeRef>
        <flowNodeRef>S4_gw_9</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>S4_6_bd_7</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="协议已生效">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <serviceTask id="S1_2" name="读协议与受检部位 → B-05、B-01">
      <documentation>读协议与受检部位；B-26；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataInput id="DIn_S1_2_1"/>
        <dataInput id="DIn_S1_2_2"/>
        <inputSet><dataInputRefs>DIn_S1_2_1</dataInputRefs><dataInputRefs>DIn_S1_2_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_2_1"><sourceRef>SR_S1_2_r1</sourceRef><targetRef>DIn_S1_2_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_2_2"><sourceRef>SR_S1_2_r2</sourceRef><targetRef>DIn_S1_2_2</targetRef></dataInputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_3" name="读协议与受检部位？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
    </exclusiveGateway>
    <userTask id="S2_4" name="登记检查计划">
      <documentation>AGG-34 登记检查计划；B-26；in_system；检查计划.登记；检查计划编辑页</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <userTask id="S3_5" name="生效检查计划">
      <documentation>AGG-34 生效检查计划；B-26；in_system；检查计划.生效；检查计划页</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S3_5">
        <dataOutput id="DOut_S3_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_5_1"><sourceRef>DOut_S3_5_1</sourceRef><targetRef>SR_S3_5_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S4_6" name="P-28 到期提醒与逾期未委托提醒，读模型派生，不存状态">
      <documentation>P-28 到期提醒与逾期未委托提醒，读模型派生，不存状态；B-26；automatic</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S4_6">
        <dataInput id="DIn_S4_6_1"/>
        <inputSet><dataInputRefs>DIn_S4_6_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S4_6_1"><sourceRef>SR_S4_6_r1</sourceRef><targetRef>DIn_S4_6_1</targetRef></dataInputAssociation>
    </serviceTask>
    <boundaryEvent id="S4_6_bd_7" name="期限 P30D" cancelActivity="false" attachedToRef="S4_6">
      <outgoing>Flow_10</outgoing>
      <timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S4_6_esc_8" name="处理超时：P-28 到期提醒与逾期未委托提醒，读模型派生，不存状态">
      <documentation>升级给 SH-E4；期限 P30D</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S4_6_esc_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <exclusiveGateway id="S4_gw_9" name="P-28 到期提醒与逾期未委托提醒，读模型派生，不存状态？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <userTask id="S5_10" name="标记检查计划不再受托">
      <documentation>AGG-34 标记检查计划不再受托；B-26；in_system；检查计划.标记不再受托；检查计划页</documentation>
