        <flowNodeRef>S6_gw_14</flowNodeRef>
        <flowNodeRef>End_16</flowNodeRef>
        <flowNodeRef>S2_4_bd_5</flowNodeRef>
      </lane>
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
