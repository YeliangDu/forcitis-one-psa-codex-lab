  <process id="PRC-34" name="处置我方成果不符合项" isExecutable="false">
    <documentation>owner B-28；VS-02.2、VS-02.3、VS-02.4、VS-02.6、VS-02.7</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E3" name="设计师和顾问（SH-E3）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
      </lane>
      <lane id="Lane_SH-E4" name="技术专家（SH-E4）">
