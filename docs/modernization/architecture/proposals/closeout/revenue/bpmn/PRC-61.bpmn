        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S3_8_bd_9" name="期限 P5D" cancelActivity="false" attachedToRef="S3_8">
      <outgoing>Flow_16</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S3_8_esc_10" name="处理超时：坏账核销审批">
      <documentation>升级给 SH-M1；期限 P5D</documentation>
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <ioSpecification id="IO_S3_8_esc_10">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S3_api_11" name="发起坏账核销审批 → platform.approval">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S3_api_11">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S3_gw_12" name="坏账核销审批？">
