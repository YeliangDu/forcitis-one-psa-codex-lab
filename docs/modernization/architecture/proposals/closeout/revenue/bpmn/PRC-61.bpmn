        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S2_4_bd_5" name="期限 P30D" cancelActivity="false" attachedToRef="S2_4">
      <outgoing>Flow_8</outgoing>
      <timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_4_esc_6" name="处理超时：登记争议与处置分类">
      <documentation>升级给 SH-M1；期限 P30D</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_4_esc_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <exclusiveGateway id="S2_gw_7" name="登记争议与处置分类？">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <userTask id="S3_8" name="坏账核销审批">
      <documentation>坏账核销审批；B-09；in_system；应收.坏账核销审批；审批待办页；审批平台：坏账核销审批单</documentation>
