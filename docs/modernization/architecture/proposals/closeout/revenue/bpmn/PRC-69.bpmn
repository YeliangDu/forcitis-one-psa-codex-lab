    <startEvent id="Start_1" name="项目经理或职能提出新供方，申请往来单位角色">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="申请往来单位角色">
      <documentation>AGG-01 申请往来单位角色；B-01；in_system；往来单位角色.申请；往来单位角色申请页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S1_gw_3" name="申请往来单位角色？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <manualTask id="S2_manual_4" name="线下办理资质证书">
      <documentation>线下办理；证据：资质证书扫描件（类别、等级、有效期）；发证机关公开查询结果的截图或网页存档</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_manual_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S2_reg_5" name="登记资质证书">
      <documentation>AGG-02 登记资质证书；B-01；offline；资质证书.登记；资质证书登记页</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_reg_5">
