      <dataOutputAssociation id="DOA_S2_reg_5_2"><sourceRef>DOut_S2_reg_5_2</sourceRef><targetRef>OR_S2_reg_5_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_6" name="登记资质证书？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <userTask id="S3_7" name="核准往来单位角色合格">
