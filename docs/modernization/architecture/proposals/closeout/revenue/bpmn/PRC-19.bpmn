<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-19" targetNamespace="https://forcitis.one/bpmn/PRC-19" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="项目已建立"/>
  <dataStore id="DS_AGG-05" name="AGG-05"/>
  <dataStore id="DS_AGG-12" name="AGG-12"/>
  <dataStore id="DS_AGG-22" name="AGG-22"/>
  <collaboration id="Collab_PRC-19">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-19"/>
  </collaboration>
  <process id="PRC-19" name="编制并锁定项目预算" isExecutable="false">
    <documentation>owner B-04；VS-02.0</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S4_8</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S3_5</flowNodeRef>
        <flowNodeRef>S3_api_6</flowNodeRef>
        <flowNodeRef>S3_gw_7</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目已建立">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="预算被驳回或提交后撤回，项目经理修改并重新提交">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="读费率版本与赢单报价版本 → B-02、B-03">
      <documentation>读费率版本与赢单报价版本；B-04；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <dataInput id="DIn_S1_3_2"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs><dataInputRefs>DIn_S1_3_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_3_2"><sourceRef>SR_S1_3_r2</sourceRef><targetRef>DIn_S1_3_2</targetRef></dataInputAssociation>
    </serviceTask>
    <userTask id="S2_4" name="编制项目预算版本">
      <documentation>AGG-22 编制项目预算版本；B-04；in_system；项目预算.编制；项目预算编制页</documentation>
      <incoming>Flow_3</incoming>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <userTask id="S3_5" name="项目预算审批">
      <documentation>项目预算审批；B-04；in_system；项目预算.审批；审批待办页；审批平台：项目预算审批</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S3_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S3_api_6" name="项目预算审批 → platform.approval">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S3_api_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S3_gw_7" name="项目预算审批？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <userTask id="S4_8" name="锁定项目预算">
      <documentation>AGG-22 锁定项目预算；B-04；in_system；项目预算.锁定；项目预算锁定页</documentation>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S4_8">
        <dataOutput id="DOut_S4_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_8_1"><sourceRef>DOut_S4_8_1</sourceRef><targetRef>SR_S4_8_w1</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="End_9" name="已撤回">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_10" name="已锁定">
      <incoming>Flow_10</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S2_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S2_4" targetRef="S3_5"/>
    <sequenceFlow id="Flow_5" sourceRef="S3_5" targetRef="S3_api_6"/>
    <sequenceFlow id="Flow_6" sourceRef="S3_api_6" targetRef="S3_gw_7"/>
    <sequenceFlow id="Flow_7" name="审批通过" sourceRef="S3_gw_7" targetRef="S4_8"/>
    <sequenceFlow id="Flow_8" name="提交人已撤回审批" sourceRef="S3_gw_7" targetRef="End_9"/>
    <sequenceFlow id="Flow_9" name="其他" sourceRef="S3_gw_7" targetRef="S2_4"/>
    <sequenceFlow id="Flow_10" sourceRef="S4_8" targetRef="End_10"/>
    <dataStoreReference id="SR_S1_3_r1" name="AGG-05" dataStoreRef="DS_AGG-05"/>
    <dataStoreReference id="SR_S1_3_r2" name="AGG-12" dataStoreRef="DS_AGG-12"/>
    <dataStoreReference id="SR_S2_4_w1" name="AGG-22" dataStoreRef="DS_AGG-22"/>
    <dataStoreReference id="SR_S4_8_w1" name="AGG-22" dataStoreRef="DS_AGG-22"/>
  </process>
