<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-179" targetNamespace="https://forcitis.one/bpmn/PRC-179" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="项目已开始执行"/>
  <signal id="Signal_2" name="合同—项目关联已登记"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <collaboration id="Collab_PRC-179">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-179"/>
  </collaboration>
  <process id="PRC-179" name="项目开始执行后协议转入履行中" isExecutable="false">
    <documentation>owner B-05；VS-04.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S1_gw_4</flowNodeRef>
        <flowNodeRef>End_5</flowNodeRef>
        <flowNodeRef>End_6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目已开始执行">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="合同—项目关联已登记">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <serviceTask id="S1_3" name="开始履行协议 → B-04">
      <documentation>AGG-13 开始履行协议；B-05；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataOutput id="DOut_S1_3_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>SR_S1_3_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="开始履行协议？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <endEvent id="End_5" name="无需处理">
      <incoming>Flow_4</incoming>
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_6" name="协议已转入履行中">
      <incoming>Flow_6</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S1_gw_4"/>
    <sequenceFlow id="Flow_4" name="该项目未关联已生效的协议，或（关联登记触发时）关联项目尚未开始执行" sourceRef="S1_gw_4" targetRef="End_5"/>
    <sequenceFlow id="Flow_5" name="关联协议已在履行中或之后状态" sourceRef="S1_gw_4" targetRef="End_5"/>
    <sequenceFlow id="Flow_6" name="其他" sourceRef="S1_gw_4" targetRef="End_6"/>
    <dataStoreReference id="SR_S1_3_w1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-179">
    <bpmndi:BPMNPlane id="Plane_PRC-179" bpmnElement="Collab_PRC-179">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="710" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_system" bpmnElement="Lane_system" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="680" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_2" bpmnElement="Start_2">
        <dc:Bounds x="177" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_3" bpmnElement="S1_3">
        <dc:Bounds x="275" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_gw_4" bpmnElement="S1_gw_4" isMarkerVisible="true">
        <dc:Bounds x="430" y="40" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="410" y="6" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_5" bpmnElement="End_5">
        <dc:Bounds x="527" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_6" bpmnElement="End_6">
        <dc:Bounds x="617" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_3_w1" bpmnElement="SR_S1_3_w1">
        <dc:Bounds x="307" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="105" y="83"/>
        <di:waypoint x="105" y="124"/>
        <di:waypoint x="325" y="124"/>
        <di:waypoint x="325" y="95"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="213" y="65"/>
        <di:waypoint x="275" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="375" y="65"/>
        <di:waypoint x="430" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="480" y="65"/>
        <di:waypoint x="527" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="480" y="65"/>
        <di:waypoint x="527" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="455" y="90"/>
        <di:waypoint x="455" y="119"/>
        <di:waypoint x="635" y="119"/>
        <di:waypoint x="635" y="83"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S1_3_1" bpmnElement="DOA_S1_3_1">
        <di:waypoint x="325" y="35"/>
        <di:waypoint x="325" y="30"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
