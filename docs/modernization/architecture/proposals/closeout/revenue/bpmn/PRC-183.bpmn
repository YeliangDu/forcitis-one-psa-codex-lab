        <flowNodeRef>S3_api_6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="商机负责人在跟进中的商机上作参投决策">
      <outgoing>Flow_1</outgoing>
    </startEvent>
