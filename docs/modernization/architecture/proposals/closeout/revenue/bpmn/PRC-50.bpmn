<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-50" targetNamespace="https://forcitis.one/bpmn/PRC-50" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-14" name="AGG-14"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <collaboration id="Collab_PRC-50">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-50"/>
  </collaboration>
  <process id="PRC-50" name="占用框架限额并提交任务订单" isExecutable="false">
    <documentation>owner B-05；VS-04.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E5" name="市场和客户经理（SH-E5）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_3</flowNodeRef>
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S2_4_esc_6</flowNodeRef>
        <flowNodeRef>S2_gw_8</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>S2_4_bd_5</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S2_api_7</flowNodeRef>
        <flowNodeRef>S3_9</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="商务按框架协议起草任务订单">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="占用框架限额">
      <documentation>AGG-14 占用框架限额；B-05；in_system；框架限额.占用；任务订单起草页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S1_gw_3" name="占用框架限额？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
    </exclusiveGateway>
    <userTask id="S2_4" name="提交任务订单">
      <documentation>AGG-13 提交任务订单；B-05；in_system；任务订单.提交；任务订单提交页；审批平台：任务订单审批单</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S2_4_bd_5" name="期限 占用有效期（配置，待用户定）" cancelActivity="true" attachedToRef="S2_4">
      <outgoing>Flow_10</outgoing>
      <timerEventDefinition><timeDuration>占用有效期（配置，待用户定）</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_4_esc_6" name="处理超时：提交任务订单">
      <documentation>升级给 SH-E5；期限 占用有效期（配置，待用户定）</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S2_4_esc_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S2_api_7" name="发起任务订单审批 → platform.approval">
      <incoming>Flow_5</incoming>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_api_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_8" name="提交任务订单？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_9" name="释放框架限额">
      <documentation>AGG-14 释放框架限额；B-05；automatic</documentation>
      <incoming>Flow_8</incoming>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S3_9">
        <dataOutput id="DOut_S3_9_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_9_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_9_1"><sourceRef>DOut_S3_9_1</sourceRef><targetRef>SR_S3_9_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_10" name="占用被拒">
      <incoming>Flow_3</incoming>
    </endEvent>
    <endEvent id="End_11" name="任务订单已生效">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_12" name="限额已释放">
      <incoming>Flow_12</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_3"/>
    <sequenceFlow id="Flow_3" name="占用被拒" sourceRef="S1_gw_3" targetRef="End_10"/>
    <sequenceFlow id="Flow_4" name="其他" sourceRef="S1_gw_3" targetRef="S2_4"/>
    <sequenceFlow id="Flow_5" sourceRef="S2_4" targetRef="S2_api_7"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_api_7" targetRef="S2_gw_8"/>
    <sequenceFlow id="Flow_7" name="审批通过" sourceRef="S2_gw_8" targetRef="End_11"/>
    <sequenceFlow id="Flow_8" name="提交人撤回订单" sourceRef="S2_gw_8" targetRef="S3_9"/>
    <sequenceFlow id="Flow_9" name="其他" sourceRef="S2_gw_8" targetRef="S3_9"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_4_bd_5" targetRef="S2_4_esc_6"/>
    <sequenceFlow id="Flow_11" sourceRef="S2_4_esc_6" targetRef="S2_api_7"/>
    <sequenceFlow id="Flow_12" sourceRef="S3_9" targetRef="End_12"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-14" dataStoreRef="DS_AGG-14"/>
    <dataStoreReference id="SR_S2_4_w1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
    <dataStoreReference id="SR_S3_9_w1" name="AGG-14" dataStoreRef="DS_AGG-14"/>
  </process>
