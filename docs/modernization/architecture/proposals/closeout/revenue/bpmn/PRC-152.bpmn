<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-152" targetNamespace="https://forcitis.one/bpmn/PRC-152" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="付款条件项已可结算"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <collaboration id="Collab_PRC-152">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-152"/>
  </collaboration>
  <process id="PRC-152" name="登记付款条件项达成" isExecutable="false">
    <documentation>owner B-05；VS-04.3</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E5" name="市场和客户经理（SH-E5）">
        <flowNodeRef>S2_manual_6</flowNodeRef>
        <flowNodeRef>S2_reg_7</flowNodeRef>
        <flowNodeRef>S2_gw_8</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>Start_3</flowNodeRef>
        <flowNodeRef>S1_4</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>S3_9</flowNodeRef>
        <flowNodeRef>S3_evt_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="商务登记非成果认可型付款条件达成（附外部证据）">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="时间型付款节点到期日（按月、按季度）">
      <outgoing>Flow_2</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <startEvent id="Start_3" name="缺陷责任期届满日（质保金到期返还）">
      <outgoing>Flow_3</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <serviceTask id="S1_4" name="读付款条件项 → B-05">
      <documentation>读付款条件项；B-05；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_4">
        <dataInput id="DIn_S1_4_1"/>
        <inputSet><dataInputRefs>DIn_S1_4_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_4_1"><sourceRef>SR_S1_4_r1</sourceRef><targetRef>DIn_S1_4_1</targetRef></dataInputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_5" name="读付款条件项？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <manualTask id="S2_manual_6" name="线下办理付款条件达成">
      <documentation>线下办理；证据：与条件类型对应的外部证据：施工图审查合格书、工程竣工验收证书、结算审定书、缺陷责任期终止证书，或双方签认的条件达成确认单；达成日与证据出具方</documentation>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S2_manual_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S2_reg_7" name="登记付款条件达成">
      <documentation>AGG-13 登记付款条件达成；B-05；offline；付款条件.登记达成；付款条件达成登记页</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_reg_7">
        <dataOutput id="DOut_S2_reg_7_1"/>
        <dataOutput id="DOut_S2_reg_7_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_reg_7_1</dataOutputRefs><dataOutputRefs>DOut_S2_reg_7_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_reg_7_1"><sourceRef>DOut_S2_reg_7_1</sourceRef><targetRef>SR_S2_reg_7_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S2_reg_7_2"><sourceRef>DOut_S2_reg_7_2</sourceRef><targetRef>OR_S2_reg_7_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_8" name="登记付款条件达成？">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_9" name="标记付款条件项可结算">
      <documentation>AGG-13 标记付款条件项可结算；B-05；automatic</documentation>
      <incoming>Flow_6</incoming>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S3_9">
        <dataOutput id="DOut_S3_9_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_9_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_9_1"><sourceRef>DOut_S3_9_1</sourceRef><targetRef>SR_S3_9_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <intermediateThrowEvent id="S3_evt_10" name="付款条件项已可结算">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </intermediateThrowEvent>
    <endEvent id="End_11" name="条件已是可结算">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_12" name="登记被拒">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_13" name="条件已达成并可结算">
      <incoming>Flow_13</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_4"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_4"/>
    <sequenceFlow id="Flow_3" sourceRef="Start_3" targetRef="S1_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_4" targetRef="S1_gw_5"/>
    <sequenceFlow id="Flow_5" name="付款条件项已是可结算" sourceRef="S1_gw_5" targetRef="End_11"/>
    <sequenceFlow id="Flow_6" name="时间型节点到期日已届" sourceRef="S1_gw_5" targetRef="S3_9"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S1_gw_5" targetRef="S2_manual_6"/>
    <sequenceFlow id="Flow_8" sourceRef="S2_manual_6" targetRef="S2_reg_7"/>
    <sequenceFlow id="Flow_9" sourceRef="S2_reg_7" targetRef="S2_gw_8"/>
    <sequenceFlow id="Flow_10" name="证据缺失，或证据类型与条件类型不符" sourceRef="S2_gw_8" targetRef="End_12"/>
    <sequenceFlow id="Flow_11" name="其他" sourceRef="S2_gw_8" targetRef="S3_9"/>
    <sequenceFlow id="Flow_12" sourceRef="S3_9" targetRef="S3_evt_10"/>
    <sequenceFlow id="Flow_13" sourceRef="S3_evt_10" targetRef="End_13"/>
    <dataStoreReference id="SR_S1_4_r1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
    <dataStoreReference id="SR_S2_reg_7_w1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
    <dataObject id="DObj_OR_S2_reg_7_1"/>
    <dataObjectReference id="OR_S2_reg_7_1" name="与条件类型对应的外部证据" dataObjectRef="DObj_OR_S2_reg_7_1"/>
    <dataStoreReference id="SR_S3_9_w1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
    <textAnnotation id="Ann_1"><text>对方 BC：B-08</text></textAnnotation>
    <association id="Assoc_Ann_1" sourceRef="S3_evt_10" targetRef="Ann_1" associationDirection="None"/>
  </process>
