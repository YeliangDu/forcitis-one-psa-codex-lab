<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-59" targetNamespace="https://forcitis.one/bpmn/PRC-59" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="InvoiceIssued"/>
  <dataStore id="DS_AGG-49" name="AGG-49"/>
  <collaboration id="Collab_PRC-59">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-59"/>
  </collaboration>
  <process id="PRC-59" name="创建应收款项" isExecutable="false">
    <documentation>owner B-09；VS-04.4</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>End_3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="InvoiceIssued">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <serviceTask id="S1_2" name="创建应收 → B-01">
      <documentation>AGG-49 创建应收；B-09；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_3" name="已完成">
      <incoming>Flow_2</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="End_3"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-49" dataStoreRef="DS_AGG-49"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-59">
