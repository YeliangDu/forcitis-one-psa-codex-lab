      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_6" bpmnElement="S2_6">
        <dc:Bounds x="695" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_gw_7" bpmnElement="S2_gw_7" isMarkerVisible="true">
        <dc:Bounds x="850" y="170" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="830" y="136" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_8" bpmnElement="End_8">
        <dc:Bounds x="947" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_9" bpmnElement="End_9">
        <dc:Bounds x="1037" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_reg_5_r1" bpmnElement="SR_S1_reg_5_r1">
        <dc:Bounds x="536" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OR_S1_reg_5_1" bpmnElement="OR_S1_reg_5_1">
        <dc:Bounds x="578" y="4" width="26" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_6_w1" bpmnElement="SR_S2_6_w1">
        <dc:Bounds x="727" y="134" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="123" y="65"/>
        <di:waypoint x="185" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="65"/>
        <di:waypoint x="525" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="625" y="65"/>
        <di:waypoint x="675" y="65"/>
        <di:waypoint x="675" y="195"/>
        <di:waypoint x="695" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="260" y="113"/>
        <di:waypoint x="260" y="195"/>
        <di:waypoint x="355" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="405" y="225"/>
        <di:waypoint x="405" y="254"/>
        <di:waypoint x="965" y="254"/>
