      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SH-E6" bpmnElement="Lane_SH-E6" isHorizontal="true">
        <dc:Bounds x="30" y="130" width="1100" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_manual_2" bpmnElement="S1_manual_2">
        <dc:Bounds x="185" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_manual_2_bd_3" bpmnElement="S1_manual_2_bd_3">
        <dc:Bounds x="242" y="77" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_manual_2_esc_4" bpmnElement="S1_manual_2_esc_4">
        <dc:Bounds x="355" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_reg_5" bpmnElement="S1_reg_5">
