<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-141" targetNamespace="https://forcitis.one/bpmn/PRC-141" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="ContractSigned"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <collaboration id="Collab_PRC-141">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-141"/>
  </collaboration>
  <process id="PRC-141" name="归档协议" isExecutable="false">
    <documentation>owner B-05；</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_manual_2</flowNodeRef>
        <flowNodeRef>S1_reg_5</flowNodeRef>
        <flowNodeRef>S1_manual_2_bd_3</flowNodeRef>
      </lane>
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S1_manual_2_esc_4</flowNodeRef>
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="ContractSigned">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <manualTask id="S1_manual_2" name="线下办理项目经理或商务把回签原件移交档案管理人">
      <documentation>线下办理；证据：原件移交单（移交人、接收人、移交日期）</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_manual_2">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <boundaryEvent id="S1_manual_2_bd_3" name="期限 P30D" cancelActivity="false" attachedToRef="S1_manual_2">
      <outgoing>Flow_4</outgoing>
      <timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_manual_2_esc_4" name="处理超时：项目经理或商务把回签原件移交档案管理人">
      <documentation>升级给 SH-E6；期限 P30D</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S1_manual_2_esc_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <userTask id="S1_reg_5" name="登记项目经理或商务把回签原件移交档案管理人">
      <documentation>项目经理或商务把回签原件移交档案管理人；B-05；offline</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_reg_5">
        <dataInput id="DIn_S1_reg_5_1"/>
        <dataOutput id="DOut_S1_reg_5_1"/>
        <inputSet><dataInputRefs>DIn_S1_reg_5_1</dataInputRefs></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_reg_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_reg_5_1"><sourceRef>SR_S1_reg_5_r1</sourceRef><targetRef>DIn_S1_reg_5_1</targetRef></dataInputAssociation>
      <dataOutputAssociation id="DOA_S1_reg_5_1"><sourceRef>DOut_S1_reg_5_1</sourceRef><targetRef>OR_S1_reg_5_1</targetRef></dataOutputAssociation>
    </userTask>
    <userTask id="S2_6" name="归档协议">
      <documentation>AGG-13 归档协议；B-05；in_system；协议.归档；协议归档登记页</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataOutput id="DOut_S2_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_6_1"><sourceRef>DOut_S2_6_1</sourceRef><targetRef>SR_S2_6_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_7" name="归档协议？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <endEvent id="End_8" name="已提醒">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_9" name="已归档">
      <incoming>Flow_8</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_manual_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_manual_2" targetRef="S1_reg_5"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_reg_5" targetRef="S2_6"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_manual_2_bd_3" targetRef="S1_manual_2_esc_4"/>
    <sequenceFlow id="Flow_5" sourceRef="S1_manual_2_esc_4" targetRef="End_8"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_6" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_7" name="原件份数或签章不全" sourceRef="S2_gw_7" targetRef="S1_manual_2"/>
    <sequenceFlow id="Flow_8" name="其他" sourceRef="S2_gw_7" targetRef="End_9"/>
    <dataStoreReference id="SR_S1_reg_5_r1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
    <dataObject id="DObj_OR_S1_reg_5_1"/>
    <dataObjectReference id="OR_S1_reg_5_1" name="原件移交单" dataObjectRef="DObj_OR_S1_reg_5_1"/>
    <dataStoreReference id="SR_S2_6_w1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-141">
    <bpmndi:BPMNPlane id="Plane_PRC-141" bpmnElement="Collab_PRC-141">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1130" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SH-E2" bpmnElement="Lane_SH-E2" isHorizontal="true">
