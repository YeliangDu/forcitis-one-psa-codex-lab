        <dc:Bounds x="196" y="264" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_2_r2" bpmnElement="SR_S1_2_r2">
        <dc:Bounds x="238" y="264" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_5_w1" bpmnElement="SR_S2_5_w1">
        <dc:Bounds x="557" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="123" y="325"/>
        <di:waypoint x="185" y="325"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="325"/>
        <di:waypoint x="505" y="325"/>
        <di:waypoint x="505" y="65"/>
        <di:waypoint x="525" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="260" y="373"/>
        <di:waypoint x="260" y="384"/>
        <di:waypoint x="405" y="384"/>
        <di:waypoint x="405" y="225"/>
      </bpmndi:BPMNEdge>
