        <bpmndi:BPMNLabel><dc:Bounds x="660" y="6" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_7" bpmnElement="End_7">
