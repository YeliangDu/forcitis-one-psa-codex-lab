<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-91" targetNamespace="https://forcitis.one/bpmn/PRC-91" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="TimesheetApproved"/>
  <dataStore id="DS_AGG-39" name="AGG-39"/>
  <dataStore id="DS_AGG-29" name="AGG-29"/>
  <collaboration id="Collab_PRC-91">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-91"/>
  </collaboration>
  <process id="PRC-91" name="认定工时单有效性" isExecutable="false">
    <documentation>owner B-06；</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_gw_6</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S1_2_esc_4</flowNodeRef>
        <flowNodeRef>End_7</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_2_bd_3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="TimesheetApproved">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <serviceTask id="S1_2" name="工时单通过后按条目生成待认定清单，读返工认定、返工条目预置为「返工」 → B-28、B-16">
      <documentation>工时单通过后按条目生成待认定清单，读返工认定、返工条目预置为「返工」；B-06；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataInput id="DIn_S1_2_1"/>
        <dataInput id="DIn_S1_2_2"/>
        <inputSet><dataInputRefs>DIn_S1_2_1</dataInputRefs><dataInputRefs>DIn_S1_2_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_2_1"><sourceRef>SR_S1_2_r1</sourceRef><targetRef>DIn_S1_2_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_2_2"><sourceRef>SR_S1_2_r2</sourceRef><targetRef>DIn_S1_2_2</targetRef></dataInputAssociation>
    </serviceTask>
    <boundaryEvent id="S1_2_bd_3" name="期限 期间封期前提醒（提前量建议 3 个工作日，待用户定）" cancelActivity="false" attachedToRef="S1_2">
      <outgoing>Flow_3</outgoing>
      <timerEventDefinition><timeDuration>期间封期前提醒（提前量建议 3 个工作日，待用户定）</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_2_esc_4" name="处理超时：工时单通过后按条目生成待认定清单，读返工认定、返工条目预置为「返工」">
      <documentation>升级给 SH-M1；期限 期间封期前提醒（提前量建议 3 个工作日，待用户定）</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_2_esc_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <userTask id="S2_5" name="认定工时有效性">
      <documentation>AGG-39 认定工时有效性；B-06；in_system；工时.认定有效性；工时认定页</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_6" name="认定工时有效性？">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <endEvent id="End_7" name="已提醒">
      <incoming>Flow_4</incoming>
    </endEvent>
    <endEvent id="End_8" name="未认定">
      <incoming>Flow_6</incoming>
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_9" name="已认定">
      <incoming>Flow_8</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S2_5"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_2_bd_3" targetRef="S1_2_esc_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_2_esc_4" targetRef="End_7"/>
    <sequenceFlow id="Flow_5" sourceRef="S2_5" targetRef="S2_gw_6"/>
    <sequenceFlow id="Flow_6" name="目标期间已关账（提示改走冲销或修正，人工认定不设审批）" sourceRef="S2_gw_6" targetRef="End_8"/>
    <sequenceFlow id="Flow_7" name="四类之和不等于填报总数" sourceRef="S2_gw_6" targetRef="End_8"/>
    <sequenceFlow id="Flow_8" name="其他" sourceRef="S2_gw_6" targetRef="End_9"/>
    <dataStoreReference id="SR_S1_2_r1" name="AGG-39" dataStoreRef="DS_AGG-39"/>
    <dataStoreReference id="SR_S1_2_r2" name="AGG-29" dataStoreRef="DS_AGG-29"/>
    <dataStoreReference id="SR_S2_5_w1" name="AGG-39" dataStoreRef="DS_AGG-39"/>
  </process>
