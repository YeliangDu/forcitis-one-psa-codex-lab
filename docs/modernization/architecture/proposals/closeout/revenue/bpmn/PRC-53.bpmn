<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-53" targetNamespace="https://forcitis.one/bpmn/PRC-53" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="交付物已认可"/>
  <signal id="Signal_2" name="视为同意已成立（PRC-54 认定，同 BC）"/>
  <dataStore id="DS_AGG-92" name="AGG-92"/>
  <dataStore id="DS_AGG-44" name="AGG-44"/>
  <collaboration id="Collab_PRC-53">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-53"/>
  </collaboration>
  <process id="PRC-53" name="确认收入" isExecutable="false">
    <documentation>owner B-08；VS-04.2</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S2_5_esc_7</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S1_gw_4</flowNodeRef>
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_api_8</flowNodeRef>
        <flowNodeRef>S2_gw_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>S2_5_bd_6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="交付物已认可">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="视为同意已成立（PRC-54 认定，同 BC）">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <serviceTask id="S1_3" name="占用收入额度 → B-05、B-28、B-13">
      <documentation>AGG-44 占用收入额度；B-08；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <dataOutput id="DOut_S1_3_1"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>SR_S1_3_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="占用收入额度？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <userTask id="S2_5" name="收入确认审批">
      <documentation>收入确认审批；B-08；in_system；收入确认.审批；审批待办页；审批平台：收入确认审批</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S2_5_bd_6" name="期限 P5D" cancelActivity="false" attachedToRef="S2_5">
      <outgoing>Flow_10</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_5_esc_7" name="处理超时：收入确认审批">
      <documentation>升级给 SH-M1；期限 P5D</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S2_5_esc_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S2_api_8" name="发起收入确认审批 → platform.approval">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_api_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_9" name="收入确认审批？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <endEvent id="End_10" name="占用被拒">
      <incoming>Flow_4</incoming>
    </endEvent>
    <endEvent id="End_11" name="已转 PRC-148">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_12" name="已驳回">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_13" name="已提醒">
      <incoming>Flow_11</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S1_gw_4"/>
    <sequenceFlow id="Flow_4" name="证据类型未开放、证据不全，或额度不足" sourceRef="S1_gw_4" targetRef="End_10"/>
    <sequenceFlow id="Flow_5" name="其他" sourceRef="S1_gw_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_5" targetRef="S2_api_8"/>
    <sequenceFlow id="Flow_7" sourceRef="S2_api_8" targetRef="S2_gw_9"/>
    <sequenceFlow id="Flow_8" name="通过" sourceRef="S2_gw_9" targetRef="End_11"/>
    <sequenceFlow id="Flow_9" name="驳回" sourceRef="S2_gw_9" targetRef="End_12"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_5_bd_6" targetRef="S2_5_esc_7"/>
    <sequenceFlow id="Flow_11" sourceRef="S2_5_esc_7" targetRef="End_13"/>
    <dataStoreReference id="SR_S1_3_w1" name="AGG-44" dataStoreRef="DS_AGG-44"/>
    <dataStoreReference id="SR_S1_3_r1" name="AGG-92" dataStoreRef="DS_AGG-92"/>
    <textAnnotation id="Ann_1"><text>转 PRC-148</text></textAnnotation>
    <association id="Assoc_Ann_1" sourceRef="End_11" targetRef="Ann_1" associationDirection="None"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-53">
    <bpmndi:BPMNPlane id="Plane_PRC-53" bpmnElement="Collab_PRC-53">
