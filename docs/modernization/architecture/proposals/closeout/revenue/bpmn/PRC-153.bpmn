  <signal id="Signal_1" name="投标未中标"/>
  <signal id="Signal_2" name="投标已废标"/>
  <signal id="Signal_3" name="投标已撤销"/>
  <dataStore id="DS_AGG-51" name="AGG-51"/>
  <dataStore id="DS_AGG-11" name="AGG-11"/>
  <dataStore id="DS_AGG-88" name="AGG-88"/>
  <collaboration id="Collab_PRC-153">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-153"/>
    <participant id="Pool_1" name="银行"/>
    <messageFlow id="Msg_1" name="等待招标人退款到账" sourceRef="S2_6" targetRef="Pool_1"/>
    <messageFlow id="Msg_2" name="银行返回结果" sourceRef="Pool_1" targetRef="S2_recv_9"/>
  </collaboration>
  <process id="PRC-153" name="退还投标保证金" isExecutable="false">
    <documentation>owner B-09；VS-01.2、VS-04.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_recv_9</flowNodeRef>
        <flowNodeRef>S2_gw_10</flowNodeRef>
        <flowNodeRef>S4_14</flowNodeRef>
        <flowNodeRef>S2_6_bd_7</flowNodeRef>
      </lane>
      <lane id="Lane_SH-E5" name="市场和客户经理（SH-E5）">
        <flowNodeRef>S3_manual_11</flowNodeRef>
        <flowNodeRef>S3_reg_12</flowNodeRef>
        <flowNodeRef>S3_gw_13</flowNodeRef>
        <flowNodeRef>End_19</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S2_6_esc_8</flowNodeRef>
        <flowNodeRef>End_18</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>Start_3</flowNodeRef>
        <flowNodeRef>S1_4</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>S5_15</flowNodeRef>
        <flowNodeRef>S5_gw_16</flowNodeRef>
        <flowNodeRef>End_17</flowNodeRef>
        <flowNodeRef>End_20</flowNodeRef>
        <flowNodeRef>End_21</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="投标未中标">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="投标已废标">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <startEvent id="Start_3" name="投标已撤销">
      <outgoing>Flow_3</outgoing>
      <signalEventDefinition signalRef="Signal_3"/>
    </startEvent>
    <serviceTask id="S1_4" name="订阅 PRC-08 发出的投标未中标、已废标、已撤销 → B-03">
      <documentation>订阅 PRC-08 发出的投标未中标、已废标、已撤销；B-09；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_4">
        <dataInput id="DIn_S1_4_1"/>
        <dataInput id="DIn_S1_4_2"/>
        <inputSet><dataInputRefs>DIn_S1_4_1</dataInputRefs><dataInputRefs>DIn_S1_4_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_4_1"><sourceRef>SR_S1_4_r1</sourceRef><targetRef>DIn_S1_4_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_4_2"><sourceRef>SR_S1_4_r2</sourceRef><targetRef>DIn_S1_4_2</targetRef></dataInputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_5" name="订阅 PRC-08 发出的投标未中标、已废标、已撤销？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <sendTask id="S2_6" name="等待招标人退款到账 → B-22">
      <documentation>等待招标人退款到账；B-09；external:银行</documentation>
      <incoming>Flow_6</incoming>
      <incoming>Flow_16</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataInput id="DIn_S2_6_1"/>
        <dataOutput id="DOut_S2_6_1"/>
        <inputSet><dataInputRefs>DIn_S2_6_1</dataInputRefs></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S2_6_1"><sourceRef>SR_S2_6_r1</sourceRef><targetRef>DIn_S2_6_1</targetRef></dataInputAssociation>
      <dataOutputAssociation id="DOA_S2_6_1"><sourceRef>DOut_S2_6_1</sourceRef><targetRef>OR_S2_6_1</targetRef></dataOutputAssociation>
    </sendTask>
    <boundaryEvent id="S2_6_bd_7" name="期限 P5D" cancelActivity="false" attachedToRef="S2_6">
      <outgoing>Flow_11</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_6_esc_8" name="处理超时：等待招标人退款到账">
      <documentation>升级给 SH-M1；期限 P5D</documentation>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S2_6_esc_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <intermediateCatchEvent id="S2_recv_9" name="银行返回结果">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <exclusiveGateway id="S2_gw_10" name="等待招标人退款到账？">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <manualTask id="S3_manual_11" name="线下办理商务向招标人催退">
      <documentation>线下办理；证据：催退函或沟通记录；招标人答复（退还时间或不予退还的理由）</documentation>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_13</outgoing>
      <ioSpecification id="IO_S3_manual_11">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S3_reg_12" name="登记商务向招标人催退">
      <documentation>商务向招标人催退；B-09；offline</documentation>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <ioSpecification id="IO_S3_reg_12">
        <dataOutput id="DOut_S3_reg_12_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_reg_12_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_reg_12_1"><sourceRef>DOut_S3_reg_12_1</sourceRef><targetRef>OR_S3_reg_12_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_13" name="商务向招标人催退？">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
      <outgoing>Flow_16</outgoing>
    </exclusiveGateway>
    <userTask id="S4_14" name="退还保证金">
      <documentation>AGG-51 退还保证金；B-09；in_system；保证金.登记退还；保证金退还登记页</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_17</outgoing>
      <ioSpecification id="IO_S4_14">
        <dataOutput id="DOut_S4_14_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_14_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_14_1"><sourceRef>DOut_S4_14_1</sourceRef><targetRef>SR_S4_14_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S5_15" name="提交过账候选 → B-16">
      <documentation>AGG-51 提交过账候选；B-09；automatic；调用 PRC-92</documentation>
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
      <ioSpecification id="IO_S5_15">
        <dataOutput id="DOut_S5_15_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_15_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_15_1"><sourceRef>DOut_S5_15_1</sourceRef><targetRef>SR_S5_15_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S5_gw_16" name="提交过账候选？">
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
      <outgoing>Flow_20</outgoing>
    </exclusiveGateway>
    <endEvent id="End_17" name="退还被拒">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_18" name="已提醒">
      <incoming>Flow_12</incoming>
    </endEvent>
    <endEvent id="End_19" name="转没收登记">
      <incoming>Flow_15</incoming>
    </endEvent>
    <endEvent id="End_20" name="暂挂待跨年处理">
      <incoming>Flow_19</incoming>
    </endEvent>
    <endEvent id="End_21" name="保证金已退">
      <incoming>Flow_20</incoming>
    </endEvent>
