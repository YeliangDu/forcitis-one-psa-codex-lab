<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-18" targetNamespace="https://forcitis.one/bpmn/PRC-18" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="项目已建立"/>
  <dataStore id="DS_AGG-21" name="AGG-21"/>
  <collaboration id="Collab_PRC-18">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-18"/>
    <participant id="Pool_1" name="客户·客户决策链·发起人（SH-C6a）"/>
    <messageFlow id="Msg_1" name="交付计划发包人批准" sourceRef="Pool_1" targetRef="S2_reg_7"/>
  </collaboration>
  <process id="PRC-18" name="编制并批准交付计划" isExecutable="false">
    <documentation>owner B-04；VS-02.0</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_3</flowNodeRef>
        <flowNodeRef>S2_manual_4</flowNodeRef>
        <flowNodeRef>S2_manual_4_esc_6</flowNodeRef>
        <flowNodeRef>S2_reg_7</flowNodeRef>
        <flowNodeRef>S2_gw_8</flowNodeRef>
        <flowNodeRef>S3_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>S2_manual_4_bd_5</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目已建立">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <userTask id="S1_2" name="编制交付计划版本">
      <documentation>AGG-21 编制交付计划版本；B-04；in_system；交付计划.编制；交付计划编制页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S1_gw_3" name="编制交付计划版本？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
    </exclusiveGateway>
    <manualTask id="S2_manual_4" name="线下办理批准交付计划">
      <documentation>线下办理；证据：发包人书面批准材料（签认单、会议纪要签字页、邮件原始报文之一）；批准日与批准人（须为合同登记的发包人代表或授权人）</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S2_manual_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <boundaryEvent id="S2_manual_4_bd_5" name="期限 P5D" cancelActivity="false" attachedToRef="S2_manual_4">
      <outgoing>Flow_9</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_manual_4_esc_6" name="处理超时：批准交付计划">
      <documentation>升级给 SH-E2；期限 P5D</documentation>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_manual_4_esc_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <userTask id="S2_reg_7" name="登记批准交付计划">
      <documentation>AGG-21 批准交付计划；B-04；offline；交付计划.登记批准；交付计划批准登记页；审批（external）：交付计划发包人批准；调用 PRC-33</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_reg_7">
        <dataOutput id="DOut_S2_reg_7_1"/>
        <dataOutput id="DOut_S2_reg_7_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_reg_7_1</dataOutputRefs><dataOutputRefs>DOut_S2_reg_7_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_reg_7_1"><sourceRef>DOut_S2_reg_7_1</sourceRef><targetRef>SR_S2_reg_7_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S2_reg_7_2"><sourceRef>DOut_S2_reg_7_2</sourceRef><targetRef>OR_S2_reg_7_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_8" name="批准交付计划？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <userTask id="S3_9" name="批准交付计划">
      <documentation>AGG-21 批准交付计划；B-04；in_system；交付计划.锁定；交付计划锁定页</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S3_9">
        <dataOutput id="DOut_S3_9_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_9_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_9_1"><sourceRef>DOut_S3_9_1</sourceRef><targetRef>SR_S3_9_w1</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="End_10" name="已批准（对客）">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_11" name="已提醒">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_12" name="内部锁定">
      <incoming>Flow_11</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_3"/>
    <sequenceFlow id="Flow_3" name="本版本是对客基线（需发包人批准）" sourceRef="S1_gw_3" targetRef="S2_manual_4"/>
    <sequenceFlow id="Flow_4" name="其他" sourceRef="S1_gw_3" targetRef="S3_9"/>
    <sequenceFlow id="Flow_5" sourceRef="S2_manual_4" targetRef="S2_reg_7"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_reg_7" targetRef="S2_gw_8"/>
    <sequenceFlow id="Flow_7" name="发包人书面提出修改意见" sourceRef="S2_gw_8" targetRef="S1_2"/>
    <sequenceFlow id="Flow_8" name="其他" sourceRef="S2_gw_8" targetRef="End_10"/>
    <sequenceFlow id="Flow_9" sourceRef="S2_manual_4_bd_5" targetRef="S2_manual_4_esc_6"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_manual_4_esc_6" targetRef="End_11"/>
    <sequenceFlow id="Flow_11" sourceRef="S3_9" targetRef="End_12"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-21" dataStoreRef="DS_AGG-21"/>
    <dataStoreReference id="SR_S2_reg_7_w1" name="AGG-21" dataStoreRef="DS_AGG-21"/>
    <dataObject id="DObj_OR_S2_reg_7_1"/>
    <dataObjectReference id="OR_S2_reg_7_1" name="发包人书面批准材料" dataObjectRef="DObj_OR_S2_reg_7_1"/>
    <dataStoreReference id="SR_S3_9_w1" name="AGG-21" dataStoreRef="DS_AGG-21"/>
  </process>
