    <startEvent id="Start_1" name="项目收尾，项目经理发出满意度调查">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <manualTask id="S1_manual_2" name="线下办理发出满意度调查">
      <documentation>线下办理；证据：调查发出记录：问卷发送邮件原始报文或回访通话记录；发出日与调查对象联系人</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_manual_2">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <boundaryEvent id="S1_manual_2_bd_3" name="期限 建议 P14D 未回收提醒（建议值，待用户定）" cancelActivity="false" attachedToRef="S1_manual_2">
      <outgoing>Flow_6</outgoing>
      <timerEventDefinition><timeDuration>建议 P14D 未回收提醒（建议值，待用户定）</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_manual_2_esc_4" name="处理超时：发出满意度调查">
