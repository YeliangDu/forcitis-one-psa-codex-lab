      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_4" bpmnElement="S2_4">
        <dc:Bounds x="445" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S3_5" bpmnElement="S3_5">
        <dc:Bounds x="615" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S3_gw_6" bpmnElement="S3_gw_6" isMarkerVisible="true">
        <dc:Bounds x="770" y="40" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="750" y="6" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_7" bpmnElement="End_7">
        <dc:Bounds x="867" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_8" bpmnElement="End_8">
        <dc:Bounds x="957" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_9" bpmnElement="End_9">
        <dc:Bounds x="1047" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_10" bpmnElement="End_10">
