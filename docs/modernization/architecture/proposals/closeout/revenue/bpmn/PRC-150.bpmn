<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-150" targetNamespace="https://forcitis.one/bpmn/PRC-150" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="发票已红冲"/>
  <dataStore id="DS_AGG-49" name="AGG-49"/>
  <collaboration id="Collab_PRC-150">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-150"/>
  </collaboration>
  <process id="PRC-150" name="冲减应收款项" isExecutable="false">
    <documentation>owner B-09；VS-04.4</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_3</flowNodeRef>
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S3_5</flowNodeRef>
        <flowNodeRef>S3_gw_6</flowNodeRef>
        <flowNodeRef>End_7</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="发票已红冲">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <serviceTask id="S1_2" name="冲减应收">
      <documentation>AGG-49 冲减应收；B-09；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_3" name="冲减应收？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_4" name="转预收或待退">
      <documentation>AGG-49 转预收或待退；B-09；automatic</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <serviceTask id="S3_5" name="提交过账候选 → B-16">
      <documentation>AGG-49 提交过账候选；B-09；automatic；调用 PRC-92</documentation>
      <incoming>Flow_5</incoming>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S3_5">
        <dataOutput id="DOut_S3_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_5_1"><sourceRef>DOut_S3_5_1</sourceRef><targetRef>SR_S3_5_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S3_gw_6" name="提交过账候选？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <endEvent id="End_7" name="应收未找到">
      <incoming>Flow_3</incoming>
    </endEvent>
    <endEvent id="End_8" name="暂挂待跨年处理">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_9" name="已转预收或待退">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_10" name="应收已冲减">
      <incoming>Flow_10</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_3"/>
    <sequenceFlow id="Flow_3" name="找不到蓝字发票对应的应收" sourceRef="S1_gw_3" targetRef="End_7"/>
    <sequenceFlow id="Flow_4" name="红冲额超过应收未结余额（已收款后再红冲）" sourceRef="S1_gw_3" targetRef="S2_4"/>
    <sequenceFlow id="Flow_5" name="其他" sourceRef="S1_gw_3" targetRef="S3_5"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_4" targetRef="S3_5"/>
    <sequenceFlow id="Flow_7" sourceRef="S3_5" targetRef="S3_gw_6"/>
    <sequenceFlow id="Flow_8" name="原期间所在年度已年结" sourceRef="S3_gw_6" targetRef="End_8"/>
    <sequenceFlow id="Flow_9" name="红冲额超过未结余额，已转预收或待退" sourceRef="S3_gw_6" targetRef="End_9"/>
    <sequenceFlow id="Flow_10" name="其他" sourceRef="S3_gw_6" targetRef="End_10"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-49" dataStoreRef="DS_AGG-49"/>
    <dataStoreReference id="SR_S2_4_w1" name="AGG-49" dataStoreRef="DS_AGG-49"/>
    <dataStoreReference id="SR_S3_5_w1" name="AGG-49" dataStoreRef="DS_AGG-49"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-150">
    <bpmndi:BPMNPlane id="Plane_PRC-150" bpmnElement="Collab_PRC-150">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1230" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_system" bpmnElement="Lane_system" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1200" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_2" bpmnElement="S1_2">
