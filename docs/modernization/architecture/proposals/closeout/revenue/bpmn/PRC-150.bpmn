      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_2_w1" bpmnElement="SR_S1_2_w1">
        <dc:Bounds x="217" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_4_w1" bpmnElement="SR_S2_4_w1">
        <dc:Bounds x="477" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S3_5_w1" bpmnElement="SR_S3_5_w1">
        <dc:Bounds x="647" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="123" y="65"/>
        <di:waypoint x="185" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="65"/>
        <di:waypoint x="340" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="365" y="90"/>
        <di:waypoint x="365" y="124"/>
        <di:waypoint x="885" y="124"/>
        <di:waypoint x="885" y="83"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="390" y="65"/>
        <di:waypoint x="445" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
