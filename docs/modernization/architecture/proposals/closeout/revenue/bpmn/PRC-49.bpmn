    <dataStoreReference id="SR_S1_3_r2" name="AGG-31" dataStoreRef="DS_AGG-31"/>
    <dataStoreReference id="SR_S2_4_w1" name="AGG-16" dataStoreRef="DS_AGG-16"/>
    <dataStoreReference id="SR_S3_reg_9_w1" name="AGG-16" dataStoreRef="DS_AGG-16"/>
    <dataObject id="DObj_OR_S3_reg_9_1"/>
    <dataObjectReference id="OR_S3_reg_9_1" name="对方书面认定函或签认单扫…" dataObjectRef="DObj_OR_S3_reg_9_1"/>
    <dataStoreReference id="SR_S4_reg_11_w1" name="AGG-16" dataStoreRef="DS_AGG-16"/>
    <dataObject id="DObj_OR_S4_reg_11_1"/>
    <dataObjectReference id="OR_S4_reg_11_1" name="对方书面拒绝函或我方撤回…" dataObjectRef="DObj_OR_S4_reg_11_1"/>
    <textAnnotation id="Ann_1"><text>由其他流程调用</text></textAnnotation>
    <association id="Assoc_Ann_1" sourceRef="Start_2" targetRef="Ann_1" associationDirection="None"/>
  </process>
