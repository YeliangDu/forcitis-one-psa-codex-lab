<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-49" targetNamespace="https://forcitis.one/bpmn/PRC-49" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-30" name="AGG-30"/>
  <dataStore id="DS_AGG-31" name="AGG-31"/>
  <dataStore id="DS_AGG-16" name="AGG-16"/>
  <collaboration id="Collab_PRC-49">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-49"/>
  </collaboration>
  <process id="PRC-49" name="提出并认定索赔" isExecutable="false">
    <documentation>owner B-05；VS-04.6、VS-04.5</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E5" name="市场和客户经理（SH-E5）">
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>S3_manual_8</flowNodeRef>
        <flowNodeRef>S3_reg_9</flowNodeRef>
        <flowNodeRef>S4_manual_10</flowNodeRef>
        <flowNodeRef>S4_reg_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
        <flowNodeRef>End_15</flowNodeRef>
        <flowNodeRef>S2_4_bd_5</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S2_4_esc_6</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="商务发现可索赔事项并提出索赔">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="PRC-66 结算中双方未能确认最终价款，商务转索赔（H3）">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="读所引用的设计变更与延期申请 → B-28、B-04">
      <documentation>读所引用的设计变更与延期申请；B-05；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <dataInput id="DIn_S1_3_2"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs><dataInputRefs>DIn_S1_3_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_3_2"><sourceRef>SR_S1_3_r2</sourceRef><targetRef>DIn_S1_3_2</targetRef></dataInputAssociation>
    </serviceTask>
    <userTask id="S2_4" name="提出索赔">
      <documentation>AGG-16 提出索赔；B-05；in_system；索赔.提出；索赔提出页</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S2_4_bd_5" name="期限 合同约定索赔时限（INV-17）；未约定时 P28D 自事项发生日起" cancelActivity="false" attachedToRef="S2_4">
      <outgoing>Flow_8</outgoing>
      <timerEventDefinition><timeDuration>合同约定索赔时限（INV-17）；未约定时 P28D 自事项发生日起</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_4_esc_6" name="处理超时：提出索赔">
      <documentation>升级给 SH-M1；期限 合同约定索赔时限（INV-17）；未约定时 P28D 自事项发生日起</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_4_esc_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <exclusiveGateway id="S2_gw_7" name="提出索赔？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <manualTask id="S3_manual_8" name="线下办理认定索赔">
      <documentation>线下办理；证据：对方书面认定函或签认单扫描件；认定日与认定金额、工期</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S3_manual_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S3_reg_9" name="登记认定索赔">
      <documentation>AGG-16 认定索赔；B-05；offline；索赔.认定；索赔认定登记页</documentation>
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S3_reg_9">
        <dataOutput id="DOut_S3_reg_9_1"/>
        <dataOutput id="DOut_S3_reg_9_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_reg_9_1</dataOutputRefs><dataOutputRefs>DOut_S3_reg_9_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_reg_9_1"><sourceRef>DOut_S3_reg_9_1</sourceRef><targetRef>SR_S3_reg_9_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S3_reg_9_2"><sourceRef>DOut_S3_reg_9_2</sourceRef><targetRef>OR_S3_reg_9_1</targetRef></dataOutputAssociation>
    </userTask>
    <manualTask id="S4_manual_10" name="线下办理拒绝或撤回索赔">
      <documentation>线下办理；证据：对方书面拒绝函或我方撤回函；拒绝或撤回日</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S4_manual_10">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <userTask id="S4_reg_11" name="登记拒绝或撤回索赔">
      <documentation>AGG-16 拒绝或撤回索赔；B-05；offline；索赔.拒绝或撤回；索赔拒绝撤回登记页</documentation>
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <ioSpecification id="IO_S4_reg_11">
        <dataOutput id="DOut_S4_reg_11_1"/>
        <dataOutput id="DOut_S4_reg_11_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_reg_11_1</dataOutputRefs><dataOutputRefs>DOut_S4_reg_11_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_reg_11_1"><sourceRef>DOut_S4_reg_11_1</sourceRef><targetRef>SR_S4_reg_11_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S4_reg_11_2"><sourceRef>DOut_S4_reg_11_2</sourceRef><targetRef>OR_S4_reg_11_1</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="End_12" name="已提交待答复">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_13" name="已提醒">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_14" name="索赔已认定">
      <incoming>Flow_11</incoming>
    </endEvent>
    <endEvent id="End_15" name="索赔已拒绝或撤回">
      <incoming>Flow_13</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S2_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S2_4" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_5" name="对方认定索赔" sourceRef="S2_gw_7" targetRef="S3_manual_8"/>
    <sequenceFlow id="Flow_6" name="对方拒绝，或我方撤回" sourceRef="S2_gw_7" targetRef="S4_manual_10"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S2_gw_7" targetRef="End_12"/>
    <sequenceFlow id="Flow_8" sourceRef="S2_4_bd_5" targetRef="S2_4_esc_6"/>
