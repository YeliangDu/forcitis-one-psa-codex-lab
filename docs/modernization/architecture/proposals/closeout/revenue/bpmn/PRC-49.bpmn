    <startEvent id="Start_1" name="商务发现可索赔事项并提出索赔">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="PRC-66 结算中双方未能确认最终价款，商务转索赔（H3）">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="读所引用的设计变更与延期申请 → B-28、B-04">
      <documentation>读所引用的设计变更与延期申请；B-05；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
