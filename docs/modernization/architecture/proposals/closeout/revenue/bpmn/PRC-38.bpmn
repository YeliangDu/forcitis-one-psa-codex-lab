<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-38" targetNamespace="https://forcitis.one/bpmn/PRC-38" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-103" name="AGG-103"/>
  <collaboration id="Collab_PRC-38">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-38"/>
  </collaboration>
  <process id="PRC-38" name="编制并发布项目复盘" isExecutable="false">
    <documentation>owner B-04；VS-02.7</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S3_7</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
      </lane>
      <lane id="Lane_SH-E4" name="技术专家（SH-E4）">
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_gw_6</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_3</flowNodeRef>
        <flowNodeRef>S1_api_4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目进入收尾，项目经理编制复盘">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="编制项目复盘">
      <documentation>AGG-103 编制项目复盘；B-04；in_system；项目复盘.编制；项目复盘编辑页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S1_api_3" name="编制人 → B-13">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_3">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <serviceTask id="S1_api_4" name="产出的知识条目 → B-30">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_api_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <userTask id="S2_5" name="评审项目复盘">
      <documentation>AGG-103 评审项目复盘；B-04；in_system；项目复盘.评审；项目复盘评审页；审批（aggregate）：项目复盘评审</documentation>
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_6" name="评审项目复盘？">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <userTask id="S3_7" name="发布项目复盘">
      <documentation>AGG-103 发布项目复盘；B-04；in_system；项目复盘.发布；项目复盘发布页</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S3_7">
        <dataOutput id="DOut_S3_7_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_7_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_7_1"><sourceRef>DOut_S3_7_1</sourceRef><targetRef>SR_S3_7_w1</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="End_8" name="已发布">
      <incoming>Flow_8</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_api_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_api_3" targetRef="S1_api_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_api_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_5" sourceRef="S2_5" targetRef="S2_gw_6"/>
    <sequenceFlow id="Flow_6" name="评审通过" sourceRef="S2_gw_6" targetRef="S3_7"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S2_gw_6" targetRef="S1_2"/>
    <sequenceFlow id="Flow_8" sourceRef="S3_7" targetRef="End_8"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-103" dataStoreRef="DS_AGG-103"/>
    <dataStoreReference id="SR_S2_5_w1" name="AGG-103" dataStoreRef="DS_AGG-103"/>
    <dataStoreReference id="SR_S3_7_w1" name="AGG-103" dataStoreRef="DS_AGG-103"/>
  </process>
