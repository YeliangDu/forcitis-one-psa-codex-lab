<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-20" targetNamespace="https://forcitis.one/bpmn/PRC-20" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-25" name="AGG-25"/>
  <dataStore id="DS_AGG-62" name="AGG-62"/>
  <dataStore id="DS_AGG-68" name="AGG-68"/>
  <dataStore id="DS_AGG-26" name="AGG-26"/>
  <collaboration id="Collab_PRC-20">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-20"/>
  </collaboration>
  <process id="PRC-20" name="提出并满足资源需求" isExecutable="false">
    <documentation>owner B-04；VS-02.0、VS-02.1、VS-02.2、VS-02.3、VS-02.4、VS-02.5、VS-02.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S5_7</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S3_4</flowNodeRef>
        <flowNodeRef>S3_gw_5</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S2_3</flowNodeRef>
        <flowNodeRef>S4_6</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目经理按工作包提出资源需求">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="提出资源需求">
      <documentation>AGG-25 提出资源需求；B-04；in_system；资源需求.提出；资源需求编辑页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_3" name="读候选人员、工作日历与已确认的分配，供部门负责人核对产能 → B-13、B-14">
      <documentation>读候选人员、工作日历与已确认的分配，供部门负责人核对产能；B-04；automatic</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S2_3">
        <dataInput id="DIn_S2_3_1"/>
        <dataInput id="DIn_S2_3_2"/>
        <inputSet><dataInputRefs>DIn_S2_3_1</dataInputRefs><dataInputRefs>DIn_S2_3_2</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S2_3_1"><sourceRef>SR_S2_3_r1</sourceRef><targetRef>DIn_S2_3_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S2_3_2"><sourceRef>SR_S2_3_r2</sourceRef><targetRef>DIn_S2_3_2</targetRef></dataInputAssociation>
    </serviceTask>
    <userTask id="S3_4" name="确认资源分配">
      <documentation>AGG-26 确认资源分配；B-04；in_system；资源分配.确认；资源分配确认页；审批（aggregate）：资源分配确认</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S3_4">
        <dataOutput id="DOut_S3_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_4_1"><sourceRef>DOut_S3_4_1</sourceRef><targetRef>SR_S3_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_5" name="确认资源分配？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <serviceTask id="S4_6" name="标记资源需求已满足">
      <documentation>AGG-25 标记资源需求已满足；B-04；automatic</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S4_6">
        <dataOutput id="DOut_S4_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_6_1"><sourceRef>DOut_S4_6_1</sourceRef><targetRef>SR_S4_6_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <userTask id="S5_7" name="关闭资源需求">
      <documentation>AGG-25 关闭资源需求；B-04；in_system；资源需求.关闭；资源需求页</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S5_7">
        <dataOutput id="DOut_S5_7_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_7_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_7_1"><sourceRef>DOut_S5_7_1</sourceRef><targetRef>SR_S5_7_w1</targetRef></dataOutputAssociation>
    </userTask>
    <endEvent id="End_8" name="已满足">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_9" name="已关闭">
      <incoming>Flow_9</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S2_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S2_3" targetRef="S3_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S3_4" targetRef="S3_gw_5"/>
    <sequenceFlow id="Flow_5" name="分配覆盖需求的全部时段与工时" sourceRef="S3_gw_5" targetRef="S4_6"/>
    <sequenceFlow id="Flow_6" name="需求不再需要（范围变更、改外协）" sourceRef="S3_gw_5" targetRef="S5_7"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S3_gw_5" targetRef="S1_2"/>
    <sequenceFlow id="Flow_8" sourceRef="S4_6" targetRef="End_8"/>
    <sequenceFlow id="Flow_9" sourceRef="S5_7" targetRef="End_9"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-25" dataStoreRef="DS_AGG-25"/>
    <dataStoreReference id="SR_S2_3_r1" name="AGG-62" dataStoreRef="DS_AGG-62"/>
    <dataStoreReference id="SR_S2_3_r2" name="AGG-68" dataStoreRef="DS_AGG-68"/>
    <dataStoreReference id="SR_S3_4_w1" name="AGG-26" dataStoreRef="DS_AGG-26"/>
    <dataStoreReference id="SR_S4_6_w1" name="AGG-25" dataStoreRef="DS_AGG-25"/>
    <dataStoreReference id="SR_S5_7_w1" name="AGG-25" dataStoreRef="DS_AGG-25"/>
  </process>
