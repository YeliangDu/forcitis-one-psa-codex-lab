    <startEvent id="Start_1" name="项目总监因故暂停项目">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="执行中的项目不再继续履行，直接终止（待 Q09 确认可否不经暂停）">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <startEvent id="Start_3" name="执行中的项目无任何投入，直接取消（待 Q09 确认可否不经暂停）">
      <outgoing>Flow_3</outgoing>
    </startEvent>
    <userTask id="S1_4" name="暂停项目">
      <documentation>AGG-19 暂停项目；B-04；in_system；项目.暂停；项目状态处置页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
