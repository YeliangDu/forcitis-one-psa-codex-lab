<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-56" targetNamespace="https://forcitis.one/bpmn/PRC-56" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="交付物已认可"/>
  <signal id="Signal_2" name="付款条件项已可结算"/>
  <dataStore id="DS_AGG-13" name="AGG-13"/>
  <collaboration id="Collab_PRC-56">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-56"/>
  </collaboration>
  <process id="PRC-56" name="付款条件项转为可结算" isExecutable="false">
    <documentation>owner B-05；VS-04.3</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_evt_3</flowNodeRef>
        <flowNodeRef>End_4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="交付物已认可">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <serviceTask id="S1_2" name="标记付款条件项可结算">
      <documentation>AGG-13 标记付款条件项可结算；B-05；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <intermediateThrowEvent id="S1_evt_3" name="付款条件项已可结算">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </intermediateThrowEvent>
    <endEvent id="End_4" name="付款条件项已可结算">
      <incoming>Flow_3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_evt_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_evt_3" targetRef="End_4"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-13" dataStoreRef="DS_AGG-13"/>
    <textAnnotation id="Ann_1"><text>对方 BC：B-08</text></textAnnotation>
    <association id="Assoc_Ann_1" sourceRef="S1_evt_3" targetRef="Ann_1" associationDirection="None"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-56">
