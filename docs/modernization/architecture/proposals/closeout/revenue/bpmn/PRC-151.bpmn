<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-151" targetNamespace="https://forcitis.one/bpmn/PRC-151" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-23" name="AGG-23"/>
  <collaboration id="Collab_PRC-151">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-151"/>
  </collaboration>
  <process id="PRC-151" name="填报经营产值" isExecutable="false">
    <documentation>owner B-04；VS-02.2、VS-02.3、VS-02.4、VS-02.5、VS-02.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E2" name="项目经理（SH-E2）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
        <flowNodeRef>S1_2_bd_3</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S1_2_esc_4</flowNodeRef>
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="每期末产值填报窗口开启">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <userTask id="S1_2" name="填报产值估计">
      <documentation>AGG-23 填报产值估计；B-04；in_system；经营产值.填报；经营产值填报页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S1_2_bd_3" name="期限 P3D" cancelActivity="false" attachedToRef="S1_2">
      <outgoing>Flow_5</outgoing>
      <timerEventDefinition><timeDuration>P3D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_2_esc_4" name="处理超时：填报产值估计">
      <documentation>升级给 SH-M1；期限 P3D</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S1_2_esc_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <exclusiveGateway id="S1_gw_5" name="填报产值估计？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
    </exclusiveGateway>
    <userTask id="S2_6" name="部门负责人抽查产值估计，对照完工估算与交付进度判断合理性">
      <documentation>部门负责人抽查产值估计，对照完工估算与交付进度判断合理性；B-04；in_system；经营产值.抽查；经营产值抽查页</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataInput id="DIn_S2_6_1"/>
        <inputSet><dataInputRefs>DIn_S2_6_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S2_6_1"><sourceRef>SR_S2_6_r1</sourceRef><targetRef>DIn_S2_6_1</targetRef></dataInputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_7" name="部门负责人抽查产值估计，对照完工估算与交付进度判断合理性？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <endEvent id="End_8" name="产值已填报">
      <incoming>Flow_4</incoming>
    </endEvent>
    <endEvent id="End_9" name="已提醒">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_10" name="产值已抽查">
      <incoming>Flow_9</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_5"/>
    <sequenceFlow id="Flow_3" name="被抽查（按抽查比例规则配置）" sourceRef="S1_gw_5" targetRef="S2_6"/>
    <sequenceFlow id="Flow_4" name="其他" sourceRef="S1_gw_5" targetRef="End_8"/>
    <sequenceFlow id="Flow_5" sourceRef="S1_2_bd_3" targetRef="S1_2_esc_4"/>
    <sequenceFlow id="Flow_6" sourceRef="S1_2_esc_4" targetRef="End_9"/>
    <sequenceFlow id="Flow_7" sourceRef="S2_6" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_8" name="发现明显偏差，通知项目经理更正" sourceRef="S2_gw_7" targetRef="S1_2"/>
    <sequenceFlow id="Flow_9" name="其他" sourceRef="S2_gw_7" targetRef="End_10"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-23" dataStoreRef="DS_AGG-23"/>
    <dataStoreReference id="SR_S2_6_r1" name="AGG-23" dataStoreRef="DS_AGG-23"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-151">
    <bpmndi:BPMNPlane id="Plane_PRC-151" bpmnElement="Collab_PRC-151">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1140" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SH-E2" bpmnElement="Lane_SH-E2" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1110" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_SH-M1" bpmnElement="Lane_SH-M1" isHorizontal="true">
        <dc:Bounds x="30" y="130" width="1110" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_2" bpmnElement="S1_2">
        <dc:Bounds x="185" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_2_bd_3" bpmnElement="S1_2_bd_3">
        <dc:Bounds x="242" y="77" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_2_esc_4" bpmnElement="S1_2_esc_4">
        <dc:Bounds x="355" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_gw_5" bpmnElement="S1_gw_5" isMarkerVisible="true">
        <dc:Bounds x="510" y="40" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="490" y="6" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_6" bpmnElement="S2_6">
        <dc:Bounds x="615" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_gw_7" bpmnElement="S2_gw_7" isMarkerVisible="true">
        <dc:Bounds x="770" y="170" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="750" y="136" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_8" bpmnElement="End_8">
        <dc:Bounds x="867" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_9" bpmnElement="End_9">
        <dc:Bounds x="957" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_10" bpmnElement="End_10">
        <dc:Bounds x="1047" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_2_w1" bpmnElement="SR_S1_2_w1">
        <dc:Bounds x="217" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_6_r1" bpmnElement="SR_S2_6_r1">
        <dc:Bounds x="647" y="134" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="123" y="65"/>
        <di:waypoint x="185" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="65"/>
        <di:waypoint x="510" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="535" y="90"/>
        <di:waypoint x="535" y="195"/>
        <di:waypoint x="615" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="560" y="65"/>
        <di:waypoint x="867" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="260" y="113"/>
        <di:waypoint x="260" y="195"/>
        <di:waypoint x="355" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="405" y="225"/>
        <di:waypoint x="405" y="254"/>
        <di:waypoint x="975" y="254"/>
        <di:waypoint x="975" y="213"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="715" y="195"/>
        <di:waypoint x="770" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="795" y="220"/>
        <di:waypoint x="795" y="249"/>
        <di:waypoint x="235" y="249"/>
        <di:waypoint x="235" y="95"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="795" y="220"/>
        <di:waypoint x="795" y="244"/>
        <di:waypoint x="1065" y="244"/>
        <di:waypoint x="1065" y="213"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S1_2_1" bpmnElement="DOA_S1_2_1">
        <di:waypoint x="235" y="35"/>
        <di:waypoint x="235" y="30"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DIA_S2_6_1" bpmnElement="DIA_S2_6_1">
        <di:waypoint x="665" y="160"/>
        <di:waypoint x="665" y="165"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
