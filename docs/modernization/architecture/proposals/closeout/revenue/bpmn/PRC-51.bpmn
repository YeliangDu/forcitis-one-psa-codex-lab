<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-51" targetNamespace="https://forcitis.one/bpmn/PRC-51" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="协议已生效"/>
  <signal id="Signal_2" name="新基线已生效"/>
  <dataStore id="DS_AGG-44" name="AGG-44"/>
  <collaboration id="Collab_PRC-51">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-51"/>
  </collaboration>
  <process id="PRC-51" name="建立并更新开票与收入额度" isExecutable="false">
    <documentation>owner B-08；VS-04.1、VS-04.2、VS-04.3、VS-04.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>End_4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="协议已生效">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="新基线已生效">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <serviceTask id="S1_3" name="更新开票与收入额度 → B-05、B-13">
      <documentation>AGG-44 更新开票与收入额度；B-08；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataOutput id="DOut_S1_3_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>SR_S1_3_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_4" name="可开票额度已更新">
      <incoming>Flow_3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="End_4"/>
    <dataStoreReference id="SR_S1_3_w1" name="AGG-44" dataStoreRef="DS_AGG-44"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-51">
    <bpmndi:BPMNPlane id="Plane_PRC-51" bpmnElement="Collab_PRC-51">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="600" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_system" bpmnElement="Lane_system" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="570" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_2" bpmnElement="Start_2">
        <dc:Bounds x="177" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_3" bpmnElement="S1_3">
        <dc:Bounds x="275" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_4" bpmnElement="End_4">
        <dc:Bounds x="437" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_3_w1" bpmnElement="SR_S1_3_w1">
        <dc:Bounds x="307" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="105" y="83"/>
        <di:waypoint x="105" y="124"/>
        <di:waypoint x="325" y="124"/>
        <di:waypoint x="325" y="95"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="213" y="65"/>
        <di:waypoint x="275" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="375" y="65"/>
        <di:waypoint x="437" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_S1_3_1" bpmnElement="DOA_S1_3_1">
        <di:waypoint x="325" y="35"/>
        <di:waypoint x="325" y="30"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
