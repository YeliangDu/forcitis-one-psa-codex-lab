      <dataOutputAssociation id="DOA_S4_reg_9_2"><sourceRef>DOut_S4_reg_9_2</sourceRef><targetRef>OR_S4_reg_9_1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S4_gw_10" name="确认最终价款？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
    </exclusiveGateway>
    <userTask id="S5_11" name="最终价款让价审批">
      <documentation>最终价款让价审批；B-08；in_system；协议结算.让价审批；审批待办页；审批平台：最终价款让价审批单</documentation>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_15</outgoing>
      <ioSpecification id="IO_S5_11">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S5_11_bd_12" name="期限 P5D" cancelActivity="false" attachedToRef="S5_11">
      <outgoing>Flow_20</outgoing>
      <timerEventDefinition><timeDuration>P5D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S5_11_esc_13" name="处理超时：最终价款让价审批">
      <documentation>升级给 SH-M1；期限 P5D</documentation>
      <incoming>Flow_20</incoming>
      <outgoing>Flow_21</outgoing>
      <ioSpecification id="IO_S5_11_esc_13">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S5_api_14" name="发起最终价款让价审批 → platform.approval">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <ioSpecification id="IO_S5_api_14">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S5_gw_15" name="最终价款让价审批？">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <outgoing>Flow_18</outgoing>
      <outgoing>Flow_19</outgoing>
    </exclusiveGateway>
    <userTask id="S6_16" name="结算协议">
      <documentation>AGG-13 结算协议；B-05；in_system；协议结算.结算；协议结算页</documentation>
