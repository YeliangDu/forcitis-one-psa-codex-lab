      </ioSpecification>
      <dataOutputAssociation id="DOA_S6_16_1"><sourceRef>DOut_S6_16_1</sourceRef><targetRef>SR_S6_16_w1</targetRef></dataOutputAssociation>
    </userTask>
    <intermediateThrowEvent id="S6_evt_17" name="协议已结算">
      <incoming>Flow_22</incoming>
      <outgoing>Flow_23</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </intermediateThrowEvent>
    <endEvent id="End_18" name="已转 PRC-49">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_19" name="转争议处理">
