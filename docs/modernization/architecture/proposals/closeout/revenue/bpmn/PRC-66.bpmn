  <process id="PRC-66" name="确认最终价款并结算协议" isExecutable="false">
    <documentation>owner B-08；VS-04.5、VS-04.6</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E5" name="市场和客户经理（SH-E5）">
        <flowNodeRef>S2_3</flowNodeRef>
        <flowNodeRef>S3_5</flowNodeRef>
        <flowNodeRef>S4_manual_6</flowNodeRef>
        <flowNodeRef>S4_reg_9</flowNodeRef>
        <flowNodeRef>S4_gw_10</flowNodeRef>
        <flowNodeRef>S6_16</flowNodeRef>
        <flowNodeRef>S6_evt_17</flowNodeRef>
