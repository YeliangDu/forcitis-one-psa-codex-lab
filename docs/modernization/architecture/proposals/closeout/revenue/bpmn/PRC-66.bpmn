        <flowNodeRef>End_19</flowNodeRef>
        <flowNodeRef>End_23</flowNodeRef>
        <flowNodeRef>S4_manual_6_bd_7</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S4_manual_6_esc_8</flowNodeRef>
        <flowNodeRef>S5_11_esc_13</flowNodeRef>
        <flowNodeRef>End_20</flowNodeRef>
        <flowNodeRef>End_22</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S2_api_4</flowNodeRef>
        <flowNodeRef>S5_11</flowNodeRef>
        <flowNodeRef>S5_api_14</flowNodeRef>
        <flowNodeRef>S5_gw_15</flowNodeRef>
        <flowNodeRef>End_21</flowNodeRef>
        <flowNodeRef>S5_11_bd_12</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="商务在最后一份成果认可或项目结项后发起结算">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <serviceTask id="S1_2" name="读履约义务累计确认与分摊价格作前置提示">
      <documentation>读履约义务累计确认与分摊价格作前置提示；B-08；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataInput id="DIn_S1_2_1"/>
        <inputSet><dataInputRefs>DIn_S1_2_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_2_1"><sourceRef>SR_S1_2_r1</sourceRef><targetRef>DIn_S1_2_1</targetRef></dataInputAssociation>
    </serviceTask>
    <userTask id="S2_3" name="完成协议">
      <documentation>AGG-13 完成协议；B-08；in_system；协议结算.发起；协议结算发起页</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S2_3">
        <dataOutput id="DOut_S2_3_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_3_1"><sourceRef>DOut_S2_3_1</sourceRef><targetRef>SR_S2_3_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_api_4" name="完成协议 → B-05">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S2_api_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <userTask id="S3_5" name="编制结算书">
      <documentation>AGG-13 编制结算书；B-05；in_system；协议结算.编制；协议结算书编制页</documentation>
      <incoming>Flow_4</incoming>
      <incoming>Flow_8</incoming>
      <incoming>Flow_19</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S3_5">
        <dataOutput id="DOut_S3_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_5_1"><sourceRef>DOut_S3_5_1</sourceRef><targetRef>SR_S3_5_w1</targetRef></dataOutputAssociation>
    </userTask>
    <manualTask id="S4_manual_6" name="线下办理确认最终价款">
      <documentation>线下办理；证据：双方签认的结算书扫描件；签认日与签认人（发包人代表或授权人）</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S4_manual_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </manualTask>
    <boundaryEvent id="S4_manual_6_bd_7" name="期限 合同约定结算确认期；未约定时 P30D" cancelActivity="false" attachedToRef="S4_manual_6">
      <outgoing>Flow_13</outgoing>
      <timerEventDefinition><timeDuration>合同约定结算确认期；未约定时 P30D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S4_manual_6_esc_8" name="处理超时：确认最终价款">
      <documentation>升级给 SH-M1；期限 合同约定结算确认期；未约定时 P30D</documentation>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <ioSpecification id="IO_S4_manual_6_esc_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <userTask id="S4_reg_9" name="登记确认最终价款">
      <documentation>AGG-13 确认最终价款；B-05；offline；协议结算.确认最终价款；最终价款确认登记页</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S4_reg_9">
        <dataOutput id="DOut_S4_reg_9_1"/>
        <dataOutput id="DOut_S4_reg_9_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_reg_9_1</dataOutputRefs><dataOutputRefs>DOut_S4_reg_9_2</dataOutputRefs></outputSet>
      </ioSpecification>
