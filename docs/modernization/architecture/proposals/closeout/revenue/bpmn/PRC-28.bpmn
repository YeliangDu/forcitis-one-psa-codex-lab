  <process id="PRC-28" name="编制、评审并签发交付物，送达并登记客户认可" isExecutable="false">
    <documentation>owner B-28；VS-02.1、VS-02.2、VS-02.3、VS-02.4、VS-02.5、VS-02.6、VS-03.5</documentation>
    <laneSet id="LaneSet_1">
