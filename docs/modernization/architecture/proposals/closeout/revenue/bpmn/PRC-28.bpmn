        <flowNodeRef>End_26</flowNodeRef>
        <flowNodeRef>End_27</flowNodeRef>
        <flowNodeRef>End_28</flowNodeRef>
        <flowNodeRef>End_29</flowNodeRef>
        <flowNodeRef>S5_manual_10_bd_11</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S2_api_5</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="工作包待出成果，设计师开始编制">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <serviceTask id="S1_2" name="读项目、阶段与签发人执业证书 → B-04、B-13">
      <documentation>读项目、阶段与签发人执业证书；B-28；automatic</documentation>
