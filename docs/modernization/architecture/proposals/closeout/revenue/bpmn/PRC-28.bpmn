  <dataStore id="DS_AGG-66" name="AGG-66"/>
  <dataStore id="DS_AGG-27" name="AGG-27"/>
  <collaboration id="Collab_PRC-28">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-28"/>
    <participant id="Pool_1" name="客户·客户决策链·发起人（SH-C6a）"/>
    <messageFlow id="Msg_1" name="交付物客户认可" sourceRef="Pool_1" targetRef="S6_reg_17"/>
