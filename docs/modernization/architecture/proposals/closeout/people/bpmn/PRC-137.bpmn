<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_PRC_137" targetNamespace="https://forcitis.one/bpmn/PRC-137" exporter="one-arch-people bpmngen" exporterVersion="1">
  <signal id="Sig_registered" name="入职已登记"/>
  <signal id="Sig_employed" name="Employed"/>
  <message id="Msg_result" name="开通结果"/>
  <collaboration id="Collab_PRC_137">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-137"/>
    <participant id="P_wecom" name="企业微信"/>
    <messageFlow id="M1" name="创建成员（userid = 工号）" sourceRef="T_open" targetRef="P_wecom"/>
    <messageFlow id="M2" name="开通结果" sourceRef="P_wecom" targetRef="E_result"/>
  </collaboration>
  <process id="PRC-137" name="入职开通企业微信账号并绑定外部身份" isExecutable="false">
    <documentation>owner platform.identity（S-14）；Q-03；VS-07.3</documentation>
    <laneSet id="LaneSet_1">
      <lane id="L_sys" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>T_pending</flowNodeRef>
        <flowNodeRef>T_open</flowNodeRef>
        <flowNodeRef>E_result</flowNodeRef>
        <flowNodeRef>G_ok</flowNodeRef>
        <flowNodeRef>T_bind</flowNodeRef>
        <flowNodeRef>E_employed</flowNodeRef>
        <flowNodeRef>T_allow</flowNodeRef>
        <flowNodeRef>End_ok</flowNodeRef>
      </lane>
      <lane id="L_it" name="信息（SH-E6）">
        <flowNodeRef>T_fix</flowNodeRef>
        <flowNodeRef>B_due</flowNodeRef>
      </lane>
      <lane id="L_hr" name="人力（SH-E6）">
        <flowNodeRef>T_alarm</flowNodeRef>
        <flowNodeRef>End_alarm</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="入职已登记">
      <documentation>来自 PRC-83（B-13 AGG-62）</documentation>
      <outgoing>F1</outgoing>
      <signalEventDefinition id="ED_Start_1" signalRef="Sig_registered"/>
    </startEvent>
    <serviceTask id="T_pending" name="建立待开通登录身份">
      <documentation>platform.identity 〔缺〕建立待开通登录身份。以人员 ID 为键，拟定 userid = 工号，登录放行起点 = 入职日</documentation>
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </serviceTask>
    <sendTask id="T_open" name="开通企业微信成员">
      <documentation>platform.identity 〔缺〕开通企业微信成员，经 platform.integration 企业微信适配器（external:企业微信）。T-1 待用户：自动调接口（本图）或信息部门手工开通后确认</documentation>
      <incoming>F2</incoming>
      <incoming>F7</incoming>
      <outgoing>F3</outgoing>
    </sendTask>
    <intermediateCatchEvent id="E_result" name="收到开通结果">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
      <messageEventDefinition id="ED_E_result" messageRef="Msg_result"/>
    </intermediateCatchEvent>
    <exclusiveGateway id="G_ok" name="开通成功？">
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
      <outgoing>F6</outgoing>
    </exclusiveGateway>
    <serviceTask id="T_bind" name="绑定外部身份">
      <documentation>platform.identity 〔缺〕绑定外部身份。按 userid 精确绑定，不模糊匹配</documentation>
      <incoming>F5</incoming>
      <outgoing>F8</outgoing>
    </serviceTask>
    <intermediateCatchEvent id="E_employed" name="Employed">
      <documentation>来自 PRC-83，入职日到达</documentation>
      <incoming>F8</incoming>
      <outgoing>F9</outgoing>
      <signalEventDefinition id="ED_E_employed" signalRef="Sig_employed"/>
    </intermediateCatchEvent>
    <serviceTask id="T_allow" name="放行登录">
      <documentation>platform.identity；不设口令兜底（Q-03、SECURITY_INVARIANTS）</documentation>
      <incoming>F9</incoming>
      <outgoing>F10</outgoing>
    </serviceTask>
    <endEvent id="End_ok" name="账号可用">
      <incoming>F10</incoming>
    </endEvent>
    <userTask id="T_fix" name="处理开通失败">
      <documentation>信息部门修正（如 userid 被占用、接口报错）后重试</documentation>
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </userTask>
    <boundaryEvent id="B_due" name="入职日已到仍未开通" attachedToRef="T_fix" cancelActivity="false">
      <outgoing>F11</outgoing>
      <timerEventDefinition id="ED_B_due"><timeDate xsi:type="tFormalExpression">入职日</timeDate></timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="T_alarm" name="告警人力与信息部门">
      <documentation>不静默（CLAUDE.md 第 6 条）；时限待用户 T-2</documentation>
      <incoming>F11</incoming>
      <outgoing>F12</outgoing>
    </serviceTask>
    <endEvent id="End_alarm" name="已告警">
      <incoming>F12</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="T_pending"/>
    <sequenceFlow id="F2" sourceRef="T_pending" targetRef="T_open"/>
    <sequenceFlow id="F3" sourceRef="T_open" targetRef="E_result"/>
    <sequenceFlow id="F4" sourceRef="E_result" targetRef="G_ok"/>
    <sequenceFlow id="F5" name="成功" sourceRef="G_ok" targetRef="T_bind"/>
    <sequenceFlow id="F6" name="失败" sourceRef="G_ok" targetRef="T_fix"/>
    <sequenceFlow id="F7" name="已修正，重试" sourceRef="T_fix" targetRef="T_open"/>
    <sequenceFlow id="F8" sourceRef="T_bind" targetRef="E_employed"/>
    <sequenceFlow id="F9" sourceRef="E_employed" targetRef="T_allow"/>
    <sequenceFlow id="F10" sourceRef="T_allow" targetRef="End_ok"/>
    <sequenceFlow id="F11" sourceRef="B_due" targetRef="T_alarm"/>
    <sequenceFlow id="F12" sourceRef="T_alarm" targetRef="End_alarm"/>
    <textAnnotation id="A_t1"><text>T-1 待用户：自动开通（本图）或信息部门在企业微信后台手工开通后在本系统确认</text></textAnnotation>
    <association id="As_A_t1" sourceRef="T_open" targetRef="A_t1"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC_137">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_PRC_137">
      <bpmndi:BPMNShape id="P_main_di" bpmnElement="P_main" isHorizontal="true"><dc:Bounds x="0" y="100" width="1760" height="360"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_sys_di" bpmnElement="L_sys" isHorizontal="true"><dc:Bounds x="30" y="100" width="1730" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_it_di" bpmnElement="L_it" isHorizontal="true"><dc:Bounds x="30" y="220" width="1730" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_hr_di" bpmnElement="L_hr" isHorizontal="true"><dc:Bounds x="30" y="340" width="1730" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_wecom_di" bpmnElement="P_wecom" isHorizontal="true"><dc:Bounds x="0" y="0" width="1760" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="222" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_pending_di" bpmnElement="T_pending"><dc:Bounds x="345" y="125" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_open_di" bpmnElement="T_open"><dc:Bounds x="505" y="125" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_result_di" bpmnElement="E_result"><dc:Bounds x="702" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_ok_di" bpmnElement="G_ok"><dc:Bounds x="855" y="135" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_bind_di" bpmnElement="T_bind"><dc:Bounds x="985" y="125" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_employed_di" bpmnElement="E_employed"><dc:Bounds x="1182" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_allow_di" bpmnElement="T_allow"><dc:Bounds x="1305" y="125" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ok_di" bpmnElement="End_ok"><dc:Bounds x="1502" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_fix_di" bpmnElement="T_fix"><dc:Bounds x="825" y="245" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_due_di" bpmnElement="B_due"><dc:Bounds x="910" y="297" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_alarm_di" bpmnElement="T_alarm"><dc:Bounds x="985" y="365" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_alarm_di" bpmnElement="End_alarm"><dc:Bounds x="1182" y="382" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_t1_di" bpmnElement="A_t1"><dc:Bounds x="490" y="640" width="130" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="258" y="160"/><di:waypoint x="345" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="455" y="160"/><di:waypoint x="505" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="615" y="160"/><di:waypoint x="702" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="738" y="160"/><di:waypoint x="855" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="905" y="160"/><di:waypoint x="985" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="880" y="185"/><di:waypoint x="880" y="357"/><di:waypoint x="880" y="357"/><di:waypoint x="880" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="880" y="315"/><di:waypoint x="880" y="337"/><di:waypoint x="560" y="337"/><di:waypoint x="560" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1095" y="160"/><di:waypoint x="1182" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1218" y="160"/><di:waypoint x="1305" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1415" y="160"/><di:waypoint x="1502" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="946" y="315"/><di:waypoint x="966" y="315"/><di:waypoint x="966" y="400"/><di:waypoint x="985" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1095" y="400"/><di:waypoint x="1182" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="552" y="125"/><di:waypoint x="552" y="50"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M2_di" bpmnElement="M2"><di:waypoint x="728" y="50"/><di:waypoint x="728" y="142"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_A_t1_di" bpmnElement="As_A_t1"><di:waypoint x="560" y="195"/><di:waypoint x="555" y="640"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
