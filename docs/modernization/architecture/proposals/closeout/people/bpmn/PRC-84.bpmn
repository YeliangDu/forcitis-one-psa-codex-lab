<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_PRC_84" targetNamespace="https://forcitis.one/bpmn/PRC-84" exporter="one-arch-people bpmngen" exporterVersion="1">
  <signal id="Sig_employed" name="Employed"/>
  <signal id="Sig_profile" name="薪酬档案已变更"/>
  <collaboration id="Collab_PRC_84">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-84"/>
    <participant id="P_gov" name="人社与公积金经办平台（SH-R2）"/>
    <messageFlow id="M1" name="增员申报" sourceRef="T_enroll" targetRef="P_gov"/>
    <messageFlow id="M2" name="增员回执" sourceRef="P_gov" targetRef="T_enroll"/>
  </collaboration>
  <process id="PRC-84" name="入职后参保增员与建立薪酬档案" isExecutable="false">
    <documentation>owner B-15；VS-07.3</documentation>
    <laneSet id="LaneSet_1">
      <lane id="L_hr" name="人力（SH-E6）">
        <flowNodeRef>G_need</flowNodeRef>
        <flowNodeRef>T_enroll</flowNodeRef>
        <flowNodeRef>B_30</flowNodeRef>
        <flowNodeRef>T_record</flowNodeRef>
        <flowNodeRef>G_merge</flowNodeRef>
        <flowNodeRef>T_profile</flowNodeRef>
      </lane>
      <lane id="L_sys" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>T_remind</flowNodeRef>
        <flowNodeRef>End_remind</flowNodeRef>
        <flowNodeRef>E_profile</flowNodeRef>
        <flowNodeRef>End_ok</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="Employed">
      <documentation>来自 PRC-83（B-13 AGG-62）</documentation>
      <outgoing>F1</outgoing>
      <signalEventDefinition id="ED_Start_1" signalRef="Sig_employed"/>
    </startEvent>
    <exclusiveGateway id="G_need" name="该用工类型需要参保？">
      <documentation>清单待用户 T-4</documentation>
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
      <outgoing>F3</outgoing>
    </exclusiveGateway>
    <manualTask id="T_enroll" name="办理社保与公积金增员">
      <documentation>在人社与公积金官方网办平台办理（where: offline）</documentation>
      <incoming>F2</incoming>
      <outgoing>F4</outgoing>
    </manualTask>
    <boundaryEvent id="B_30" name="入职满 30 日未办" attachedToRef="T_enroll" cancelActivity="false">
      <documentation>P-32，社会保险法第 58 条</documentation>
      <outgoing>F9</outgoing>
      <timerEventDefinition id="ED_B_30"><timeDate xsi:type="tFormalExpression">入职日 + 30 日</timeDate></timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="T_remind" name="提醒办理参保">
      <documentation>P-32 提醒</documentation>
      <incoming>F9</incoming>
      <outgoing>F10</outgoing>
    </serviceTask>
    <endEvent id="End_remind" name="已提醒">
      <incoming>F10</incoming>
    </endEvent>
    <userTask id="T_record" name="登记参保增员">
      <documentation>AGG-74 参保增员；B-15。证据：社保与公积金增员回执、办理日</documentation>
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
      <dataOutputAssociation id="DA_T_record_DS_74"><targetRef>DS_74</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DA_T_record_DO_receipt"><targetRef>DO_receipt</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="G_merge" name="">
      <incoming>F3</incoming>
      <incoming>F5</incoming>
      <outgoing>F6</outgoing>
    </exclusiveGateway>
    <userTask id="T_profile" name="建立薪酬档案">
      <documentation>AGG-93 建立薪酬档案；B-15。生效日 = 入职日（U-12）；敏感个人信息（ADR-0043）</documentation>
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
      <dataOutputAssociation id="DA_T_profile_DS_93"><targetRef>DS_93</targetRef></dataOutputAssociation>
    </userTask>
    <intermediateThrowEvent id="E_profile" name="薪酬档案已变更">
      <incoming>F7</incoming>
      <outgoing>F8</outgoing>
      <signalEventDefinition id="ED_E_profile" signalRef="Sig_profile"/>
    </intermediateThrowEvent>
    <endEvent id="End_ok" name="已参保并建档">
      <incoming>F8</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="G_need"/>
    <sequenceFlow id="F2" name="需要" sourceRef="G_need" targetRef="T_enroll"/>
    <sequenceFlow id="F3" name="不需要" sourceRef="G_need" targetRef="G_merge"/>
    <sequenceFlow id="F4" sourceRef="T_enroll" targetRef="T_record"/>
    <sequenceFlow id="F5" sourceRef="T_record" targetRef="G_merge"/>
    <sequenceFlow id="F6" sourceRef="G_merge" targetRef="T_profile"/>
    <sequenceFlow id="F7" sourceRef="T_profile" targetRef="E_profile"/>
    <sequenceFlow id="F8" sourceRef="E_profile" targetRef="End_ok"/>
    <sequenceFlow id="F9" sourceRef="B_30" targetRef="T_remind"/>
    <sequenceFlow id="F10" sourceRef="T_remind" targetRef="End_remind"/>
    <dataStoreReference id="DS_74" name="AGG-74 社保与公积金参保"/>
    <dataStoreReference id="DS_93" name="AGG-93 人员薪酬档案"/>
    <dataObjectReference id="DO_receipt" name="增员回执＋办理日" dataObjectRef="DO_receipt_obj"/>
    <dataObject id="DO_receipt_obj"/>
    <textAnnotation id="A_p"><text>→ PRC-145 法人三口径预警（B-15）</text></textAnnotation>
    <association id="As_A_p" sourceRef="E_profile" targetRef="A_p"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC_84">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_PRC_84">
      <bpmndi:BPMNShape id="P_main_di" bpmnElement="P_main" isHorizontal="true"><dc:Bounds x="0" y="0" width="1600" height="240"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_hr_di" bpmnElement="L_hr" isHorizontal="true"><dc:Bounds x="30" y="0" width="1570" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_sys_di" bpmnElement="L_sys" isHorizontal="true"><dc:Bounds x="30" y="120" width="1570" height="120"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_gov_di" bpmnElement="P_gov" isHorizontal="true"><dc:Bounds x="0" y="500" width="1600" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="222" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_need_di" bpmnElement="G_need"><dc:Bounds x="375" y="35" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_enroll_di" bpmnElement="T_enroll"><dc:Bounds x="505" y="25" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_30_di" bpmnElement="B_30"><dc:Bounds x="590" y="77" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_remind_di" bpmnElement="T_remind"><dc:Bounds x="665" y="145" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_remind_di" bpmnElement="End_remind"><dc:Bounds x="862" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_record_di" bpmnElement="T_record"><dc:Bounds x="665" y="25" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_merge_di" bpmnElement="G_merge"><dc:Bounds x="855" y="35" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_profile_di" bpmnElement="T_profile"><dc:Bounds x="985" y="25" width="110" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_profile_di" bpmnElement="E_profile"><dc:Bounds x="1182" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ok_di" bpmnElement="End_ok"><dc:Bounds x="1342" y="162" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_74_di" bpmnElement="DS_74"><dc:Bounds x="695" y="280" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_93_di" bpmnElement="DS_93"><dc:Bounds x="1015" y="280" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_receipt_di" bpmnElement="DO_receipt"><dc:Bounds x="702" y="350" width="36" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_p_di" bpmnElement="A_p"><dc:Bounds x="1130" y="420" width="130" height="46"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="258" y="180"/><di:waypoint x="316" y="180"/><di:waypoint x="316" y="60"/><di:waypoint x="375" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="425" y="60"/><di:waypoint x="505" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="425" y="60"/><di:waypoint x="855" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="615" y="60"/><di:waypoint x="665" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="775" y="60"/><di:waypoint x="855" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="905" y="60"/><di:waypoint x="985" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1095" y="60"/><di:waypoint x="1138" y="60"/><di:waypoint x="1138" y="180"/><di:waypoint x="1182" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1218" y="180"/><di:waypoint x="1342" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="626" y="95"/><di:waypoint x="646" y="95"/><di:waypoint x="646" y="180"/><di:waypoint x="665" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="775" y="180"/><di:waypoint x="862" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1"><di:waypoint x="552" y="95"/><di:waypoint x="552" y="500"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M2_di" bpmnElement="M2"><di:waypoint x="568" y="500"/><di:waypoint x="568" y="95"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_T_record_DS_74_di" bpmnElement="DA_T_record_DS_74"><di:waypoint x="720" y="95"/><di:waypoint x="720" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_T_profile_DS_93_di" bpmnElement="DA_T_profile_DS_93"><di:waypoint x="1040" y="95"/><di:waypoint x="1040" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_T_record_DO_receipt_di" bpmnElement="DA_T_record_DO_receipt"><di:waypoint x="720" y="95"/><di:waypoint x="720" y="350"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="As_A_p_di" bpmnElement="As_A_p"><di:waypoint x="1200" y="198"/><di:waypoint x="1195" y="420"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
