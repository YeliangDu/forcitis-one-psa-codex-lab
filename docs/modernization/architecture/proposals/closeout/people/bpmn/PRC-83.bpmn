<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_PRC_83" targetNamespace="https://forcitis.one/bpmn/PRC-83" exporter="one-arch-people bpmngen" exporterVersion="1">
  <signal id="Sig_registered" name="入职已登记"/>
  <signal id="Sig_employed" name="Employed"/>
  <signal id="Sig_assign" name="任职已变更"/>
  <signal id="Sig_signed" name="劳动合同已签订"/>
  <message id="Msg_confirm" name="入职日确认"/>
  <collaboration id="Collab_PRC_83">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-83"/>
    <participant id="P_cand" name="候选人（SH-H1）"/>
    <messageFlow id="M1" name="入职日确认" sourceRef="P_cand" targetRef="Start_1"/>
    <messageFlow id="M2" name="劳动合同文本" sourceRef="T_sign" targetRef="P_cand"/>
    <messageFlow id="M3" name="已签署的劳动合同" sourceRef="P_cand" targetRef="T_sign"/>
  </collaboration>
  <process id="PRC-83" name="办理入职与任职" isExecutable="false">
    <documentation>owner B-13；样板 SAMPLE.md；VS-07.3</documentation>
    <laneSet id="LaneSet_1">
      <lane id="L_hr" name="人力（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>T_register</flowNodeRef>
        <flowNodeRef>T_assign</flowNodeRef>
        <flowNodeRef>G_assign</flowNodeRef>
        <flowNodeRef>T_contract</flowNodeRef>
        <flowNodeRef>G_probation</flowNodeRef>
        <flowNodeRef>T_sign</flowNodeRef>
        <flowNodeRef>B_month</flowNodeRef>
        <flowNodeRef>T_record</flowNodeRef>
      </lane>
      <lane id="L_head" name="人力负责人（SH-E6）">
        <flowNodeRef>T_approve</flowNodeRef>
        <flowNodeRef>G_approve</flowNodeRef>
      </lane>
      <lane id="L_sys" name="系统">
        <flowNodeRef>E_registered</flowNodeRef>
        <flowNodeRef>G_split</flowNodeRef>
        <flowNodeRef>E_hiredate</flowNodeRef>
        <flowNodeRef>T_effective</flowNodeRef>
        <flowNodeRef>E_employed</flowNodeRef>
        <flowNodeRef>E_assignchg</flowNodeRef>
        <flowNodeRef>T_remind</flowNodeRef>
        <flowNodeRef>End_remind</flowNodeRef>
        <flowNodeRef>E_signed</flowNodeRef>
        <flowNodeRef>G_join</flowNodeRef>
        <flowNodeRef>End_ok</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="候选人已确认入职日">
      <documentation>前序：PRC-82 作出录用决定（AGG-62 录用决定已作出）</documentation>
      <outgoing>F1</outgoing>
      <messageEventDefinition id="ED_Start_1" messageRef="Msg_confirm"/>
    </startEvent>
    <userTask id="T_register" name="登记入职">
      <documentation>AGG-62 登记入职；B-13。入职日为人事业务生效日，可提前登记、补登落回真实日期（U-12）</documentation>
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
      <dataOutputAssociation id="DA_T_register_DS_62"><targetRef>DS_62</targetRef></dataOutputAssociation>
    </userTask>
    <intermediateThrowEvent id="E_registered" name="入职已登记">
      <documentation>〔缺〕新事件，登记时发出（SAMPLE S3）</documentation>
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
      <signalEventDefinition id="ED_E_registered" signalRef="Sig_registered"/>
    </intermediateThrowEvent>
    <parallelGateway id="G_split" name="">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
      <outgoing>F8</outgoing>
    </parallelGateway>
    <intermediateCatchEvent id="E_hiredate" name="入职日到达">
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
      <timerEventDefinition id="ED_E_hiredate"><timeDate xsi:type="tFormalExpression">入职日 00:00（业务生效日）</timeDate></timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="T_effective" name="执行入职生效">
      <documentation>AGG-62 〔缺〕入职生效；B-13。补登时立即执行</documentation>
      <incoming>F5</incoming>
      <outgoing>F6</outgoing>
      <dataOutputAssociation id="DA_T_effective_DS_62"><targetRef>DS_62</targetRef></dataOutputAssociation>
    </serviceTask>
    <intermediateThrowEvent id="E_employed" name="Employed">
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
      <signalEventDefinition id="ED_E_employed" signalRef="Sig_employed"/>
    </intermediateThrowEvent>
    <userTask id="T_assign" name="建立任职">
      <documentation>AGG-63 建立任职；B-13。组织单元、职位（职位目录）、职级、汇报线、主 / 兼（Q-08、INV-62）</documentation>
      <incoming>F8</incoming>
      <incoming>F11</incoming>
      <outgoing>F9</outgoing>
      <dataOutputAssociation id="DA_T_assign_DS_63"><targetRef>DS_63</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="G_assign" name="主任职区间不重叠？">
      <incoming>F9</incoming>
      <outgoing>F10</outgoing>
      <outgoing>F11</outgoing>
    </exclusiveGateway>
    <intermediateThrowEvent id="E_assignchg" name="任职已变更">
      <incoming>F10</incoming>
      <outgoing>F12</outgoing>
      <signalEventDefinition id="ED_E_assignchg" signalRef="Sig_assign"/>
    </intermediateThrowEvent>
    <userTask id="T_contract" name="提交劳动合同">
      <documentation>AGG-67 提交劳动合同；B-13。用人单位为法人三口径之一（Q-09）</documentation>
      <incoming>F12</incoming>
      <incoming>F15</incoming>
      <incoming>F18</incoming>
      <outgoing>F13</outgoing>
      <dataOutputAssociation id="DA_T_contract_DS_67"><targetRef>DS_67</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="G_probation" name="试用期在法定上限内？">
      <documentation>INV-14，劳动合同法第 19 条</documentation>
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
      <outgoing>F15</outgoing>
    </exclusiveGateway>
    <userTask id="T_approve" name="批准劳动合同">
      <documentation>AGG-67 批准劳动合同 / 〔缺〕驳回劳动合同；B-13。聚合内单级批准，不经审批平台（intent 114200 F-3）</documentation>
      <incoming>F14</incoming>
      <outgoing>F16</outgoing>
      <dataOutputAssociation id="DA_T_approve_DS_67"><targetRef>DS_67</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="G_approve" name="批准？">
      <incoming>F16</incoming>
      <outgoing>F17</outgoing>
      <outgoing>F18</outgoing>
    </exclusiveGateway>
    <manualTask id="T_sign" name="签订劳动合同">
      <documentation>线下纸面签署（where: offline）；接电子签可改为外部系统</documentation>
      <incoming>F17</incoming>
      <outgoing>F19</outgoing>
    </manualTask>
    <boundaryEvent id="B_month" name="用工满一个月未签" attachedToRef="T_sign" cancelActivity="false">
      <documentation>P-05，劳动合同法第 10、82 条</documentation>
      <outgoing>F20</outgoing>
      <timerEventDefinition id="ED_B_month"><timeDate xsi:type="tFormalExpression">入职日 + 1 个月</timeDate></timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="T_remind" name="提醒补签劳动合同">
      <documentation>P-05 提醒，不拒绝</documentation>
      <incoming>F20</incoming>
      <outgoing>F21</outgoing>
    </serviceTask>
    <endEvent id="End_remind" name="已提醒">
      <incoming>F21</incoming>
    </endEvent>
    <userTask id="T_record" name="登记劳动合同签订">
      <documentation>AGG-67 签订劳动合同；B-13。证据：已签署合同扫描件、签署日</documentation>
      <incoming>F19</incoming>
      <outgoing>F22</outgoing>
      <dataOutputAssociation id="DA_T_record_DS_67"><targetRef>DS_67</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DA_T_record_DO_contract"><targetRef>DO_contract</targetRef></dataOutputAssociation>
    </userTask>
    <intermediateThrowEvent id="E_signed" name="劳动合同已签订">
      <incoming>F22</incoming>
      <outgoing>F23</outgoing>
      <signalEventDefinition id="ED_E_signed" signalRef="Sig_signed"/>
    </intermediateThrowEvent>
    <parallelGateway id="G_join" name="">
      <incoming>F7</incoming>
      <incoming>F23</incoming>
      <outgoing>F24</outgoing>
    </parallelGateway>
    <endEvent id="End_ok" name="已入职">
      <incoming>F24</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="T_register"/>
    <sequenceFlow id="F2" sourceRef="T_register" targetRef="E_registered"/>
    <sequenceFlow id="F3" sourceRef="E_registered" targetRef="G_split"/>
    <sequenceFlow id="F4" sourceRef="G_split" targetRef="E_hiredate"/>
    <sequenceFlow id="F5" sourceRef="E_hiredate" targetRef="T_effective"/>
    <sequenceFlow id="F6" sourceRef="T_effective" targetRef="E_employed"/>
    <sequenceFlow id="F7" sourceRef="E_employed" targetRef="G_join"/>
    <sequenceFlow id="F8" sourceRef="G_split" targetRef="T_assign"/>
    <sequenceFlow id="F9" sourceRef="T_assign" targetRef="G_assign"/>
    <sequenceFlow id="F10" name="不重叠" sourceRef="G_assign" targetRef="E_assignchg"/>
    <sequenceFlow id="F11" name="重叠，改正" sourceRef="G_assign" targetRef="T_assign"/>
    <sequenceFlow id="F12" sourceRef="E_assignchg" targetRef="T_contract"/>
    <sequenceFlow id="F13" sourceRef="T_contract" targetRef="G_probation"/>
    <sequenceFlow id="F14" name="在上限内" sourceRef="G_probation" targetRef="T_approve"/>
    <sequenceFlow id="F15" name="超上限，改合同" sourceRef="G_probation" targetRef="T_contract"/>
    <sequenceFlow id="F16" sourceRef="T_approve" targetRef="G_approve"/>
    <sequenceFlow id="F17" name="已批准" sourceRef="G_approve" targetRef="T_sign"/>
    <sequenceFlow id="F18" name="已驳回" sourceRef="G_approve" targetRef="T_contract"/>
    <sequenceFlow id="F19" sourceRef="T_sign" targetRef="T_record"/>
    <sequenceFlow id="F20" sourceRef="B_month" targetRef="T_remind"/>
    <sequenceFlow id="F21" sourceRef="T_remind" targetRef="End_remind"/>
    <sequenceFlow id="F22" sourceRef="T_record" targetRef="E_signed"/>
    <sequenceFlow id="F23" sourceRef="E_signed" targetRef="G_join"/>
    <sequenceFlow id="F24" sourceRef="G_join" targetRef="End_ok"/>
    <dataStoreReference id="DS_62" name="AGG-62 人员"/>
    <dataStoreReference id="DS_63" name="AGG-63 任职"/>
    <dataStoreReference id="DS_67" name="AGG-67 劳动合同"/>
    <dataObjectReference id="DO_contract" name="已签署合同扫描件＋签署日" dataObjectRef="DO_contract_obj"/>
    <dataObject id="DO_contract_obj"/>
    <textAnnotation id="A_reg"><text>→ PRC-137 入职开通企业微信并绑定外部身份（platform.identity）</text></textAnnotation>
    <textAnnotation id="A_emp"><text>→ PRC-84 参保增员与建立薪酬档案（B-15）；PRC-137 放行登录</text></textAnnotation>
    <textAnnotation id="A_asg"><text>→ platform.identity 重算默认角色与数据范围</text></textAnnotation>
    <textAnnotation id="A_sig"><text>→ PRC-145 法人三口径预警（B-15）</text></textAnnotation>
    <association id="As_A_reg" sourceRef="E_registered" targetRef="A_reg"/>
    <association id="As_A_emp" sourceRef="E_employed" targetRef="A_emp"/>
    <association id="As_A_asg" sourceRef="E_assignchg" targetRef="A_asg"/>
    <association id="As_A_sig" sourceRef="E_signed" targetRef="A_sig"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC_83">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_PRC_83">
      <bpmndi:BPMNShape id="P_main_di" bpmnElement="P_main" isHorizontal="true"><dc:Bounds x="0" y="100" width="3040" height="480"/></bpmndi:BPMNShape>
