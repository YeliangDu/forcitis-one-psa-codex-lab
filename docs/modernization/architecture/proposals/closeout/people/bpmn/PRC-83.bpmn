      <bpmndi:BPMNEdge id="F18_di" bpmnElement="F18"><di:waypoint x="2000" y="305"/><di:waypoint x="2000" y="347"/><di:waypoint x="1520" y="347"/><di:waypoint x="1520" y="195"/></bpmndi:BPMNEdge>
