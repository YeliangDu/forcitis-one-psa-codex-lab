      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1378" y="520"/><di:waypoint x="1422" y="520"/><di:waypoint x="1422" y="160"/><di:waypoint x="1465" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1575" y="160"/><di:waypoint x="1655" y="160"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1705" y="160"/><di:waypoint x="1745" y="160"/><di:waypoint x="1745" y="280"/><di:waypoint x="1785" y="280"/></bpmndi:BPMNEdge>
