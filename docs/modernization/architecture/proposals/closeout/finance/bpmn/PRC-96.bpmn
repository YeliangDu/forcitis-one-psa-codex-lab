      <dataOutputAssociation id="DOA_S7_17_1"><sourceRef>DOut_S7_17_1</sourceRef><targetRef>SR_S7_17_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S7_gw_18" name="冲销人工成本分配运行？">
      <incoming>Flow_30</incoming>
      <outgoing>Flow_31</outgoing>
      <outgoing>Flow_32</outgoing>
      <outgoing>Flow_33</outgoing>
    </exclusiveGateway>
    <serviceTask id="S8_19" name="冲销并重过账 → B-16">
