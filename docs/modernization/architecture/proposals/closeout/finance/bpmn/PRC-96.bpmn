        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S8_19_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S8_19_1"><sourceRef>DOut_S8_19_1</sourceRef><targetRef>SR_S8_19_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S8_gw_20" name="冲销并重过账？">
      <incoming>Flow_34</incoming>
      <outgoing>Flow_35</outgoing>
      <outgoing>Flow_36</outgoing>
      <outgoing>Flow_37</outgoing>
      <outgoing>Flow_38</outgoing>
    </exclusiveGateway>
    <endEvent id="End_21" name="本期已分配">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_22" name="已拒收">
      <incoming>Flow_7</incoming>
      <incoming>Flow_19</incoming>
      <incoming>Flow_20</incoming>
      <incoming>Flow_23</incoming>
      <incoming>Flow_32</incoming>
    </endEvent>
    <endEvent id="End_23" name="未到分配条件">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_24" name="期间关账中待重试">
      <incoming>Flow_17</incoming>
      <incoming>Flow_35</incoming>
    </endEvent>
    <endEvent id="End_25" name="人工成本分配已过账">
      <incoming>Flow_18</incoming>
      <incoming>Flow_21</incoming>
    </endEvent>
    <endEvent id="End_26" name="人工成本分配已作废">
      <incoming>Flow_24</incoming>
    </endEvent>
    <endEvent id="End_27" name="冲销已驳回">
      <incoming>Flow_28</incoming>
    </endEvent>
    <endEvent id="End_28" name="已撤回">
      <incoming>Flow_29</incoming>
    </endEvent>
    <endEvent id="End_29" name="差额进下期运行">
      <incoming>Flow_31</incoming>
    </endEvent>
    <endEvent id="End_30" name="人工成本分配已冲销">
      <incoming>Flow_36</incoming>
      <incoming>Flow_38</incoming>
    </endEvent>
    <endEvent id="End_31" name="过账被拒收">
      <incoming>Flow_37</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_5"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_5"/>
    <sequenceFlow id="Flow_3" sourceRef="Start_3" targetRef="S5_12"/>
    <sequenceFlow id="Flow_4" sourceRef="Start_4" targetRef="S6_14"/>
    <sequenceFlow id="Flow_5" sourceRef="S1_5" targetRef="S1_gw_6"/>
    <sequenceFlow id="Flow_6" name="本期已有有效的人工成本分配运行（每期间一次有效）" sourceRef="S1_gw_6" targetRef="End_21"/>
    <sequenceFlow id="Flow_7" name="目标期间尚未开放（该法人无开放期间可落），拒收并告警" sourceRef="S1_gw_6" targetRef="End_22"/>
    <sequenceFlow id="Flow_8" name="工时与薪酬事实未齐备（有工时无薪酬或有薪酬无工时，预警）" sourceRef="S1_gw_6" targetRef="End_23"/>
    <sequenceFlow id="Flow_9" name="目标期间已关账，自动落当前开放期间并标原期间后继续分配" sourceRef="S1_gw_6" targetRef="S2_7"/>
    <sequenceFlow id="Flow_10" name="其他" sourceRef="S1_gw_6" targetRef="S2_7"/>
    <sequenceFlow id="Flow_11" sourceRef="S2_7" targetRef="S3_8"/>
    <sequenceFlow id="Flow_12" sourceRef="S3_8" targetRef="S3_gw_9"/>
    <sequenceFlow id="Flow_13" name="项目分配额 + 人工成本分配差异 ≠ 实际人工成本（零容差），退回重新试算" sourceRef="S3_gw_9" targetRef="S2_7"/>
    <sequenceFlow id="Flow_14" name="含跨法人人工：按员工成本法人记、标「待内部结算」，跨法人清单随确认发给财务，继续过账" sourceRef="S3_gw_9" targetRef="S4_10"/>
    <sequenceFlow id="Flow_15" name="其他" sourceRef="S3_gw_9" targetRef="S4_10"/>
    <sequenceFlow id="Flow_16" sourceRef="S4_10" targetRef="S4_gw_11"/>
    <sequenceFlow id="Flow_17" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S4_gw_11" targetRef="End_24"/>
    <sequenceFlow id="Flow_18" name="落账期间已关账且该法人有开放期间，自动落当前开放期间并标原期间" sourceRef="S4_gw_11" targetRef="End_25"/>
    <sequenceFlow id="Flow_19" name="该法人无开放期间可落（过账管道拒收），拒收并告警" sourceRef="S4_gw_11" targetRef="End_22"/>
    <sequenceFlow id="Flow_20" name="过账管道拒收（借贷不平或法人不一致），拒收并告警" sourceRef="S4_gw_11" targetRef="End_22"/>
    <sequenceFlow id="Flow_21" name="其他" sourceRef="S4_gw_11" targetRef="End_25"/>
    <sequenceFlow id="Flow_22" sourceRef="S5_12" targetRef="S5_gw_13"/>
    <sequenceFlow id="Flow_23" name="该运行已过账，不能作废（改走冲销）" sourceRef="S5_gw_13" targetRef="End_22"/>
    <sequenceFlow id="Flow_24" name="其他" sourceRef="S5_gw_13" targetRef="End_26"/>
    <sequenceFlow id="Flow_25" sourceRef="S6_14" targetRef="S6_api_15"/>
    <sequenceFlow id="Flow_26" sourceRef="S6_api_15" targetRef="S6_gw_16"/>
    <sequenceFlow id="Flow_27" name="通过" sourceRef="S6_gw_16" targetRef="S7_17"/>
    <sequenceFlow id="Flow_28" name="驳回" sourceRef="S6_gw_16" targetRef="End_27"/>
    <sequenceFlow id="Flow_29" name="撤回" sourceRef="S6_gw_16" targetRef="End_28"/>
    <sequenceFlow id="Flow_30" sourceRef="S7_17" targetRef="S7_gw_18"/>
    <sequenceFlow id="Flow_31" name="原运行所属期间已关账，不再冲原运行，差额进下期运行" sourceRef="S7_gw_18" targetRef="End_29"/>
    <sequenceFlow id="Flow_32" name="该运行已冲销过" sourceRef="S7_gw_18" targetRef="End_22"/>
    <sequenceFlow id="Flow_33" name="其他" sourceRef="S7_gw_18" targetRef="S8_19"/>
    <sequenceFlow id="Flow_34" sourceRef="S8_19" targetRef="S8_gw_20"/>
    <sequenceFlow id="Flow_35" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S8_gw_20" targetRef="End_24"/>
    <sequenceFlow id="Flow_36" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S8_gw_20" targetRef="End_30"/>
    <sequenceFlow id="Flow_37" name="过账管道拒收（原事实不存在或已被冲销、该法人无开放期间、借贷不平），拒收并告警" sourceRef="S8_gw_20" targetRef="End_31"/>
    <sequenceFlow id="Flow_38" name="其他" sourceRef="S8_gw_20" targetRef="End_30"/>
    <dataStoreReference id="SR_S1_5_r1" name="AGG-77" dataStoreRef="DS_AGG-77"/>
    <dataStoreReference id="SR_S1_5_r2" name="AGG-81" dataStoreRef="DS_AGG-81"/>
    <dataStoreReference id="SR_S2_7_w1" name="AGG-41" dataStoreRef="DS_AGG-41"/>
    <dataStoreReference id="SR_S3_8_w1" name="AGG-41" dataStoreRef="DS_AGG-41"/>
