    <dataStoreReference id="SR_S7_17_w1" name="AGG-41" dataStoreRef="DS_AGG-41"/>
    <dataStoreReference id="SR_S8_19_w1" name="AGG-77" dataStoreRef="DS_AGG-77"/>
  </process>
