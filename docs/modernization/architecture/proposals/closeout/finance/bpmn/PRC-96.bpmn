    <sequenceFlow id="Flow_5" sourceRef="Start_5" targetRef="S9_22"/>
    <sequenceFlow id="Flow_6" sourceRef="S1_6" targetRef="S1_gw_7"/>
    <sequenceFlow id="Flow_7" name="本期已有有效的人工成本分配运行（每期间一次有效）" sourceRef="S1_gw_7" targetRef="End_26"/>
    <sequenceFlow id="Flow_8" name="目标期间尚未开放（该法人无开放期间可落），拒收并告警" sourceRef="S1_gw_7" targetRef="End_27"/>
    <sequenceFlow id="Flow_9" name="工时与薪酬事实未齐备（有工时无薪酬或有薪酬无工时，预警）" sourceRef="S1_gw_7" targetRef="End_28"/>
    <sequenceFlow id="Flow_10" name="目标期间已关账，自动落当前开放期间并标原期间后继续分配" sourceRef="S1_gw_7" targetRef="S2_8"/>
    <sequenceFlow id="Flow_11" name="其他" sourceRef="S1_gw_7" targetRef="S2_8"/>
    <sequenceFlow id="Flow_12" sourceRef="S2_8" targetRef="S3_9"/>
    <sequenceFlow id="Flow_13" sourceRef="S3_9" targetRef="S3_gw_10"/>
    <sequenceFlow id="Flow_14" name="项目分配额 + 人工成本分配差异 ≠ 实际人工成本（零容差），退回重新试算" sourceRef="S3_gw_10" targetRef="S2_8"/>
    <sequenceFlow id="Flow_15" name="含跨法人人工：按员工成本法人记、标「待内部结算」，跨法人清单随确认发给财务，继续过账" sourceRef="S3_gw_10" targetRef="S4_11"/>
    <sequenceFlow id="Flow_16" name="其他" sourceRef="S3_gw_10" targetRef="S4_11"/>
    <sequenceFlow id="Flow_17" sourceRef="S4_11" targetRef="S4_gw_12"/>
    <sequenceFlow id="Flow_18" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S4_gw_12" targetRef="End_29"/>
    <sequenceFlow id="Flow_19" name="落账期间已关账且该法人有开放期间，自动落当前开放期间并标原期间" sourceRef="S4_gw_12" targetRef="End_30"/>
    <sequenceFlow id="Flow_20" name="该法人无开放期间可落（过账管道拒收），拒收并告警" sourceRef="S4_gw_12" targetRef="End_27"/>
    <sequenceFlow id="Flow_21" name="过账管道拒收（借贷不平或法人不一致），拒收并告警" sourceRef="S4_gw_12" targetRef="End_27"/>
    <sequenceFlow id="Flow_22" name="其他" sourceRef="S4_gw_12" targetRef="End_30"/>
    <sequenceFlow id="Flow_23" sourceRef="S5_13" targetRef="S5_gw_14"/>
    <sequenceFlow id="Flow_24" name="该运行已过账，不能作废（改走冲销）" sourceRef="S5_gw_14" targetRef="End_27"/>
    <sequenceFlow id="Flow_25" name="其他" sourceRef="S5_gw_14" targetRef="End_31"/>
    <sequenceFlow id="Flow_26" sourceRef="S6_15" targetRef="S6_api_16"/>
    <sequenceFlow id="Flow_27" sourceRef="S6_api_16" targetRef="S6_gw_17"/>
    <sequenceFlow id="Flow_28" name="通过" sourceRef="S6_gw_17" targetRef="S7_18"/>
    <sequenceFlow id="Flow_29" name="驳回" sourceRef="S6_gw_17" targetRef="End_32"/>
    <sequenceFlow id="Flow_30" name="撤回" sourceRef="S6_gw_17" targetRef="End_33"/>
    <sequenceFlow id="Flow_31" sourceRef="S7_18" targetRef="S7_gw_19"/>
    <sequenceFlow id="Flow_32" name="原运行所属期间已关账，不再冲原运行，差额进下期运行" sourceRef="S7_gw_19" targetRef="End_34"/>
    <sequenceFlow id="Flow_33" name="该运行已冲销过" sourceRef="S7_gw_19" targetRef="End_27"/>
    <sequenceFlow id="Flow_34" name="其他" sourceRef="S7_gw_19" targetRef="S8_20"/>
    <sequenceFlow id="Flow_35" sourceRef="S8_20" targetRef="S8_gw_21"/>
    <sequenceFlow id="Flow_36" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S8_gw_21" targetRef="End_29"/>
    <sequenceFlow id="Flow_37" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S8_gw_21" targetRef="End_35"/>
    <sequenceFlow id="Flow_38" name="过账管道拒收（原事实不存在或已被冲销、该法人无开放期间、借贷不平），拒收并告警" sourceRef="S8_gw_21" targetRef="End_36"/>
    <sequenceFlow id="Flow_39" name="其他" sourceRef="S8_gw_21" targetRef="End_35"/>
    <sequenceFlow id="Flow_40" sourceRef="S9_22" targetRef="S9_gw_23"/>
