<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-64" targetNamespace="https://forcitis.one/bpmn/PRC-64" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="银行文件已到达"/>
  <dataStore id="DS_AGG-88" name="AGG-88"/>
  <collaboration id="Collab_PRC-64">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-64"/>
    <participant id="Pool_1" name="银行"/>
    <messageFlow id="Msg_1" name="导入银行流水" sourceRef="S1_3" targetRef="Pool_1"/>
    <messageFlow id="Msg_2" name="银行返回结果" sourceRef="Pool_1" targetRef="S1_recv_6"/>
  </collaboration>
  <process id="PRC-64" name="导入银行流水" isExecutable="false">
    <documentation>owner B-22；VS-04.4、VS-05.5</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S1_3_esc_5</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S1_recv_6</flowNodeRef>
        <flowNodeRef>S1_gw_7</flowNodeRef>
        <flowNodeRef>S2_8</flowNodeRef>
        <flowNodeRef>S2_gw_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
        <flowNodeRef>End_15</flowNodeRef>
        <flowNodeRef>S1_3_bd_4</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="每日定时拉取银行流水文件">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <startEvent id="Start_2" name="银行文件已到达">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <sendTask id="S1_3" name="导入银行流水 → platform.integration">
      <documentation>AGG-88 导入银行流水；B-22；external:银行</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataOutput id="DOut_S1_3_1"/>
        <dataOutput id="DOut_S1_3_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs><dataOutputRefs>DOut_S1_3_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>SR_S1_3_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S1_3_2"><sourceRef>DOut_S1_3_2</sourceRef><targetRef>OR_S1_3_1</targetRef></dataOutputAssociation>
    </sendTask>
    <boundaryEvent id="S1_3_bd_4" name="期限 P1D" cancelActivity="false" attachedToRef="S1_3">
      <outgoing>Flow_8</outgoing>
      <timerEventDefinition><timeDuration>P1D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S1_3_esc_5" name="处理超时：导入银行流水">
      <documentation>升级给 SH-E6；期限 P1D</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S1_3_esc_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <intermediateCatchEvent id="S1_recv_6" name="银行返回结果">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <exclusiveGateway id="S1_gw_7" name="导入银行流水？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_8" name="提交过账候选 → B-16">
      <documentation>AGG-88 提交过账候选；B-22；automatic；调用 PRC-92</documentation>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_8">
        <dataOutput id="DOut_S2_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_8_1"><sourceRef>DOut_S2_8_1</sourceRef><targetRef>SR_S2_8_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S2_gw_9" name="提交过账候选？">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_13</outgoing>
      <outgoing>Flow_14</outgoing>
      <outgoing>Flow_15</outgoing>
    </exclusiveGateway>
    <endEvent id="End_10" name="重复文件已忽略">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_11" name="文件已拒收">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_12" name="已提醒">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_13" name="流水已导入">
      <incoming>Flow_11</incoming>
      <incoming>Flow_13</incoming>
      <incoming>Flow_15</incoming>
    </endEvent>
    <endEvent id="End_14" name="期间关账中待重试">
      <incoming>Flow_12</incoming>
    </endEvent>
    <endEvent id="End_15" name="过账被拒收">
      <incoming>Flow_14</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S1_recv_6"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_recv_6" targetRef="S1_gw_7"/>
    <sequenceFlow id="Flow_5" name="银行文件校验和已导入过" sourceRef="S1_gw_7" targetRef="End_10"/>
    <sequenceFlow id="Flow_6" name="文件无法解析、资金账户未登记或与账户不符 → 拒收并告警" sourceRef="S1_gw_7" targetRef="End_11"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S1_gw_7" targetRef="S2_8"/>
    <sequenceFlow id="Flow_8" sourceRef="S1_3_bd_4" targetRef="S1_3_esc_5"/>
    <sequenceFlow id="Flow_9" sourceRef="S1_3_esc_5" targetRef="End_12"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_8" targetRef="S2_gw_9"/>
    <sequenceFlow id="Flow_11" name="文件中没有利息或手续费行" sourceRef="S2_gw_9" targetRef="End_13"/>
    <sequenceFlow id="Flow_12" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S2_gw_9" targetRef="End_14"/>
    <sequenceFlow id="Flow_13" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S2_gw_9" targetRef="End_13"/>
    <sequenceFlow id="Flow_14" name="过账管道拒收（该法人无开放期间、借贷不平或法人不一致），拒收并告警" sourceRef="S2_gw_9" targetRef="End_15"/>
    <sequenceFlow id="Flow_15" name="其他" sourceRef="S2_gw_9" targetRef="End_13"/>
    <dataStoreReference id="SR_S1_3_w1" name="AGG-88" dataStoreRef="DS_AGG-88"/>
    <dataObject id="DObj_OR_S1_3_1"/>
    <dataObjectReference id="OR_S1_3_1" name="银行原始流水文件" dataObjectRef="DObj_OR_S1_3_1"/>
    <dataStoreReference id="SR_S2_8_w1" name="AGG-88" dataStoreRef="DS_AGG-88"/>
  </process>
