<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-97" targetNamespace="https://forcitis.one/bpmn/PRC-97" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-40" name="AGG-40"/>
  <collaboration id="Collab_PRC-97">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-97"/>
  </collaboration>
  <process id="PRC-97" name="批准并生效分摊规则版本" isExecutable="false">
    <documentation>owner B-07；VS-10.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_4</flowNodeRef>
        <flowNodeRef>S3_10</flowNodeRef>
        <flowNodeRef>S3_gw_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>End_16</flowNodeRef>
      </lane>
      <lane id="Lane_审批人上级" name="审批人上级（审批人上级）">
        <flowNodeRef>S2_5_esc_7</flowNodeRef>
        <flowNodeRef>End_15</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_3</flowNodeRef>
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_api_8</flowNodeRef>
        <flowNodeRef>S2_gw_9</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
        <flowNodeRef>S2_5_bd_6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="财务编制分摊规则版本（按期间首日发布）">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="〔缺〕编制分摊规则版本">
      <documentation>AGG-40 〔缺〕编制分摊规则版本；B-07；in_system；成本.分摊规则编制；分摊规则编辑页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S1_api_3" name="读组织单元 → B-13">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_3">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="〔缺〕编制分摊规则版本？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <userTask id="S2_5" name="批准分摊规则版本">
      <documentation>AGG-40 批准分摊规则版本；B-07；in_system；分摊规则.审批；审批待办（审批平台）；审批平台：分摊规则审批</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S2_5_bd_6" name="期限 P3D" cancelActivity="false" attachedToRef="S2_5">
      <outgoing>Flow_11</outgoing>
      <timerEventDefinition><timeDuration>P3D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_5_esc_7" name="处理超时：批准分摊规则版本">
      <documentation>升级给 审批人上级；期限 P3D</documentation>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S2_5_esc_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S2_api_8" name="提交审批 → platform.approval">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_api_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_9" name="批准分摊规则版本？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <userTask id="S3_10" name="生效分摊规则版本">
      <documentation>AGG-40 生效分摊规则版本；B-07；in_system；成本.分摊规则生效；分摊规则生效页</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_13</outgoing>
      <ioSpecification id="IO_S3_10">
        <dataOutput id="DOut_S3_10_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_10_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_10_1"><sourceRef>DOut_S3_10_1</sourceRef><targetRef>SR_S3_10_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_11" name="生效分摊规则版本？">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <outgoing>Flow_15</outgoing>
    </exclusiveGateway>
    <endEvent id="End_12" name="已拒收">
      <incoming>Flow_4</incoming>
      <incoming>Flow_14</incoming>
    </endEvent>
    <endEvent id="End_13" name="已驳回">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_14" name="已撤回">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_15" name="已提醒">
      <incoming>Flow_12</incoming>
    </endEvent>
    <endEvent id="End_16" name="分摊规则已生效">
      <incoming>Flow_15</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_api_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_api_3" targetRef="S1_gw_4"/>
    <sequenceFlow id="Flow_4" name="规则引用的组织单元不存在或已失效，拒收并告警" sourceRef="S1_gw_4" targetRef="End_12"/>
    <sequenceFlow id="Flow_5" name="其他" sourceRef="S1_gw_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_5" targetRef="S2_api_8"/>
    <sequenceFlow id="Flow_7" sourceRef="S2_api_8" targetRef="S2_gw_9"/>
    <sequenceFlow id="Flow_8" name="通过" sourceRef="S2_gw_9" targetRef="S3_10"/>
    <sequenceFlow id="Flow_9" name="驳回" sourceRef="S2_gw_9" targetRef="End_13"/>
    <sequenceFlow id="Flow_10" name="撤回" sourceRef="S2_gw_9" targetRef="End_14"/>
    <sequenceFlow id="Flow_11" sourceRef="S2_5_bd_6" targetRef="S2_5_esc_7"/>
    <sequenceFlow id="Flow_12" sourceRef="S2_5_esc_7" targetRef="End_15"/>
    <sequenceFlow id="Flow_13" sourceRef="S3_10" targetRef="S3_gw_11"/>
    <sequenceFlow id="Flow_14" name="生效日不是期间首日或早于当前开放期间首日（不追溯），拒收并告警" sourceRef="S3_gw_11" targetRef="End_12"/>
    <sequenceFlow id="Flow_15" name="其他" sourceRef="S3_gw_11" targetRef="End_16"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-40" dataStoreRef="DS_AGG-40"/>
    <dataStoreReference id="SR_S2_5_w1" name="AGG-40" dataStoreRef="DS_AGG-40"/>
    <dataStoreReference id="SR_S3_10_w1" name="AGG-40" dataStoreRef="DS_AGG-40"/>
  </process>
