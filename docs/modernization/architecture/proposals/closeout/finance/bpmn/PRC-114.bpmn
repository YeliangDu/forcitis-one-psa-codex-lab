<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-114" targetNamespace="https://forcitis.one/bpmn/PRC-114" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-54" name="AGG-54"/>
  <dataStore id="DS_AGG-52" name="AGG-52"/>
  <collaboration id="Collab_PRC-114">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-114"/>
    <participant id="Pool_1" name="股东和合伙人（SH-O1）"/>
    <messageFlow id="Msg_1" name="减资或退伙决议" sourceRef="Pool_1" targetRef="S1_2"/>
  </collaboration>
  <process id="PRC-114" name="退回合伙人出资" isExecutable="false">
    <documentation>owner B-10；VS-12.3</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_3</flowNodeRef>
        <flowNodeRef>End_7</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S3_5</flowNodeRef>
        <flowNodeRef>S3_gw_6</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="股东或合伙人申请部分或全部退回出资">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="登记出资退回">
      <documentation>AGG-54 登记出资退回；B-10；in_system；出资.登记退回；出资退回登记页；审批（external）：减资或退伙决议</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S1_gw_3" name="登记出资退回？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_4" name="确认应付">
      <documentation>AGG-52 确认应付；B-10；automatic</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <serviceTask id="S3_5" name="提交过账候选 → B-16">
      <documentation>AGG-54 提交过账候选；B-10；automatic；调用 PRC-92</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S3_5">
        <dataOutput id="DOut_S3_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_5_1"><sourceRef>DOut_S3_5_1</sourceRef><targetRef>SR_S3_5_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S3_gw_6" name="提交过账候选？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_13</outgoing>
    </exclusiveGateway>
    <endEvent id="End_7" name="申请未通过">
      <incoming>Flow_3</incoming>
    </endEvent>
    <endEvent id="End_8" name="已拒收">
      <incoming>Flow_4</incoming>
    </endEvent>
    <endEvent id="End_9" name="过账被拒收">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_10" name="期间关账中待重试">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_11" name="已退回">
      <incoming>Flow_10</incoming>
      <incoming>Flow_12</incoming>
    </endEvent>
    <endEvent id="End_12" name="已部分退回">
      <incoming>Flow_11</incoming>
      <incoming>Flow_13</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_3"/>
    <sequenceFlow id="Flow_3" name="申请被撤回，或减资、退伙决议未通过" sourceRef="S1_gw_3" targetRef="End_7"/>
    <sequenceFlow id="Flow_4" name="退回额超过已实缴额" sourceRef="S1_gw_3" targetRef="End_8"/>
    <sequenceFlow id="Flow_5" name="其他" sourceRef="S1_gw_3" targetRef="S2_4"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_4" targetRef="S3_5"/>
    <sequenceFlow id="Flow_7" sourceRef="S3_5" targetRef="S3_gw_6"/>
    <sequenceFlow id="Flow_8" name="过账管道拒收（该法人无开放期间、借贷不平或法人不一致），拒收并告警" sourceRef="S3_gw_6" targetRef="End_9"/>
    <sequenceFlow id="Flow_9" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S3_gw_6" targetRef="End_10"/>
    <sequenceFlow id="Flow_10" name="所属期间已关账且退回后已实缴余额为零，自动落当前开放期间并标原期间" sourceRef="S3_gw_6" targetRef="End_11"/>
    <sequenceFlow id="Flow_11" name="所属期间已关账且退回后仍有已实缴余额，自动落当前开放期间并标原期间" sourceRef="S3_gw_6" targetRef="End_12"/>
    <sequenceFlow id="Flow_12" name="退回后已实缴余额为零" sourceRef="S3_gw_6" targetRef="End_11"/>
    <sequenceFlow id="Flow_13" name="其他" sourceRef="S3_gw_6" targetRef="End_12"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-54" dataStoreRef="DS_AGG-54"/>
    <dataStoreReference id="SR_S2_4_w1" name="AGG-52" dataStoreRef="DS_AGG-52"/>
    <dataStoreReference id="SR_S3_5_w1" name="AGG-54" dataStoreRef="DS_AGG-54"/>
  </process>
