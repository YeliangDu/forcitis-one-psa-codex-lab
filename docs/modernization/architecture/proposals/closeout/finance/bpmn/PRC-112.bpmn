  <bpmndi:BPMNDiagram id="Diagram_PRC-112">
    <bpmndi:BPMNPlane id="Plane_PRC-112" bpmnElement="Collab_PRC-112">
      <bpmndi:BPMNShape id="Shape_P_main" bpmnElement="P_main" isHorizontal="true">
