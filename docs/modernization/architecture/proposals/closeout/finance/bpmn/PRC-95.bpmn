        <flowNodeRef>End_23</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="月末业务过账完成后，到点创建待办（platform.scheduling）">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <startEvent id="Start_2" name="已过账的期末结转运行需更正，财务发起冲销">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="读取本期分录与余额">
      <documentation>读取本期分录与余额；B-20；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
    </serviceTask>
    <userTask id="S2_4" name="生成期末结转运行">
      <documentation>AGG-99 生成期末结转运行；B-20；in_system；总账.生成期末结转运行；期末结转运行页</documentation>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S2_4">
        <dataOutput id="DOut_S2_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_4_1"><sourceRef>DOut_S2_4_1</sourceRef><targetRef>SR_S2_4_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_5" name="生成期末结转运行？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_6" name="提交过账候选 → B-16">
      <documentation>AGG-99 提交过账候选；B-20；automatic；调用 PRC-92</documentation>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S3_6">
        <dataOutput id="DOut_S3_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_6_1"><sourceRef>DOut_S3_6_1</sourceRef><targetRef>SR_S3_6_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S3_gw_7" name="提交过账候选？">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <userTask id="S4_8" name="期末结转运行冲销审批">
      <documentation>期末结转运行冲销审批；B-20；in_system；总账.冲销审批；审批待办（审批平台）；审批平台：期末结转运行冲销审批</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_11</outgoing>
      <ioSpecification id="IO_S4_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S4_api_9" name="提交审批 → platform.approval">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S4_api_9">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S4_gw_10" name="期末结转运行冲销审批？">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
      <outgoing>Flow_14</outgoing>
      <outgoing>Flow_15</outgoing>
    </exclusiveGateway>
    <userTask id="S5_11" name="冲销期末结转运行">
      <documentation>AGG-99 冲销期末结转运行；B-20；in_system；总账.冲销；期末结转运行冲销页</documentation>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_16</outgoing>
      <ioSpecification id="IO_S5_11">
        <dataOutput id="DOut_S5_11_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_11_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_11_1"><sourceRef>DOut_S5_11_1</sourceRef><targetRef>SR_S5_11_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S5_gw_12" name="冲销期末结转运行？">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <outgoing>Flow_18</outgoing>
      <outgoing>Flow_19</outgoing>
    </exclusiveGateway>
    <serviceTask id="S6_13" name="冲销并重过账 → B-16">
      <documentation>AGG-77 冲销并重过账；B-20；automatic；调用 PRC-92</documentation>
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
      <ioSpecification id="IO_S6_13">
        <dataOutput id="DOut_S6_13_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S6_13_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S6_13_1"><sourceRef>DOut_S6_13_1</sourceRef><targetRef>SR_S6_13_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S6_gw_14" name="冲销并重过账？">
      <incoming>Flow_20</incoming>
      <outgoing>Flow_21</outgoing>
      <outgoing>Flow_22</outgoing>
      <outgoing>Flow_23</outgoing>
      <outgoing>Flow_24</outgoing>
    </exclusiveGateway>
    <endEvent id="End_15" name="已有有效运行">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_16" name="已拒收">
      <incoming>Flow_6</incoming>
      <incoming>Flow_9</incoming>
      <incoming>Flow_18</incoming>
    </endEvent>
    <endEvent id="End_17" name="已过账">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_18" name="冲销已驳回">
      <incoming>Flow_14</incoming>
    </endEvent>
    <endEvent id="End_19" name="已撤回">
      <incoming>Flow_15</incoming>
    </endEvent>
    <endEvent id="End_20" name="差额进下期运行">
      <incoming>Flow_17</incoming>
    </endEvent>
    <endEvent id="End_21" name="期间关账中待重试">
      <incoming>Flow_21</incoming>
    </endEvent>
    <endEvent id="End_22" name="期末结转已冲销">
      <incoming>Flow_22</incoming>
      <incoming>Flow_24</incoming>
    </endEvent>
    <endEvent id="End_23" name="过账被拒收">
      <incoming>Flow_23</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S4_8"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S2_4"/>
