    <sequenceFlow id="Flow_5" name="本法人本期间本模板已有有效运行" sourceRef="S2_gw_5" targetRef="End_15"/>
    <sequenceFlow id="Flow_6" name="期末结转运行按（法人, 期间, 模板）显式指定期间，所指期间未开放（已关账或关账中），拒绝并告警（INV-92 写法，不是例外）" sourceRef="S2_gw_5" targetRef="End_16"/>
    <sequenceFlow id="Flow_7" name="其他" sourceRef="S2_gw_5" targetRef="S3_6"/>
    <sequenceFlow id="Flow_8" sourceRef="S3_6" targetRef="S3_gw_7"/>
    <sequenceFlow id="Flow_9" name="过账管道拒收（借贷不平、无开放期间），拒收并告警" sourceRef="S3_gw_7" targetRef="End_16"/>
    <sequenceFlow id="Flow_10" name="其他" sourceRef="S3_gw_7" targetRef="End_17"/>
    <sequenceFlow id="Flow_11" sourceRef="S4_8" targetRef="S4_api_9"/>
    <sequenceFlow id="Flow_12" sourceRef="S4_api_9" targetRef="S4_gw_10"/>
    <sequenceFlow id="Flow_13" name="通过" sourceRef="S4_gw_10" targetRef="S5_11"/>
    <sequenceFlow id="Flow_14" name="驳回" sourceRef="S4_gw_10" targetRef="End_18"/>
    <sequenceFlow id="Flow_15" name="撤回" sourceRef="S4_gw_10" targetRef="End_19"/>
    <sequenceFlow id="Flow_16" sourceRef="S5_11" targetRef="S5_gw_12"/>
    <sequenceFlow id="Flow_17" name="原运行所属期间已关账，不再冲原运行，差额进下期运行" sourceRef="S5_gw_12" targetRef="End_20"/>
    <sequenceFlow id="Flow_18" name="该运行已冲销过" sourceRef="S5_gw_12" targetRef="End_16"/>
    <sequenceFlow id="Flow_19" name="其他" sourceRef="S5_gw_12" targetRef="S6_13"/>
    <sequenceFlow id="Flow_20" sourceRef="S6_13" targetRef="S6_gw_14"/>
    <sequenceFlow id="Flow_21" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S6_gw_14" targetRef="End_21"/>
    <sequenceFlow id="Flow_22" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S6_gw_14" targetRef="End_22"/>
    <sequenceFlow id="Flow_23" name="过账管道拒收（原事实不存在或已被冲销、该法人无开放期间、借贷不平），拒收并告警" sourceRef="S6_gw_14" targetRef="End_23"/>
    <sequenceFlow id="Flow_24" name="其他" sourceRef="S6_gw_14" targetRef="End_22"/>
    <dataStoreReference id="SR_S1_3_r1" name="AGG-84" dataStoreRef="DS_AGG-84"/>
    <dataStoreReference id="SR_S2_4_w1" name="AGG-99" dataStoreRef="DS_AGG-99"/>
