  <process id="PRC-95" name="执行期末结转" isExecutable="false">
    <documentation>owner B-20；VS-10.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S2_4</flowNodeRef>
        <flowNodeRef>S2_gw_5</flowNodeRef>
        <flowNodeRef>S5_11</flowNodeRef>
        <flowNodeRef>S5_gw_12</flowNodeRef>
