      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_system" bpmnElement="Lane_system" isHorizontal="true">
        <dc:Bounds x="30" y="130" width="1110" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="87" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S1_2" bpmnElement="S1_2">
        <dc:Bounds x="185" y="165" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_3" bpmnElement="S2_3">
        <dc:Bounds x="355" y="35" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S2_gw_4" bpmnElement="S2_gw_4" isMarkerVisible="true">
