        <bpmndi:BPMNLabel><dc:Bounds x="750" y="136" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_7" bpmnElement="End_7">
        <dc:Bounds x="867" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_8" bpmnElement="End_8">
        <dc:Bounds x="957" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_9" bpmnElement="End_9">
        <dc:Bounds x="1047" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_2_r1" bpmnElement="SR_S1_2_r1">
        <dc:Bounds x="217" y="134" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_3_w1" bpmnElement="SR_S2_3_w1">
        <dc:Bounds x="387" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S3_5_w1" bpmnElement="SR_S3_5_w1">
        <dc:Bounds x="647" y="134" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="123" y="195"/>
        <di:waypoint x="185" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="285" y="195"/>
        <di:waypoint x="335" y="195"/>
        <di:waypoint x="335" y="65"/>
        <di:waypoint x="355" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="455" y="65"/>
        <di:waypoint x="510" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="560" y="65"/>
        <di:waypoint x="867" y="65"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="535" y="90"/>
        <di:waypoint x="535" y="124"/>
        <di:waypoint x="975" y="124"/>
