  <dataStore id="DS_AGG-42" name="AGG-42"/>
  <collaboration id="Collab_PRC-98">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-98"/>
  </collaboration>
  <process id="PRC-98" name="分摊间接成本" isExecutable="false">
    <documentation>owner B-07；VS-10.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_gw_8</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_3</flowNodeRef>
        <flowNodeRef>S1_api_4</flowNodeRef>
        <flowNodeRef>S2_api_7</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="月末（期间关账前）">
      <outgoing>Flow_1</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <userTask id="S1_2" name="试算分摊运行">
      <documentation>AGG-42 试算分摊运行；B-07；in_system；成本.分摊运行试算；分摊运行试算页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S1_api_3" name="读过账事实 → B-16">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_3">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <serviceTask id="S1_api_4" name="读会计期间 → B-19">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_api_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S1_gw_5" name="试算分摊运行？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <userTask id="S2_6" name="生效分摊运行">
      <documentation>AGG-42 生效分摊运行；B-07；in_system；成本.分摊运行生效；分摊运行生效页</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataOutput id="DOut_S2_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_6_1"><sourceRef>DOut_S2_6_1</sourceRef><targetRef>SR_S2_6_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_api_7" name="读会计期间 → B-19">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_api_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_8" name="生效分摊运行？">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
    </exclusiveGateway>
    <endEvent id="End_9" name="本期已分摊">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_10" name="已拒收">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_11" name="已结转下期">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_12" name="分摊已生效">
      <incoming>Flow_12</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_api_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_api_3" targetRef="S1_api_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_api_4" targetRef="S1_gw_5"/>
    <sequenceFlow id="Flow_5" name="本期间已有有效的全量分摊运行" sourceRef="S1_gw_5" targetRef="End_9"/>
    <sequenceFlow id="Flow_6" name="期间内没有生效的分摊规则版本，拒收并告警" sourceRef="S1_gw_5" targetRef="End_10"/>
    <sequenceFlow id="Flow_7" name="分摊基数为零，结转下期" sourceRef="S1_gw_5" targetRef="End_11"/>
    <sequenceFlow id="Flow_8" name="其他" sourceRef="S1_gw_5" targetRef="S2_6"/>
    <sequenceFlow id="Flow_9" sourceRef="S2_6" targetRef="S2_api_7"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_api_7" targetRef="S2_gw_8"/>
    <sequenceFlow id="Flow_11" name="分摊合计不等于池金额" sourceRef="S2_gw_8" targetRef="S1_2"/>
    <sequenceFlow id="Flow_12" name="其他" sourceRef="S2_gw_8" targetRef="End_12"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-42" dataStoreRef="DS_AGG-42"/>
    <dataStoreReference id="SR_S2_6_w1" name="AGG-42" dataStoreRef="DS_AGG-42"/>
  </process>
