    <sequenceFlow id="Flow_20" sourceRef="S4_13" targetRef="S4_gw_14"/>
    <sequenceFlow id="Flow_21" name="原运行所属期间已关账，不再冲原运行，差额进下期运行" sourceRef="S4_gw_14" targetRef="End_23"/>
    <sequenceFlow id="Flow_22" name="该运行已冲销过" sourceRef="S4_gw_14" targetRef="End_18"/>
    <sequenceFlow id="Flow_23" name="其他" sourceRef="S4_gw_14" targetRef="S5_15"/>
    <sequenceFlow id="Flow_24" sourceRef="S5_15" targetRef="S5_gw_16"/>
    <sequenceFlow id="Flow_25" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S5_gw_16" targetRef="End_24"/>
    <sequenceFlow id="Flow_26" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S5_gw_16" targetRef="End_25"/>
    <sequenceFlow id="Flow_27" name="过账管道拒收（原事实不存在或已被冲销、该法人无开放期间、借贷不平），拒收并告警" sourceRef="S5_gw_16" targetRef="End_26"/>
    <sequenceFlow id="Flow_28" name="其他" sourceRef="S5_gw_16" targetRef="End_25"/>
