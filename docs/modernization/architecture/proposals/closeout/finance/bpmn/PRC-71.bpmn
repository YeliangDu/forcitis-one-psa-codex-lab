    <sequenceFlow id="Flow_15" name="变更后协议金额低于已确认的履约累计（INV-82，AGG-58 一侧校验，生效前先读）" sourceRef="S3_gw_10" targetRef="End_14"/>
    <sequenceFlow id="Flow_16" name="双方最终未签署变更协议，经办人放弃" sourceRef="S3_gw_10" targetRef="End_15"/>
    <sequenceFlow id="Flow_17" name="其他" sourceRef="S3_gw_10" targetRef="S4_11"/>
    <sequenceFlow id="Flow_18" sourceRef="S4_11" targetRef="S5_12"/>
    <sequenceFlow id="Flow_19" sourceRef="S5_12" targetRef="S5_gw_13"/>
    <sequenceFlow id="Flow_20" name="该变更已更新过额度（事件重复）" sourceRef="S5_gw_13" targetRef="End_19"/>
    <sequenceFlow id="Flow_21" name="其他" sourceRef="S5_gw_13" targetRef="End_20"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-56" dataStoreRef="DS_AGG-56"/>
