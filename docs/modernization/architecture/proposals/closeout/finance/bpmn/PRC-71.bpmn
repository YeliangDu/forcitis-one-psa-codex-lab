        <flowNodeRef>End_19</flowNodeRef>
        <flowNodeRef>End_20</flowNodeRef>
        <flowNodeRef>S2_4_bd_5</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="项目经理提出分包范围或价款变更">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="提出分包变更">
      <documentation>AGG-56 提出分包变更；B-11；in_system；分包变更.提出；分包变更编辑页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S1_gw_3" name="提出分包变更？">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <userTask id="S2_4" name="提交审批">
      <documentation>提交审批；B-11；in_system；分包变更.审批；审批待办（审批平台）；审批平台：分包变更审批</documentation>
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S2_4_bd_5" name="期限 P3D" cancelActivity="false" attachedToRef="S2_4">
      <outgoing>Flow_11</outgoing>
      <timerEventDefinition><timeDuration>P3D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_4_esc_6" name="处理超时：提交审批">
      <documentation>升级给 审批人上级；期限 P3D</documentation>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_12</outgoing>
      <ioSpecification id="IO_S2_4_esc_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S2_api_7" name="提交审批 → platform.approval">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_api_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_8" name="提交审批？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
    </exclusiveGateway>
    <userTask id="S3_9" name="生效分包变更">
