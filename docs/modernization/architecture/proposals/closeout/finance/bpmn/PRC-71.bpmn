    <serviceTask id="S5_12" name="供方额度更新">
      <documentation>AGG-58 供方额度更新；B-11；automatic</documentation>
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
      <ioSpecification id="IO_S5_12">
        <dataOutput id="DOut_S5_12_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_12_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_12_1"><sourceRef>DOut_S5_12_1</sourceRef><targetRef>SR_S5_12_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S5_gw_13" name="供方额度更新？">
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
      <outgoing>Flow_21</outgoing>
    </exclusiveGateway>
    <endEvent id="End_14" name="已拒收">
      <incoming>Flow_3</incoming>
      <incoming>Flow_14</incoming>
      <incoming>Flow_15</incoming>
    </endEvent>
    <endEvent id="End_15" name="已放弃">
      <incoming>Flow_4</incoming>
      <incoming>Flow_16</incoming>
    </endEvent>
    <endEvent id="End_16" name="已驳回">
      <incoming>Flow_9</incoming>
    </endEvent>
    <endEvent id="End_17" name="已撤回">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_18" name="已提醒">
      <incoming>Flow_12</incoming>
    </endEvent>
    <endEvent id="End_19" name="重复事件已忽略">
      <incoming>Flow_20</incoming>
    </endEvent>
    <endEvent id="End_20" name="分包变更已生效">
      <incoming>Flow_21</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_gw_3"/>
    <sequenceFlow id="Flow_3" name="原供方协议未生效，或已完成、已结算、已终止" sourceRef="S1_gw_3" targetRef="End_14"/>
