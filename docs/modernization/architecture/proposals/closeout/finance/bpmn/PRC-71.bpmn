      <dataOutputAssociation id="DOA_S3_9_1"><sourceRef>DOut_S3_9_1</sourceRef><targetRef>SR_S3_9_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_10" name="生效分包变更？">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <outgoing>Flow_15</outgoing>
      <outgoing>Flow_16</outgoing>
      <outgoing>Flow_17</outgoing>
    </exclusiveGateway>
    <serviceTask id="S4_11" name="调整预算占用 → B-18">
      <documentation>AGG-80 调整预算占用；B-11；automatic</documentation>
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
      <ioSpecification id="IO_S4_11">
        <dataOutput id="DOut_S4_11_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_11_1</dataOutputRefs></outputSet>
