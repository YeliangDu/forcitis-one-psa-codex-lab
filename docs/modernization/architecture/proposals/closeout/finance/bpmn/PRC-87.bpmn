<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PRC-87" targetNamespace="https://forcitis.one/bpmn/closeout/finance" exporter="one-arch-finance" exporterVersion="1">
  <signal id="Signal_expense_claim_confirmed" name="费用报销已核定" />
  <message id="Message_verify_request" name="发票查验请求" />
  <message id="Message_verify_result" name="发票查验结果" />
  <collaboration id="Collaboration_PRC-87">
    <participant id="Pool_one" name="FORCITIS one" processRef="PRC-87" />
    <participant id="Pool_tax" name="税务平台（外部）" />
    <messageFlow id="mf1" name="发票查验请求" sourceRef="T_verify" targetRef="Pool_tax" />
    <messageFlow id="mf2" name="发票查验结果" sourceRef="Pool_tax" targetRef="C_result" />
    <textAnnotation id="Ann_signal"><text>B-09 应收与收款订阅：冲抵员工借款（AGG-49）；净额不为零时调 B-10 确认应付，为零时调 B-12 标记报销已付（结清方式：借款冲抵）。见事件策略 PRC-147（B-09，S-16、S-17、S-19、S-24）</text></textAnnotation>
    <association id="Assoc_signal" sourceRef="S_confirmed" targetRef="Ann_signal" />
    <textAnnotation id="Ann_budget"><text>INV-102 待定：预算不够时拦截还是预警</text></textAnnotation>
    <association id="Assoc_budget" sourceRef="G_budget" targetRef="Ann_budget" />
  </collaboration>
  <process id="PRC-87" name="提交、核定并确认报销应付" isExecutable="false">
    <documentation>owner_bc: B-12；VS-08.2；描述级，不可执行（BPMN_STYLE.md）</documentation>
    <laneSet id="LaneSet_PRC-87">
      <lane id="lane_employee" name="员工（SH-E3）">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>T_fill</flowNodeRef>
        <flowNodeRef>G_project</flowNodeRef>
        <flowNodeRef>End_project</flowNodeRef>
        <flowNodeRef>M_submit</flowNodeRef>
        <flowNodeRef>T_submit</flowNodeRef>
        <flowNodeRef>G_complete</flowNodeRef>
        <flowNodeRef>T_paper</flowNodeRef>
      </lane>
      <lane id="lane_approver" name="部门负责人（SH-E1）">
        <flowNodeRef>T_approve</flowNodeRef>
        <flowNodeRef>G_approve</flowNodeRef>
      </lane>
      <lane id="lane_finance" name="财务（SH-E6）">
        <flowNodeRef>End_invoice</flowNodeRef>
        <flowNodeRef>T_confirm</flowNodeRef>
      </lane>
      <lane id="lane_system" name="系统">
        <flowNodeRef>T_verify</flowNodeRef>
        <flowNodeRef>C_result</flowNodeRef>
        <flowNodeRef>T_hold_inv</flowNodeRef>
        <flowNodeRef>G_invoice</flowNodeRef>
        <flowNodeRef>T_budget</flowNodeRef>
        <flowNodeRef>G_budget</flowNodeRef>
        <flowNodeRef>S_confirmed</flowNodeRef>
        <flowNodeRef>CA_post</flowNodeRef>
        <flowNodeRef>End_ok</flowNodeRef>
        <flowNodeRef>M_reject</flowNodeRef>
        <flowNodeRef>T_rel_budget</flowNodeRef>
        <flowNodeRef>M_release</flowNodeRef>
        <flowNodeRef>T_rel_inv</flowNodeRef>
        <flowNodeRef>End_back</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="需要报销垫付费用">
      <outgoing>f1</outgoing>
    </startEvent>
    <userTask id="T_fill" name="填写报销单">
      <documentation>读 AGG-19 项目、AGG-10 商机、AGG-62 人员；B-12（读 B-04、B-03、B-13）</documentation>
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </userTask>
    <exclusiveGateway id="G_project" name="项目可记费用？">
      <documentation>INV-39</documentation>
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f4</outgoing>
    </exclusiveGateway>
    <endEvent id="End_project" name="已拒收（项目已关闭）">
      <incoming>f3</incoming>
    </endEvent>
    <sendTask id="T_verify" name="提交发票查验">
      <documentation>where: external:税务；证据：发票文件或扫描件、查验结果与查验时刻；INV-75</documentation>
      <incoming>f4</incoming>
      <outgoing>f5</outgoing>
    </sendTask>
    <intermediateCatchEvent id="C_result" name="收到查验结果">
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
      <dataOutputAssociation id="DA_C_result_DO_verify"><targetRef>DO_verify</targetRef></dataOutputAssociation>
      <messageEventDefinition id="MED_result" messageRef="Message_verify_result" />
    </intermediateCatchEvent>
    <serviceTask id="T_hold_inv" name="占用进项发票">
      <documentation>AGG-89 占用进项发票入账；B-23；INV-74</documentation>
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
      <dataOutputAssociation id="DA_T_hold_inv_DS_89a"><targetRef>DS_89a</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="G_invoice" name="发票可用？">
      <incoming>f7</incoming>
      <outgoing>f8</outgoing>
      <outgoing>f9</outgoing>
    </exclusiveGateway>
    <endEvent id="End_invoice" name="已拒收（发票不可用）">
      <incoming>f8</incoming>
    </endEvent>
    <serviceTask id="T_budget" name="占用预算">
      <documentation>AGG-80 预算占用；B-18（people 组）</documentation>
      <incoming>f9</incoming>
      <outgoing>f10</outgoing>
      <dataOutputAssociation id="DA_T_budget_DS_80a"><targetRef>DS_80a</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="G_budget" name="预算够用？">
      <documentation>INV-102 待定：拦截还是预警，两种出口都画</documentation>
      <incoming>f10</incoming>
      <outgoing>f11</outgoing>
      <outgoing>f12</outgoing>
      <outgoing>f13</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="M_submit">
      <incoming>f11</incoming>
      <incoming>f12</incoming>
      <outgoing>f14</outgoing>
    </exclusiveGateway>
    <userTask id="T_submit" name="提交报销">
      <documentation>AGG-59 提交费用报销；B-12；INV-84</documentation>
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
      <dataOutputAssociation id="DA_T_submit_DS_59a"><targetRef>DS_59a</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="G_complete" name="原始凭证齐全？">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
      <outgoing>f17</outgoing>
    </exclusiveGateway>
    <userTask id="T_approve" name="审批报销">
      <documentation>审批平台：费用报销（单据类型暂名「费用报销审批」）；platform.approval；审批人分级待定 F-01；审批人 ≠ 报销人</documentation>
      <incoming>f17</incoming>
      <outgoing>f18</outgoing>
    </userTask>
    <exclusiveGateway id="G_approve" name="审批结论？">
      <incoming>f18</incoming>
      <outgoing>f19</outgoing>
      <outgoing>f20</outgoing>
    </exclusiveGateway>
    <manualTask id="T_paper" name="递交纸质原始凭证">
      <documentation>where: offline（全电发票无纸质原件）</documentation>
      <incoming>f20</incoming>
      <outgoing>f21</outgoing>
    </manualTask>
    <userTask id="T_confirm" name="核定报销并登记原件签收">
      <documentation>AGG-59 核定费用报销；B-12；确定所属期间；超事前预批额度预警（P-37）；核定人 ≠ 报销人、审批人</documentation>
      <incoming>f21</incoming>
      <outgoing>f22</outgoing>
      <dataOutputAssociation id="DA_T_confirm_DS_59b"><targetRef>DS_59b</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DA_T_confirm_DO_paper"><targetRef>DO_paper</targetRef></dataOutputAssociation>
    </userTask>
    <intermediateThrowEvent id="S_confirmed" name="费用报销已核定">
      <documentation>领域事件，B-09 订阅</documentation>
      <incoming>f22</incoming>
      <outgoing>f23</outgoing>
      <signalEventDefinition id="SED_confirmed" signalRef="Signal_expense_claim_confirmed" />
    </intermediateThrowEvent>
    <serviceTask id="CA_post" name="提交过账候选 → B-16">
      <documentation>AGG-59 提交过账候选；B-12 → B-16 过账管道（PRC-92）</documentation>
      <incoming>f23</incoming>
      <outgoing>f24</outgoing>
    </serviceTask>
    <endEvent id="End_ok" name="已核定">
      <documentation>VS-08.2 出口：已核定（所属期间确定）</documentation>
      <incoming>f24</incoming>
    </endEvent>
    <exclusiveGateway id="M_reject">
      <incoming>f16</incoming>
      <incoming>f19</incoming>
      <outgoing>f25</outgoing>
    </exclusiveGateway>
    <serviceTask id="T_rel_budget" name="释放预算占用">
      <documentation>AGG-80 释放预算占用；B-18</documentation>
      <incoming>f25</incoming>
      <outgoing>f26</outgoing>
      <dataOutputAssociation id="DA_T_rel_budget_DS_80b"><targetRef>DS_80b</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="M_release">
      <incoming>f13</incoming>
      <incoming>f26</incoming>
      <outgoing>f27</outgoing>
    </exclusiveGateway>
    <serviceTask id="T_rel_inv" name="释放发票占用">
      <documentation>AGG-89 驳回释放；B-23</documentation>
      <incoming>f27</incoming>
      <outgoing>f28</outgoing>
      <dataOutputAssociation id="DA_T_rel_inv_DS_89b"><targetRef>DS_89b</targetRef></dataOutputAssociation>
    </serviceTask>
    <endEvent id="End_back" name="已退回（可修改后重新提交）">
      <documentation>VS-08.2：驳回后回到草稿重入</documentation>
      <incoming>f28</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="Start" targetRef="T_fill" />
    <sequenceFlow id="f2" sourceRef="T_fill" targetRef="G_project" />
    <sequenceFlow id="f3" name="否" sourceRef="G_project" targetRef="End_project" />
    <sequenceFlow id="f4" name="是" sourceRef="G_project" targetRef="T_verify" />
    <sequenceFlow id="f5" sourceRef="T_verify" targetRef="C_result" />
    <sequenceFlow id="f6" sourceRef="C_result" targetRef="T_hold_inv" />
    <sequenceFlow id="f7" sourceRef="T_hold_inv" targetRef="G_invoice" />
    <sequenceFlow id="f8" name="不合规或已被占用" sourceRef="G_invoice" targetRef="End_invoice" />
    <sequenceFlow id="f9" name="可用" sourceRef="G_invoice" targetRef="T_budget" />
    <sequenceFlow id="f10" sourceRef="T_budget" targetRef="G_budget" />
    <sequenceFlow id="f11" name="够用" sourceRef="G_budget" targetRef="M_submit" />
    <sequenceFlow id="f12" name="不够（预警口径）" sourceRef="G_budget" targetRef="M_submit" />
    <sequenceFlow id="f13" name="不够（拦截口径）" sourceRef="G_budget" targetRef="M_release" />
    <sequenceFlow id="f14" sourceRef="M_submit" targetRef="T_submit" />
    <sequenceFlow id="f15" sourceRef="T_submit" targetRef="G_complete" />
    <sequenceFlow id="f16" name="不全" sourceRef="G_complete" targetRef="M_reject" />
    <sequenceFlow id="f17" name="齐全" sourceRef="G_complete" targetRef="T_approve" />
    <sequenceFlow id="f18" sourceRef="T_approve" targetRef="G_approve" />
    <sequenceFlow id="f19" name="驳回" sourceRef="G_approve" targetRef="M_reject" />
    <sequenceFlow id="f20" name="通过" sourceRef="G_approve" targetRef="T_paper" />
    <sequenceFlow id="f21" sourceRef="T_paper" targetRef="T_confirm" />
    <sequenceFlow id="f22" sourceRef="T_confirm" targetRef="S_confirmed" />
    <sequenceFlow id="f23" sourceRef="S_confirmed" targetRef="CA_post" />
    <sequenceFlow id="f24" sourceRef="CA_post" targetRef="End_ok" />
    <sequenceFlow id="f25" sourceRef="M_reject" targetRef="T_rel_budget" />
    <sequenceFlow id="f26" sourceRef="T_rel_budget" targetRef="M_release" />
    <sequenceFlow id="f27" sourceRef="M_release" targetRef="T_rel_inv" />
    <sequenceFlow id="f28" sourceRef="T_rel_inv" targetRef="End_back" />
    <dataStoreReference id="DS_59a" name="AGG-59 费用报销" />
    <dataStoreReference id="DS_59b" name="AGG-59 费用报销" />
    <dataStoreReference id="DS_89a" name="AGG-89 进项发票" />
    <dataStoreReference id="DS_89b" name="AGG-89 进项发票" />
    <dataStoreReference id="DS_80a" name="AGG-80 预算账户" />
    <dataStoreReference id="DS_80b" name="AGG-80 预算账户" />
    <dataObjectReference id="DO_paper" name="纸质原始凭证签收记录" dataObjectRef="DO_paper_obj" />
    <dataObject id="DO_paper_obj" />
    <dataObjectReference id="DO_verify" name="发票文件与查验结果" dataObjectRef="DO_verify_obj" />
    <dataObject id="DO_verify_obj" />
  </process>
