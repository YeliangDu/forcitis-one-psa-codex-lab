  <dataStore id="DS_AGG-77" name="AGG-77"/>
  <collaboration id="Collab_PRC-92">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-92"/>
  </collaboration>
  <process id="PRC-92" name="过账业务事实" isExecutable="false">
    <documentation>owner B-16；VS-10.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S1_gw_4</flowNodeRef>
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_evt_6</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S3_8</flowNodeRef>
        <flowNodeRef>S3_evt_9</flowNodeRef>
        <flowNodeRef>S3_gw_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
        <flowNodeRef>End_14</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="触账 BC 提交过账候选（PostingCandidate）">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="来源 BC 发起更正：冲销并重过账（独立入口）">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <serviceTask id="S1_3" name="校验目标期间 → B-19">
      <documentation>校验目标期间；B-16；automatic</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="校验目标期间？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_5" name="过账 → B-13">
      <documentation>AGG-77 过账；B-16；automatic</documentation>
      <incoming>Flow_6</incoming>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <intermediateThrowEvent id="S2_evt_6" name="BusinessFactAttributed">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </intermediateThrowEvent>
    <exclusiveGateway id="S2_gw_7" name="过账？">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_13</outgoing>
      <outgoing>Flow_14</outgoing>
    </exclusiveGateway>
    <serviceTask id="S3_8" name="冲销并重过账">
      <documentation>AGG-77 冲销并重过账；B-16；automatic</documentation>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_15</outgoing>
      <ioSpecification id="IO_S3_8">
        <dataOutput id="DOut_S3_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_8_1"><sourceRef>DOut_S3_8_1</sourceRef><targetRef>SR_S3_8_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <intermediateThrowEvent id="S3_evt_9" name="BusinessFactRestated">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </intermediateThrowEvent>
    <exclusiveGateway id="S3_gw_10" name="冲销并重过账？">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <outgoing>Flow_18</outgoing>
      <outgoing>Flow_19</outgoing>
      <outgoing>Flow_20</outgoing>
      <outgoing>Flow_21</outgoing>
    </exclusiveGateway>
    <endEvent id="End_11" name="幂等已返回原结果">
      <incoming>Flow_4</incoming>
      <incoming>Flow_11</incoming>
      <incoming>Flow_18</incoming>
    </endEvent>
    <endEvent id="End_12" name="已拒收">
      <incoming>Flow_5</incoming>
      <incoming>Flow_7</incoming>
      <incoming>Flow_12</incoming>
      <incoming>Flow_13</incoming>
      <incoming>Flow_17</incoming>
      <incoming>Flow_19</incoming>
      <incoming>Flow_20</incoming>
    </endEvent>
    <endEvent id="End_13" name="已过账">
      <incoming>Flow_14</incoming>
    </endEvent>
    <endEvent id="End_14" name="已更正">
      <incoming>Flow_21</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S3_8"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S1_gw_4"/>
    <sequenceFlow id="Flow_4" name="同一幂等键已处理（重试或重复调用）→ 先于期间闸门返回原结果" sourceRef="S1_gw_4" targetRef="End_11"/>
    <sequenceFlow id="Flow_5" name="显式指定的落账期间（第 13 期通道）未开放或未启用" sourceRef="S1_gw_4" targetRef="End_12"/>
    <sequenceFlow id="Flow_6" name="业务日期所在期间已关账且该法人有开放期间，路由到开放期间并标原期间" sourceRef="S1_gw_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_7" name="该法人无开放期间可落" sourceRef="S1_gw_4" targetRef="End_12"/>
    <sequenceFlow id="Flow_8" name="其他" sourceRef="S1_gw_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_9" sourceRef="S2_5" targetRef="S2_evt_6"/>
    <sequenceFlow id="Flow_10" sourceRef="S2_evt_6" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_11" name="同一幂等键已处理，返回原 PostSeq，不重复追加" sourceRef="S2_gw_7" targetRef="End_11"/>
    <sequenceFlow id="Flow_12" name="借贷不平，拒收并告警" sourceRef="S2_gw_7" targetRef="End_12"/>
    <sequenceFlow id="Flow_13" name="法人不一致，拒收并告警" sourceRef="S2_gw_7" targetRef="End_12"/>
    <sequenceFlow id="Flow_14" name="其他" sourceRef="S2_gw_7" targetRef="End_13"/>
    <sequenceFlow id="Flow_15" sourceRef="S3_8" targetRef="S3_evt_9"/>
    <sequenceFlow id="Flow_16" sourceRef="S3_evt_9" targetRef="S3_gw_10"/>
    <sequenceFlow id="Flow_17" name="原事实不存在或已被冲销过，拒收并告警" sourceRef="S3_gw_10" targetRef="End_12"/>
    <sequenceFlow id="Flow_18" name="该更正请求的幂等键已处理，返回原结果" sourceRef="S3_gw_10" targetRef="End_11"/>
    <sequenceFlow id="Flow_19" name="重做的新事实借贷不平或法人不一致，拒收并告警" sourceRef="S3_gw_10" targetRef="End_12"/>
    <sequenceFlow id="Flow_20" name="该法人无开放期间可落，拒收并告警" sourceRef="S3_gw_10" targetRef="End_12"/>
    <sequenceFlow id="Flow_21" name="其他" sourceRef="S3_gw_10" targetRef="End_14"/>
    <dataStoreReference id="SR_S1_3_r1" name="AGG-81" dataStoreRef="DS_AGG-81"/>
    <dataStoreReference id="SR_S2_5_w1" name="AGG-77" dataStoreRef="DS_AGG-77"/>
    <dataStoreReference id="SR_S3_8_w1" name="AGG-77" dataStoreRef="DS_AGG-77"/>
    <textAnnotation id="Ann_1"><text>由其他流程调用</text></textAnnotation>
