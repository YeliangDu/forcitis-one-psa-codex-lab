    <textAnnotation id="Ann_2"><text>由其他流程调用</text></textAnnotation>
    <association id="Assoc_Ann_2" sourceRef="Start_2" targetRef="Ann_2" associationDirection="None"/>
    <textAnnotation id="Ann_3"><text>对方 BC：B-07、B-15、B-17、B-20</text></textAnnotation>
