    <sequenceFlow id="Flow_23" name="业务日期所在期间已关账：规则提示「将落当前开放期间并标原期间」，制单人确认后提交，不设审批" sourceRef="S4_gw_13" targetRef="End_18"/>
    <sequenceFlow id="Flow_24" name="其他" sourceRef="S4_gw_13" targetRef="End_18"/>
