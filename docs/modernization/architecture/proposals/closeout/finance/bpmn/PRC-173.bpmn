    <startEvent id="Start_1" name="超标订单待审批">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <sendTask id="S1_2" name="登记超标订单待审批">
      <documentation>AGG-131 登记超标订单待审批；B-12；external:分贝通</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <dataOutput id="DOut_S1_2_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs><dataOutputRefs>DOut_S1_2_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S1_2_2"><sourceRef>DOut_S1_2_2</sourceRef><targetRef>OR_S1_2_1</targetRef></dataOutputAssociation>
    </sendTask>
    <intermediateCatchEvent id="S1_recv_3" name="分贝通返回结果">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <exclusiveGateway id="S1_gw_4" name="登记超标订单待审批？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <userTask id="S2_5" name="差旅超标订单审批">
      <documentation>差旅超标订单审批；B-12；in_system；差旅超标订单.审批；审批待办（审批平台）；审批平台：差旅超标订单审批</documentation>
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <boundaryEvent id="S2_5_bd_6" name="期限 PT12H" cancelActivity="false" attachedToRef="S2_5">
      <outgoing>Flow_9</outgoing>
      <timerEventDefinition><timeDuration>PT12H</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_5_esc_7" name="处理超时：差旅超标订单审批">
      <documentation>升级给 审批人上级；期限 PT12H</documentation>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_5_esc_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
