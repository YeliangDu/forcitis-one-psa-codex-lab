      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <ioSpecification id="IO_S2_api_8">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
