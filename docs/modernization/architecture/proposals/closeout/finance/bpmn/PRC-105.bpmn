<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-105" targetNamespace="https://forcitis.one/bpmn/PRC-105" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-86" name="AGG-86"/>
  <collaboration id="Collab_PRC-105">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-105"/>
  </collaboration>
  <process id="PRC-105" name="评审并生效报表行定义版本" isExecutable="false">
    <documentation>owner B-21；VS-10.2</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_4</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_3</flowNodeRef>
        <flowNodeRef>S2_api_6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="财务编制报表行到科目的映射">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="编制报表行定义版本">
      <documentation>AGG-86 编制报表行定义版本；B-21；in_system；报表.编制报表行定义；报表行定义编辑页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S1_api_3" name="读科目表版本 → B-20">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_3">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="编制报表行定义版本？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
    </exclusiveGateway>
    <userTask id="S2_5" name="生效报表行定义版本">
      <documentation>AGG-86 生效报表行定义版本；B-21；in_system；报表.评审生效报表行定义；报表行定义评审页；审批（aggregate）：报表行定义评审生效</documentation>
      <incoming>Flow_5</incoming>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_api_6" name="读会计期间 → B-19">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_api_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_7" name="生效报表行定义版本？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
    </exclusiveGateway>
    <endEvent id="End_8" name="已拒收">
      <incoming>Flow_4</incoming>
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_9" name="已生效">
      <incoming>Flow_11</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_api_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_api_3" targetRef="S1_gw_4"/>
    <sequenceFlow id="Flow_4" name="映射的科目在所引用的科目表版本中不存在，拒收并告警" sourceRef="S1_gw_4" targetRef="End_8"/>
    <sequenceFlow id="Flow_5" name="其他" sourceRef="S1_gw_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_6" sourceRef="S2_5" targetRef="S2_api_6"/>
    <sequenceFlow id="Flow_7" sourceRef="S2_api_6" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_8" name="评审生效人与编制人为同一人，命令被拒，改由他人评审" sourceRef="S2_gw_7" targetRef="S2_5"/>
    <sequenceFlow id="Flow_9" name="评审不通过，退回编制" sourceRef="S2_gw_7" targetRef="S1_2"/>
    <sequenceFlow id="Flow_10" name="生效日不是期间首日，或该期间已关账（含关账中），拒收并告警" sourceRef="S2_gw_7" targetRef="End_8"/>
    <sequenceFlow id="Flow_11" name="其他" sourceRef="S2_gw_7" targetRef="End_9"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-86" dataStoreRef="DS_AGG-86"/>
    <dataStoreReference id="SR_S2_5_w1" name="AGG-86" dataStoreRef="DS_AGG-86"/>
  </process>
