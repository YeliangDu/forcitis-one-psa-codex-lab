<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-74" targetNamespace="https://forcitis.one/bpmn/PRC-74" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="供方履约已确认"/>
  <signal id="Signal_2" name="进项发票已用途确认"/>
  <dataStore id="DS_AGG-52" name="AGG-52"/>
  <collaboration id="Collab_PRC-74">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-74"/>
  </collaboration>
  <process id="PRC-74" name="提交供方应付款项" isExecutable="false">
    <documentation>owner B-11；VS-05.4</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>Start_3</flowNodeRef>
        <flowNodeRef>S1_4</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>End_8</flowNodeRef>
        <flowNodeRef>End_9</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
        <flowNodeRef>End_13</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="供方履约已确认">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="进项发票已用途确认">
      <outgoing>Flow_2</outgoing>
      <signalEventDefinition signalRef="Signal_2"/>
    </startEvent>
    <startEvent id="Start_3" name="财务对被拒收的应付人工重提">
      <outgoing>Flow_3</outgoing>
    </startEvent>
    <serviceTask id="S1_4" name="确认应付 → B-10">
      <documentation>AGG-52 确认应付；B-11；automatic</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_4">
        <dataOutput id="DOut_S1_4_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_4_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_4_1"><sourceRef>DOut_S1_4_1</sourceRef><targetRef>SR_S1_4_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S1_gw_5" name="确认应付？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <serviceTask id="S2_6" name="提交过账候选 → B-16">
      <documentation>AGG-52 提交过账候选；B-11；automatic；调用 PRC-92</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataOutput id="DOut_S2_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_6_1"><sourceRef>DOut_S2_6_1</sourceRef><targetRef>SR_S2_6_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S2_gw_7" name="提交过账候选？">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_13</outgoing>
    </exclusiveGateway>
    <endEvent id="End_8" name="重复事件已忽略">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_9" name="已拒收">
      <incoming>Flow_6</incoming>
    </endEvent>
    <endEvent id="End_10" name="等待发票">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_11" name="期间关账中待重试">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_12" name="应付已确认">
      <incoming>Flow_11</incoming>
      <incoming>Flow_13</incoming>
    </endEvent>
    <endEvent id="End_13" name="过账被拒收">
      <incoming>Flow_12</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_4"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_4"/>
    <sequenceFlow id="Flow_3" sourceRef="Start_3" targetRef="S1_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_4" targetRef="S1_gw_5"/>
    <sequenceFlow id="Flow_5" name="来源单据已确认过应付（幂等）" sourceRef="S1_gw_5" targetRef="End_8"/>
    <sequenceFlow id="Flow_6" name="发票查验不合规或已被占用（INV-74、INV-75a）→ 拒收并告警，退回供方换票，换票经 PRC-73 用途确认后由事件再入" sourceRef="S1_gw_5" targetRef="End_9"/>
    <sequenceFlow id="Flow_7" name="来源为供方履约确认且发票未到：不确认应付，暂估已在履约确认过账时贷记（AGG-52 的占用前置不变，不做无票应付），取得发票经 PRC-73 用途确认后由事件再入" sourceRef="S1_gw_5" targetRef="End_10"/>
    <sequenceFlow id="Flow_8" name="其他" sourceRef="S1_gw_5" targetRef="S2_6"/>
    <sequenceFlow id="Flow_9" sourceRef="S2_6" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_10" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S2_gw_7" targetRef="End_11"/>
    <sequenceFlow id="Flow_11" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S2_gw_7" targetRef="End_12"/>
    <sequenceFlow id="Flow_12" name="过账管道拒收（该法人无开放期间、借贷不平或法人不一致），拒收并告警" sourceRef="S2_gw_7" targetRef="End_13"/>
    <sequenceFlow id="Flow_13" name="其他" sourceRef="S2_gw_7" targetRef="End_12"/>
    <dataStoreReference id="SR_S1_4_w1" name="AGG-52" dataStoreRef="DS_AGG-52"/>
    <dataStoreReference id="SR_S2_6_w1" name="AGG-52" dataStoreRef="DS_AGG-52"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PRC-74">
