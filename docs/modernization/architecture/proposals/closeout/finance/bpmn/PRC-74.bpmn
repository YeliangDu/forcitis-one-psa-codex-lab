      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_12" bpmnElement="End_12">
        <dc:Bounds x="1237" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_13" bpmnElement="End_13">
        <dc:Bounds x="1327" y="47" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S1_4_w1" bpmnElement="SR_S1_4_w1">
        <dc:Bounds x="397" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SR_S2_6_w1" bpmnElement="SR_S2_6_w1">
        <dc:Bounds x="657" y="4" width="36" height="26"/>
      </bpmndi:BPMNShape>
