<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-73" targetNamespace="https://forcitis.one/bpmn/PRC-73" exporter="bpmn_gen" exporterVersion="1">
  <dataStore id="DS_AGG-89" name="AGG-89"/>
  <collaboration id="Collab_PRC-73">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-73"/>
    <participant id="Pool_1" name="税务"/>
    <messageFlow id="Msg_1" name="查验进项发票" sourceRef="S2_5" targetRef="Pool_1"/>
    <messageFlow id="Msg_2" name="税务返回结果" sourceRef="Pool_1" targetRef="S2_recv_8"/>
  </collaboration>
  <process id="PRC-73" name="登记并查验进项发票" isExecutable="false">
    <documentation>owner B-23；VS-05.4、VS-08.2</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>S1_2</flowNodeRef>
        <flowNodeRef>S1_gw_4</flowNodeRef>
        <flowNodeRef>S2_5_esc_7</flowNodeRef>
        <flowNodeRef>S3_10</flowNodeRef>
        <flowNodeRef>S3_gw_11</flowNodeRef>
        <flowNodeRef>S4_12</flowNodeRef>
        <flowNodeRef>End_15</flowNodeRef>
        <flowNodeRef>End_17</flowNodeRef>
        <flowNodeRef>End_18</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_3</flowNodeRef>
        <flowNodeRef>S2_5</flowNodeRef>
        <flowNodeRef>S2_recv_8</flowNodeRef>
        <flowNodeRef>S2_gw_9</flowNodeRef>
        <flowNodeRef>S5_13</flowNodeRef>
        <flowNodeRef>S5_gw_14</flowNodeRef>
        <flowNodeRef>End_16</flowNodeRef>
        <flowNodeRef>End_19</flowNodeRef>
        <flowNodeRef>End_20</flowNodeRef>
        <flowNodeRef>End_21</flowNodeRef>
        <flowNodeRef>S2_5_bd_6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="财务收到供方发票">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="S1_2" name="登记进项发票">
      <documentation>AGG-89 登记进项发票；B-23；in_system；进项发票.登记；进项发票登记页</documentation>
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
      <ioSpecification id="IO_S1_2">
        <dataOutput id="DOut_S1_2_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_2_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S1_2_1"><sourceRef>DOut_S1_2_1</sourceRef><targetRef>SR_S1_2_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S1_api_3" name="读开票方 → B-01">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_api_3">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S1_gw_4" name="登记进项发票？">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <sendTask id="S2_5" name="查验进项发票 → platform.integration">
      <documentation>AGG-89 查验进项发票；B-23；external:税务；进项发票.查验；进项发票详情页</documentation>
      <incoming>Flow_6</incoming>
      <incoming>Flow_9</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_5">
        <dataOutput id="DOut_S2_5_1"/>
        <dataOutput id="DOut_S2_5_2"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_5_1</dataOutputRefs><dataOutputRefs>DOut_S2_5_2</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_5_1"><sourceRef>DOut_S2_5_1</sourceRef><targetRef>SR_S2_5_w1</targetRef></dataOutputAssociation>
      <dataOutputAssociation id="DOA_S2_5_2"><sourceRef>DOut_S2_5_2</sourceRef><targetRef>OR_S2_5_1</targetRef></dataOutputAssociation>
    </sendTask>
    <boundaryEvent id="S2_5_bd_6" name="期限 PT1H" cancelActivity="false" attachedToRef="S2_5">
      <outgoing>Flow_13</outgoing>
      <timerEventDefinition><timeDuration>PT1H</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S2_5_esc_7" name="处理超时：查验进项发票">
      <documentation>升级给 SH-E6；期限 PT1H</documentation>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <ioSpecification id="IO_S2_5_esc_7">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <intermediateCatchEvent id="S2_recv_8" name="税务返回结果">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <exclusiveGateway id="S2_gw_9" name="查验进项发票？">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
      <outgoing>Flow_10</outgoing>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
    </exclusiveGateway>
    <userTask id="S3_10" name="确认进项发票用途">
      <documentation>AGG-89 确认进项发票用途；B-23；in_system；进项发票.确认用途；进项发票详情页</documentation>
      <incoming>Flow_12</incoming>
      <outgoing>Flow_15</outgoing>
      <ioSpecification id="IO_S3_10">
        <dataOutput id="DOut_S3_10_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_10_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_10_1"><sourceRef>DOut_S3_10_1</sourceRef><targetRef>SR_S3_10_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_11" name="确认进项发票用途？">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <outgoing>Flow_17</outgoing>
    </exclusiveGateway>
    <userTask id="S4_12" name="进项转出">
      <documentation>AGG-89 进项转出；B-23；in_system；进项发票.转出；进项发票详情页</documentation>
      <incoming>Flow_16</incoming>
      <outgoing>Flow_18</outgoing>
      <ioSpecification id="IO_S4_12">
        <dataOutput id="DOut_S4_12_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S4_12_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S4_12_1"><sourceRef>DOut_S4_12_1</sourceRef><targetRef>SR_S4_12_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S5_13" name="提交过账候选 → B-16">
      <documentation>AGG-89 提交过账候选；B-23；automatic；调用 PRC-92</documentation>
      <incoming>Flow_18</incoming>
      <outgoing>Flow_19</outgoing>
      <ioSpecification id="IO_S5_13">
        <dataOutput id="DOut_S5_13_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S5_13_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S5_13_1"><sourceRef>DOut_S5_13_1</sourceRef><targetRef>SR_S5_13_w1</targetRef></dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="S5_gw_14" name="提交过账候选？">
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
      <outgoing>Flow_21</outgoing>
      <outgoing>Flow_22</outgoing>
      <outgoing>Flow_23</outgoing>
    </exclusiveGateway>
    <endEvent id="End_15" name="已拒收">
      <incoming>Flow_4</incoming>
      <incoming>Flow_5</incoming>
      <incoming>Flow_11</incoming>
    </endEvent>
    <endEvent id="End_16" name="查验未完成">
      <incoming>Flow_10</incoming>
    </endEvent>
    <endEvent id="End_17" name="已提醒">
      <incoming>Flow_14</incoming>
    </endEvent>
    <endEvent id="End_18" name="已用途确认">
      <incoming>Flow_17</incoming>
    </endEvent>
    <endEvent id="End_19" name="期间关账中待重试">
      <incoming>Flow_20</incoming>
    </endEvent>
    <endEvent id="End_20" name="已转出">
      <incoming>Flow_21</incoming>
      <incoming>Flow_23</incoming>
    </endEvent>
    <endEvent id="End_21" name="过账被拒收">
      <incoming>Flow_22</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_2"/>
    <sequenceFlow id="Flow_2" sourceRef="S1_2" targetRef="S1_api_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_api_3" targetRef="S1_gw_4"/>
    <sequenceFlow id="Flow_4" name="同一发票代码与号码已登记" sourceRef="S1_gw_4" targetRef="End_15"/>
    <sequenceFlow id="Flow_5" name="开票方不是已登记往来单位" sourceRef="S1_gw_4" targetRef="End_15"/>
    <sequenceFlow id="Flow_6" name="其他" sourceRef="S1_gw_4" targetRef="S2_5"/>
    <sequenceFlow id="Flow_7" sourceRef="S2_5" targetRef="S2_recv_8"/>
    <sequenceFlow id="Flow_8" sourceRef="S2_recv_8" targetRef="S2_gw_9"/>
    <sequenceFlow id="Flow_9" name="税务平台不可用或未返回可判定结果，自动重试（每小时一次，最多 3 次）" sourceRef="S2_gw_9" targetRef="S2_5"/>
    <sequenceFlow id="Flow_10" name="连续重试仍无可判定结果，保持已登记并转财务人工重试" sourceRef="S2_gw_9" targetRef="End_16"/>
    <sequenceFlow id="Flow_11" name="查验不合规" sourceRef="S2_gw_9" targetRef="End_15"/>
    <sequenceFlow id="Flow_12" name="其他" sourceRef="S2_gw_9" targetRef="S3_10"/>
    <sequenceFlow id="Flow_13" sourceRef="S2_5_bd_6" targetRef="S2_5_esc_7"/>
    <sequenceFlow id="Flow_14" sourceRef="S2_5_esc_7" targetRef="End_17"/>
    <sequenceFlow id="Flow_15" sourceRef="S3_10" targetRef="S3_gw_11"/>
    <sequenceFlow id="Flow_16" name="用途为不可抵扣，需转出" sourceRef="S3_gw_11" targetRef="S4_12"/>
    <sequenceFlow id="Flow_17" name="其他" sourceRef="S3_gw_11" targetRef="End_18"/>
    <sequenceFlow id="Flow_18" sourceRef="S4_12" targetRef="S5_13"/>
    <sequenceFlow id="Flow_19" sourceRef="S5_13" targetRef="S5_gw_14"/>
    <sequenceFlow id="Flow_20" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S5_gw_14" targetRef="End_19"/>
    <sequenceFlow id="Flow_21" name="所属期间已关账，自动落当前开放期间并标原期间（系统触账不拒绝）" sourceRef="S5_gw_14" targetRef="End_20"/>
    <sequenceFlow id="Flow_22" name="过账管道拒收（该法人无开放期间、借贷不平或法人不一致），拒收并告警" sourceRef="S5_gw_14" targetRef="End_21"/>
    <sequenceFlow id="Flow_23" name="其他" sourceRef="S5_gw_14" targetRef="End_20"/>
    <dataStoreReference id="SR_S1_2_w1" name="AGG-89" dataStoreRef="DS_AGG-89"/>
    <dataStoreReference id="SR_S2_5_w1" name="AGG-89" dataStoreRef="DS_AGG-89"/>
    <dataObject id="DObj_OR_S2_5_1"/>
    <dataObjectReference id="OR_S2_5_1" name="税务平台查验结果与查验时…" dataObjectRef="DObj_OR_S2_5_1"/>
    <dataStoreReference id="SR_S3_10_w1" name="AGG-89" dataStoreRef="DS_AGG-89"/>
    <dataStoreReference id="SR_S4_12_w1" name="AGG-89" dataStoreRef="DS_AGG-89"/>
    <dataStoreReference id="SR_S5_13_w1" name="AGG-89" dataStoreRef="DS_AGG-89"/>
  </process>
