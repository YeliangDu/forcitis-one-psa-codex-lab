        <dataOutput id="DOut_S2_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_8_1"><sourceRef>DOut_S2_8_1</sourceRef><targetRef>SR_S2_8_w1</targetRef></dataOutputAssociation>
    </userTask>
    <serviceTask id="S2_api_9" name="发起关账 → B-19">
      <incoming>Flow_9</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S2_api_9">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S2_gw_10" name="发起关账？">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
    </exclusiveGateway>
    <userTask id="S3_11" name="确认关账">
      <documentation>AGG-81 确认关账；B-17；in_system；月结.确认关账；月结关账页（确认）；审批（aggregate）：月结关账确认</documentation>
      <incoming>Flow_12</incoming>
      <incoming>Flow_17</incoming>
      <outgoing>Flow_13</outgoing>
      <ioSpecification id="IO_S3_11">
        <dataOutput id="DOut_S3_11_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_11_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_11_1"><sourceRef>DOut_S3_11_1</sourceRef><targetRef>SR_S3_11_w1</targetRef></dataOutputAssociation>
    </userTask>
    <boundaryEvent id="S3_11_bd_12" name="期限 配置：财务设定的关账提醒日" cancelActivity="false" attachedToRef="S3_11">
      <outgoing>Flow_20</outgoing>
      <timerEventDefinition><timeDuration>配置：财务设定的关账提醒日</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="S3_11_esc_13" name="处理超时：确认关账">
      <documentation>升级给 审批人上级；期限 配置：财务设定的关账提醒日</documentation>
      <incoming>Flow_20</incoming>
      <outgoing>Flow_21</outgoing>
      <ioSpecification id="IO_S3_11_esc_13">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </userTask>
    <serviceTask id="S3_api_14" name="确认关账 → B-19">
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
      <ioSpecification id="IO_S3_api_14">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <serviceTask id="S3_api_15" name="写关账审计记录（检查结果摘要、发起人、确认人） → platform.audit">
      <incoming>Flow_14</incoming>
      <outgoing>Flow_15</outgoing>
      <ioSpecification id="IO_S3_api_15">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <intermediateThrowEvent id="S3_evt_16" name="AccountingPeriodClosed">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_16</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </intermediateThrowEvent>
    <exclusiveGateway id="S3_gw_17" name="确认关账？">
      <incoming>Flow_16</incoming>
      <outgoing>Flow_17</outgoing>
      <outgoing>Flow_18</outgoing>
      <outgoing>Flow_19</outgoing>
    </exclusiveGateway>
    <userTask id="S4_18" name="退回开放">
      <documentation>AGG-81 退回开放；B-17；in_system；月结.退回开放；月结关账页（退回开放）</documentation>
