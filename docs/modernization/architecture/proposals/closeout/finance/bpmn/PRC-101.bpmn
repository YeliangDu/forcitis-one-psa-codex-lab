      <dataInputAssociation id="DIA_S1_3_4"><sourceRef>SR_S1_3_r4</sourceRef><targetRef>DIn_S1_3_4</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_3_5"><sourceRef>SR_S1_3_r5</sourceRef><targetRef>DIn_S1_3_5</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_3_6"><sourceRef>SR_S1_3_r6</sourceRef><targetRef>DIn_S1_3_6</targetRef></dataInputAssociation>
    </userTask>
    <serviceTask id="S1_api_4" name="读分录余额、待处理队列、推送死信与期末结转 → B-20">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <ioSpecification id="IO_S1_api_4">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <serviceTask id="S1_api_5" name="读队列与死信 → B-16">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <ioSpecification id="IO_S1_api_5">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <serviceTask id="S1_api_6" name="读会计期间 → B-19">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
      <ioSpecification id="IO_S1_api_6">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <exclusiveGateway id="S1_gw_7" name="月结检查？">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
      <outgoing>Flow_8</outgoing>
    </exclusiveGateway>
    <userTask id="S2_8" name="发起关账">
      <documentation>AGG-81 发起关账；B-17；in_system；月结.发起关账；月结关账页（发起）</documentation>
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
