      <outgoing>Flow_23</outgoing>
      <ioSpecification id="IO_S4_api_19">
        <inputSet></inputSet>
        <outputSet></outputSet>
      </ioSpecification>
    </serviceTask>
    <endEvent id="End_20" name="检查未通过保持开放">
      <incoming>Flow_7</incoming>
    </endEvent>
    <endEvent id="End_21" name="已拒收">
      <incoming>Flow_11</incoming>
    </endEvent>
    <endEvent id="End_22" name="已关账">
