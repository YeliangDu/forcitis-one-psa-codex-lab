  <process id="PRC-101" name="逐账户核对银行账单、处理未达并留存结论，检查并关闭会计期间" isExecutable="false">
    <documentation>owner B-17；VS-10.1</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S1_gw_7</flowNodeRef>
        <flowNodeRef>S2_8</flowNodeRef>
        <flowNodeRef>S2_gw_10</flowNodeRef>
        <flowNodeRef>S4_18</flowNodeRef>
        <flowNodeRef>End_20</flowNodeRef>
        <flowNodeRef>End_21</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S3_11</flowNodeRef>
        <flowNodeRef>S3_evt_16</flowNodeRef>
        <flowNodeRef>S3_gw_17</flowNodeRef>
        <flowNodeRef>End_22</flowNodeRef>
        <flowNodeRef>S3_11_bd_12</flowNodeRef>
      </lane>
      <lane id="Lane_审批人上级" name="审批人上级（审批人上级）">
        <flowNodeRef>S3_11_esc_13</flowNodeRef>
        <flowNodeRef>End_23</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>S1_api_4</flowNodeRef>
        <flowNodeRef>S1_api_5</flowNodeRef>
        <flowNodeRef>S1_api_6</flowNodeRef>
        <flowNodeRef>S2_api_9</flowNodeRef>
        <flowNodeRef>S3_api_14</flowNodeRef>
        <flowNodeRef>S3_api_15</flowNodeRef>
        <flowNodeRef>S4_api_19</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="财务在会计期间结束时发起月结">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <startEvent id="Start_2" name="12 月且本年度未启用第 13 期时由 PRC-102 转入">
      <outgoing>Flow_2</outgoing>
    </startEvent>
    <userTask id="S1_3" name="月结检查">
      <documentation>月结检查；B-17；in_system；月结.执行前置检查；月结检查页</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <incoming>Flow_23</incoming>
      <outgoing>Flow_3</outgoing>
