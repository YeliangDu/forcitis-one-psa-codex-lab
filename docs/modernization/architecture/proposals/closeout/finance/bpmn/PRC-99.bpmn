    <sequenceFlow id="Flow_25" name="资产卡片已处置（重复调用，幂等返回原结果）" sourceRef="S5_gw_19" targetRef="End_28"/>
    <sequenceFlow id="Flow_26" name="其他" sourceRef="S5_gw_19" targetRef="S6_20"/>
    <sequenceFlow id="Flow_27" sourceRef="S6_20" targetRef="S6_gw_21"/>
    <sequenceFlow id="Flow_28" name="所属期间在关账中（已发起关账、未确认），本期过账不接受：返回「期间关账中、可重试」，不进拒收记录，由来源 BC 投递重试" sourceRef="S6_gw_21" targetRef="End_29"/>
    <sequenceFlow id="Flow_29" name="落账期间已关账且该法人有开放期间，自动落当前开放期间并标原期间" sourceRef="S6_gw_21" targetRef="End_28"/>
    <sequenceFlow id="Flow_30" name="该法人无开放期间可落（过账管道拒收），拒收并告警" sourceRef="S6_gw_21" targetRef="End_22"/>
    <sequenceFlow id="Flow_31" name="过账管道拒收（借贷不平或法人不一致），拒收并告警" sourceRef="S6_gw_21" targetRef="End_22"/>
    <sequenceFlow id="Flow_32" name="其他" sourceRef="S6_gw_21" targetRef="End_28"/>
