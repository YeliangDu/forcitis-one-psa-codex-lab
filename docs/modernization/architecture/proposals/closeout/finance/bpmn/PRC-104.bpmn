<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_PRC-104" targetNamespace="https://forcitis.one/bpmn/PRC-104" exporter="bpmn_gen" exporterVersion="1">
  <signal id="Signal_1" name="期间余额快照已生成"/>
  <dataStore id="DS_AGG-100" name="AGG-100"/>
  <dataStore id="DS_AGG-84" name="AGG-84"/>
  <dataStore id="DS_AGG-101" name="AGG-101"/>
  <collaboration id="Collab_PRC-104">
    <participant id="P_main" name="FORCITIS one" processRef="PRC-104"/>
    <participant id="Pool_1" name="U8C"/>
    <messageFlow id="Msg_1" name="读取外部法定账余额" sourceRef="S1_3" targetRef="Pool_1"/>
    <messageFlow id="Msg_2" name="U8C返回结果" sourceRef="Pool_1" targetRef="S1_recv_4"/>
  </collaboration>
  <process id="PRC-104" name="外部法定账对账与签字" isExecutable="false">
    <documentation>owner B-20；VS-10.2</documentation>
    <laneSet id="LaneSet_1">
      <lane id="Lane_SH-E6" name="职能人员（SH-E6）">
        <flowNodeRef>S2_6</flowNodeRef>
        <flowNodeRef>S2_gw_7</flowNodeRef>
        <flowNodeRef>End_11</flowNodeRef>
      </lane>
      <lane id="Lane_SH-M1" name="管理层（SH-M1）">
        <flowNodeRef>S3_8</flowNodeRef>
        <flowNodeRef>S3_gw_9</flowNodeRef>
        <flowNodeRef>End_12</flowNodeRef>
      </lane>
      <lane id="Lane_system" name="系统">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Start_2</flowNodeRef>
        <flowNodeRef>S1_3</flowNodeRef>
        <flowNodeRef>S1_recv_4</flowNodeRef>
        <flowNodeRef>S1_gw_5</flowNodeRef>
        <flowNodeRef>End_10</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_1" name="期间余额快照已生成">
      <outgoing>Flow_1</outgoing>
      <signalEventDefinition signalRef="Signal_1"/>
    </startEvent>
    <startEvent id="Start_2" name="每日重试读取 U8C 余额（读取失败后）">
      <outgoing>Flow_2</outgoing>
      <timerEventDefinition/>
    </startEvent>
    <sendTask id="S1_3" name="读取外部法定账余额 → platform.integration">
      <documentation>读取外部法定账余额；B-20；external:U8C</documentation>
      <incoming>Flow_1</incoming>
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <ioSpecification id="IO_S1_3">
        <dataInput id="DIn_S1_3_1"/>
        <dataInput id="DIn_S1_3_2"/>
        <dataOutput id="DOut_S1_3_1"/>
        <inputSet><dataInputRefs>DIn_S1_3_1</dataInputRefs><dataInputRefs>DIn_S1_3_2</dataInputRefs></inputSet>
        <outputSet><dataOutputRefs>DOut_S1_3_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation id="DIA_S1_3_1"><sourceRef>SR_S1_3_r1</sourceRef><targetRef>DIn_S1_3_1</targetRef></dataInputAssociation>
      <dataInputAssociation id="DIA_S1_3_2"><sourceRef>SR_S1_3_r2</sourceRef><targetRef>DIn_S1_3_2</targetRef></dataInputAssociation>
      <dataOutputAssociation id="DOA_S1_3_1"><sourceRef>DOut_S1_3_1</sourceRef><targetRef>OR_S1_3_1</targetRef></dataOutputAssociation>
    </sendTask>
    <intermediateCatchEvent id="S1_recv_4" name="U8C返回结果">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <exclusiveGateway id="S1_gw_5" name="读取外部法定账余额？">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_6</outgoing>
    </exclusiveGateway>
    <userTask id="S2_6" name="登记对账差异">
      <documentation>AGG-101 登记对账差异；B-20；in_system；总账.登记对账差异；外部法定账对账页</documentation>
      <incoming>Flow_6</incoming>
      <incoming>Flow_12</incoming>
      <outgoing>Flow_7</outgoing>
      <ioSpecification id="IO_S2_6">
        <dataOutput id="DOut_S2_6_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S2_6_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S2_6_1"><sourceRef>DOut_S2_6_1</sourceRef><targetRef>SR_S2_6_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S2_gw_7" name="登记对账差异？">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
      <outgoing>Flow_9</outgoing>
    </exclusiveGateway>
    <userTask id="S3_8" name="签字接受差异">
      <documentation>AGG-101 签字接受差异；B-20；in_system；总账.签字接受对账差异；外部法定账对账页（签字）；审批（aggregate）：对账差异签字</documentation>
      <incoming>Flow_9</incoming>
      <incoming>Flow_11</incoming>
      <outgoing>Flow_10</outgoing>
      <ioSpecification id="IO_S3_8">
        <dataOutput id="DOut_S3_8_1"/>
        <inputSet></inputSet>
        <outputSet><dataOutputRefs>DOut_S3_8_1</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation id="DOA_S3_8_1"><sourceRef>DOut_S3_8_1</sourceRef><targetRef>SR_S3_8_w1</targetRef></dataOutputAssociation>
    </userTask>
    <exclusiveGateway id="S3_gw_9" name="签字接受差异？">
      <incoming>Flow_10</incoming>
      <outgoing>Flow_11</outgoing>
      <outgoing>Flow_12</outgoing>
      <outgoing>Flow_13</outgoing>
    </exclusiveGateway>
    <endEvent id="End_10" name="对账未完成">
      <incoming>Flow_5</incoming>
    </endEvent>
    <endEvent id="End_11" name="差异已清零">
      <incoming>Flow_8</incoming>
    </endEvent>
    <endEvent id="End_12" name="已签字接受">
      <incoming>Flow_13</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_3"/>
    <sequenceFlow id="Flow_2" sourceRef="Start_2" targetRef="S1_3"/>
    <sequenceFlow id="Flow_3" sourceRef="S1_3" targetRef="S1_recv_4"/>
    <sequenceFlow id="Flow_4" sourceRef="S1_recv_4" targetRef="S1_gw_5"/>
    <sequenceFlow id="Flow_5" name="U8C 余额读取失败或无响应，告警并结束，待重试" sourceRef="S1_gw_5" targetRef="End_10"/>
    <sequenceFlow id="Flow_6" name="其他" sourceRef="S1_gw_5" targetRef="S2_6"/>
    <sequenceFlow id="Flow_7" sourceRef="S2_6" targetRef="S2_gw_7"/>
    <sequenceFlow id="Flow_8" name="差异清零" sourceRef="S2_gw_7" targetRef="End_11"/>
    <sequenceFlow id="Flow_9" name="其他" sourceRef="S2_gw_7" targetRef="S3_8"/>
    <sequenceFlow id="Flow_10" sourceRef="S3_8" targetRef="S3_gw_9"/>
    <sequenceFlow id="Flow_11" name="签字人与登记差异者为同一人，命令被拒，改由他人签字" sourceRef="S3_gw_9" targetRef="S3_8"/>
    <sequenceFlow id="Flow_12" name="不接受差异，退回重新查明并登记" sourceRef="S3_gw_9" targetRef="S2_6"/>
    <sequenceFlow id="Flow_13" name="其他" sourceRef="S3_gw_9" targetRef="End_12"/>
    <dataStoreReference id="SR_S1_3_r1" name="AGG-100" dataStoreRef="DS_AGG-100"/>
    <dataStoreReference id="SR_S1_3_r2" name="AGG-84" dataStoreRef="DS_AGG-84"/>
    <dataObject id="DObj_OR_S1_3_1"/>
    <dataObjectReference id="OR_S1_3_1" name="U8C 收付账套按法人 …" dataObjectRef="DObj_OR_S1_3_1"/>
    <dataStoreReference id="SR_S2_6_w1" name="AGG-101" dataStoreRef="DS_AGG-101"/>
    <dataStoreReference id="SR_S3_8_w1" name="AGG-101" dataStoreRef="DS_AGG-101"/>
  </process>
