# /etc/systemd/system/forcitis-one.service（E-6）
[Unit]
Description=FORCITIS one
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forcitis
Group=forcitis
EnvironmentFile=/etc/forcitis-one/one.env
WorkingDirectory=/data/forcitis-one/current
ExecStart=/usr/bin/java -Duser.timezone=UTC -XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/data/forcitis-one/tmp -jar /data/forcitis-one/current/forcitis-one.jar
StandardOutput=append:/data/forcitis-one/logs/forcitis-one.json
StandardError=append:/data/forcitis-one/logs/forcitis-one.stderr.log
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/data/forcitis-one/logs /data/forcitis-one/tmp
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
