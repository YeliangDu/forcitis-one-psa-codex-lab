diff --git a/psa-front-desk-pc/src/utils/sanitizeHtml.js b/psa-front-desk-pc/src/utils/sanitizeHtml.js
new file mode 100644
index 0000000..577aa37
--- /dev/null
+++ b/psa-front-desk-pc/src/utils/sanitizeHtml.js
@@ -0,0 +1,45 @@
+// 富文本白名单清洗：只保留展示所需的少量标签与样式，其余标签去壳留文本，脚本/样式块整体丢弃。
+// 用于 v-html 渲染后端拼装、且可能经用户保存回写的片段（如周例会「工作进展」）。
+const ALLOWED_TAGS = ['SPAN', 'BR', 'B', 'STRONG']
+const DROPPED_TAGS = ['SCRIPT', 'STYLE', 'TEMPLATE', 'NOSCRIPT', 'IFRAME', 'OBJECT', 'EMBED']
+const ALLOWED_STYLES = ['font-weight', 'font-family', 'font-size', 'color']
+
+function copySafeNodes(source, target) {
+  source.childNodes.forEach((node) => {
+    if (node.nodeType === Node.TEXT_NODE) {
+      target.appendChild(document.createTextNode(node.textContent))
+      return
+    }
+    if (node.nodeType !== Node.ELEMENT_NODE || DROPPED_TAGS.includes(node.tagName)) {
+      return
+    }
+    if (!ALLOWED_TAGS.includes(node.tagName)) {
+      copySafeNodes(node, target)
+      return
+    }
+    const el = document.createElement(node.tagName.toLowerCase())
+    ALLOWED_STYLES.forEach((prop) => {
+      const value = node.style.getPropertyValue(prop)
+      if (value) {
+        el.style.setProperty(prop, value)
+      }
+    })
+    copySafeNodes(node, el)
+    target.appendChild(el)
+  })
+}
+
+/**
+ * @param {string} html 待渲染的 HTML 片段
+ * @returns {string} 仅含白名单标签/样式的 HTML
+ */
+export function sanitizeRichText(html) {
+  if (!html) {
+    return ''
+  }
+  // DOMParser 产出的是惰性文档：不执行脚本、不加载资源
+  const doc = new DOMParser().parseFromString(String(html), 'text/html')
+  const container = document.createElement('div')
+  copySafeNodes(doc.body, container)
+  return container.innerHTML
+}
