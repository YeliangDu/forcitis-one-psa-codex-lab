new file mode 100644
index 0000000..39e7273
--- /dev/null
+++ b/psa-backend/yudao-framework/yudao-spring-boot-starter-security/src/main/java/cn/iocoder/yudao/framework/security/core/filter/InternalRpcTokenFilter.java
@@ -0,0 +1,57 @@
+package cn.iocoder.yudao.framework.security.core.filter;
+
+import cn.iocoder.yudao.framework.common.enums.RpcConstants;
+import cn.iocoder.yudao.framework.common.util.rpc.InternalRpcTokenUtils;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+import javax.servlet.FilterChain;
+import javax.servlet.ServletException;
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+import java.io.IOException;
+
+/**
+ * 保护本服务的全部 {@code /rpc-api/**}（SEC-107 / SEC-111）：必须携带与 {@code system.rpc.internal-token}
+ * 或轮换期的 {@code system.rpc.internal-token-previous} 一致的内部调用凭证。
+ *
+ * <p>各服务的 {@code /rpc-api/**} 在 Spring Security 中是 permitAll（system 含 oauth2/token/create 等可为任意用户签发令牌的接口），
+ * 服务端口与网关、nginx 同机部署时无法按来源地址区分调用方，因此只认凭证。
+ * 凭证未配置时一律拒绝（失败即拒绝），不会退化为放行，也不阻止服务启动。
+ */
+@Slf4j
+public class InternalRpcTokenFilter extends OncePerRequestFilter {
+
+    public static final String HEADER_NAME = RpcConstants.INTERNAL_TOKEN_HEADER;
+    /**
+     * 注册到 Servlet 容器的匹配模式；容器按规范化后的路径匹配，覆盖本服务的全部 RPC 接口
+     */
+    public static final String PROTECTED_URL_PATTERN = RpcConstants.RPC_API_PREFIX + "/*";
+
+    private final String expectedToken;
+    private final String previousToken;
+
+    public InternalRpcTokenFilter(String expectedToken, String previousToken) {
+        this.expectedToken = expectedToken;
+        this.previousToken = previousToken;
+        if (!InternalRpcTokenUtils.isConfigured(expectedToken)) {
+            log.error("[InternalRpcTokenFilter][{} 未配置，本服务的 {}/** 将全部返回 401，"
+                    + "请在 Nacos psa-system-rpc.yaml 中配置后重启]", RpcConstants.INTERNAL_TOKEN_PROPERTY,
+                    RpcConstants.RPC_API_PREFIX);
+        } else if (InternalRpcTokenUtils.isConfigured(previousToken)) {
+            log.warn("[InternalRpcTokenFilter][{} 已配置，处于内部凭证轮换期；轮换完成后请删除并重启]",
+                    RpcConstants.INTERNAL_TOKEN_PREVIOUS_PROPERTY);
+        }
+    }
+
+    @Override
+    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response,
+                                    FilterChain filterChain) throws ServletException, IOException {
+        if (!InternalRpcTokenUtils.matchesAny(expectedToken, previousToken, request.getHeader(HEADER_NAME))) {
+            response.sendError(HttpStatus.UNAUTHORIZED.value(), "internal rpc authentication required");
+            return;
+        }
+        filterChain.doFilter(request, response);
+    }
+}
