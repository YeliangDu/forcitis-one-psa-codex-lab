@@ -0,0 +1,165 @@
+package cn.iocoder.yudao.module.system.service.sms;
+
+import cn.iocoder.yudao.framework.common.exception.ServiceException;
+import cn.iocoder.yudao.module.system.api.sms.dto.code.SmsCodeSendReqDTO;
+import cn.iocoder.yudao.module.system.api.sms.dto.code.SmsCodeUseReqDTO;
+import cn.iocoder.yudao.module.system.dal.dataobject.sms.SmsCodeDO;
+import cn.iocoder.yudao.module.system.dal.mysql.sms.SmsCodeMapper;
+import cn.iocoder.yudao.module.system.framework.sms.SmsCodeProperties;
+import com.baomidou.mybatisplus.core.conditions.Wrapper;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.time.Duration;
+import java.time.LocalDateTime;
+
+import static cn.iocoder.yudao.module.system.enums.ErrorCodeConstants.*;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.isNull;
+import static org.mockito.Mockito.*;
+
+/**
+ * SEC-116 / SEC-121：固定验证码、无限次猜测与并发猜测
+ */
+class SmsCodeServiceImplSecurityTest {
+
+    private static final String MOBILE = "13800000000";
+    private static final int SCENE = 21;
+
+    private final SmsCodeServiceImpl service = new SmsCodeServiceImpl();
+    private final SmsCodeMapper mapper = mock(SmsCodeMapper.class);
+    private final SmsSendService smsSendService = mock(SmsSendService.class);
+    private final SmsCodeProperties properties = new SmsCodeProperties();
+
+    @BeforeEach
+    void setUp() {
+        properties.setExpireTimes(Duration.ofMinutes(10));
+        properties.setSendFrequency(Duration.ofMinutes(1));
+        properties.setSendMaximumQuantityPerDay(10);
+        properties.setBeginCode(100000);
+        properties.setEndCode(999999);
+        ReflectionTestUtils.setField(service, "smsCodeMapper", mapper);
+        ReflectionTestUtils.setField(service, "smsCodeProperties", properties);
+        ReflectionTestUtils.setField(service, "smsSendService", smsSendService);
+    }
+
+    @Test
+    void rangeCheckRejectsFixedOrShortCodes() {
+        assertThat(SmsCodeServiceImpl.isCodeRangeSecure(9999, 9999)).isFalse();
+        assertThat(SmsCodeServiceImpl.isCodeRangeSecure(1000, 9999)).isFalse();
+        assertThat(SmsCodeServiceImpl.isCodeRangeSecure(null, 999999)).isFalse();
+        assertThat(SmsCodeServiceImpl.isCodeRangeSecure(100000, 999999)).isTrue();
+    }
+
+    @Test
+    void refusesToSendWhenRangeIsFixed() {
+        properties.setBeginCode(9999);
+        properties.setEndCode(9999);
+
+        assertThatThrownBy(() -> service.sendSmsCode(sendReq()))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(SMS_CODE_RANGE_INSECURE.getCode());
+        verify(mapper, never()).insert(any(SmsCodeDO.class));
+        verifyNoInteractions(smsSendService);
+    }
+
+    @Test
+    void sendsSixDigitCodeWithDefaultRange() {
+        service.sendSmsCode(sendReq());
+
+        ArgumentCaptor<SmsCodeDO> captor = ArgumentCaptor.forClass(SmsCodeDO.class);
+        verify(mapper).insert(captor.capture());
+        assertThat(captor.getValue().getCode()).hasSize(6);
+    }
+
+    @Test
+    void wrongCodeBurnsTheLatestCode() {
+        when(mapper.selectLastByMobile(eq(MOBILE), isNull(), eq(SCENE))).thenReturn(code(7, "123456", false));
+        when(mapper.update(any(SmsCodeDO.class), any(Wrapper.class))).thenReturn(1);
+
+        assertThatThrownBy(() -> service.checkSmsCode0(MOBILE, "654321", SCENE))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(SMS_CODE_NOT_CORRECT.getCode());
+        ArgumentCaptor<SmsCodeDO> captor = ArgumentCaptor.forClass(SmsCodeDO.class);
+        verify(mapper).update(captor.capture(), any(Wrapper.class));
+        assertThat(captor.getValue().getUsed()).isTrue();
+    }
+
+    @Test
+    void useClaimsBeforeComparingSoAWrongGuessBurnsTheCode() {
+        when(mapper.selectLastByMobile(eq(MOBILE), isNull(), eq(SCENE))).thenReturn(code(7, "123456", false));
+        when(mapper.update(any(SmsCodeDO.class), any(Wrapper.class))).thenReturn(1);
+
+        assertThatThrownBy(() -> service.useSmsCode(useReq("654321")))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(SMS_CODE_NOT_CORRECT.getCode());
+        verify(mapper).update(any(SmsCodeDO.class), any(Wrapper.class));
+    }
+
+    @Test
+    void concurrentLoserCannotUseTheCode() {
+        // 另一个并发请求已占用（条件更新 0 行）→ 即使 code 正确也拒绝（SEC-121）
+        when(mapper.selectLastByMobile(eq(MOBILE), isNull(), eq(SCENE))).thenReturn(code(7, "123456", false));
+        when(mapper.update(any(SmsCodeDO.class), any(Wrapper.class))).thenReturn(0);
+
+        assertThatThrownBy(() -> service.useSmsCode(useReq("123456")))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(SMS_CODE_USED.getCode());
+    }
+
+    @Test
+    void correctCodeIsConsumedOnce() {
+        when(mapper.selectLastByMobile(eq(MOBILE), isNull(), eq(SCENE))).thenReturn(code(7, "123456", false));
+        when(mapper.update(any(SmsCodeDO.class), any(Wrapper.class))).thenReturn(1);
+
+        service.useSmsCode(useReq("123456"));
+        verify(mapper).update(any(SmsCodeDO.class), any(Wrapper.class));
+        verify(mapper, never()).updateById(any(SmsCodeDO.class));
+    }
+
+    @Test
+    void burnedCodeCannotBeRetriedEvenWithTheRightValue() {
+        when(mapper.selectLastByMobile(eq(MOBILE), isNull(), eq(SCENE))).thenReturn(code(7, "123456", true));
+
+        assertThatThrownBy(() -> service.checkSmsCode0(MOBILE, "123456", SCENE))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(SMS_CODE_USED.getCode());
+    }
+
+    @Test
+    void onlyTheLatestCodeIsLookedUp() {
+        when(mapper.selectLastByMobile(eq(MOBILE), isNull(), eq(SCENE))).thenReturn(code(8, "111111", false));
+
+        assertThat(service.checkSmsCode0(MOBILE, "111111", SCENE).getId()).isEqualTo(8);
+        // 不再按用户提交的 code 去查（否则可对任一已发验证码反复猜）
+        verify(mapper, never()).selectLastByMobile(any(), eq("111111"), any());
+    }
+
+    private static SmsCodeUseReqDTO useReq(String value) {
+        SmsCodeUseReqDTO reqDTO = new SmsCodeUseReqDTO();
+        reqDTO.setMobile(MOBILE);
+        reqDTO.setScene(SCENE);
+        reqDTO.setCode(value);
+        reqDTO.setUsedIp("127.0.0.1");
+        return reqDTO;
+    }
+
+    private static SmsCodeSendReqDTO sendReq() {
+        SmsCodeSendReqDTO reqDTO = new SmsCodeSendReqDTO();
+        reqDTO.setMobile(MOBILE);
+        reqDTO.setScene(SCENE);
+        reqDTO.setCreateIp("127.0.0.1");
+        return reqDTO;
+    }
+
+    private static SmsCodeDO code(Integer id, String value, boolean used) {
+        SmsCodeDO codeDO = SmsCodeDO.builder().id(id).mobile(MOBILE).code(value).scene(SCENE).used(used).build();
+        codeDO.setCreateTime(LocalDateTime.now());
+        return codeDO;
+    }
+
+}
