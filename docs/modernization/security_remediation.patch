+import cn.iocoder.yudao.module.fst.enums.fst.FSTConstant;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import javax.annotation.PostConstruct;
+
+/**
+ * 把 Nacos 下发的凭据回填到 {@link CommonConstants} / {@link FSTConstant} 的静态字段，保持既有静态引用不变、仓库不再存值。
+ * 缺失的键只告警不阻断启动（保留字段现值）：对应功能（企业微信消息 / 回调验签）在调用时失败。
