+package cn.iocoder.yudao.module.fst.controller.admin.wecom;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * SEC-119：卡片 EventKey 严格按 task_{1|0}_{任务ID}_{接收人ID} 解析
+ */
+class WeComTaskCardKeyTest {
+
+    @Test
+    void parsesWellFormedKey() {
+        WeComTaskCardKey key = WeComTaskCardKey.parse("task_1_555_2001");
+
+        assertThat(key).isNotNull();
+        assertThat(key.getResult()).isEqualTo("1");
+        assertThat(key.getTaskId()).isEqualTo(555L);
+        assertThat(key.getRecipientUserId()).isEqualTo(2001L);
+    }
+
+    @Test
+    void rejectsMalformedKeys() {
+        assertThat(WeComTaskCardKey.parse(null)).isNull();
+        assertThat(WeComTaskCardKey.parse("task_1_555")).isNull();          // 缺接收人段：旧实现会跳过比对
+        assertThat(WeComTaskCardKey.parse("task_1_555_2001_x")).isNull();
+        assertThat(WeComTaskCardKey.parse("task_1_555_")).isNull();
+        assertThat(WeComTaskCardKey.parse("task_2_555_2001")).isNull();
+        assertThat(WeComTaskCardKey.parse("plan_1_555_2001")).isNull();
+        assertThat(WeComTaskCardKey.parse("task_1_abc_2001")).isNull();
+    }
+
+}
