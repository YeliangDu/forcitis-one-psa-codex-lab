+SET XACT_ABORT ON;
+-- SEC-003：期初管理与费用明细修正接口由 @PermitAll 改为 @PreAuthorize，补齐按钮权限行，
+-- 并只授权给已持有对应页面菜单的角色（按页面 component 匹配，不按共同上级目录扩权）。
+IF OBJECT_ID(N'dbo.system_menu',N'U') IS NULL OR OBJECT_ID(N'dbo.system_role_menu',N'U') IS NULL
+    OR OBJECT_ID(N'dbo.system_role',N'U') IS NULL RETURN;
+DECLARE @Locked BIGINT;
+SELECT @Locked=COUNT_BIG(*) FROM dbo.system_menu WITH(TABLOCKX,HOLDLOCK);
+SELECT @Locked=COUNT_BIG(*) FROM dbo.system_role_menu WITH(TABLOCKX,HOLDLOCK);
+
+-- 按钮挂载位置：期初各页面（costopenning/*，不含费用修正）共同的上级目录；费用修正页面本身。
+-- 解析不到或不唯一时挂到根（parent_id=0）并告警，不阻断启动；授权不依赖挂载位置。
+DECLARE @OpeningParent BIGINT,@CorrectionParent BIGINT,@Count INT;
+SELECT @Count=COUNT(DISTINCT parent_id),@OpeningParent=MAX(parent_id) FROM dbo.system_menu
+WHERE deleted=0 AND type=2 AND component LIKE N'%costopenning/%' AND component NOT LIKE N'%costCorrection%';
+IF @Count<>1
+BEGIN
+    PRINT N'WARN SEC-003: cost opening page parent missing or ambiguous, buttons placed under parent_id=0';
+    SET @OpeningParent=0;
+END;
+SELECT @Count=COUNT(*),@CorrectionParent=MAX(id) FROM dbo.system_menu
+WHERE deleted=0 AND type=2 AND component LIKE N'%costopenning/costCorrection%';
+IF @Count<>1
+BEGIN
+    PRINT N'WARN SEC-003: cost correction page missing or ambiguous, buttons placed under parent_id=0';
+    SET @CorrectionParent=0;
+END;
+
+DECLARE @Identity BIT=CONVERT(BIT,COLUMNPROPERTY(OBJECT_ID(N'dbo.system_menu'),N'id',N'IsIdentity'));
+DECLARE @Next BIGINT=(SELECT ISNULL(MAX(id),0)+1 FROM dbo.system_menu);
+DECLARE @Now DATETIME2(3)=SYSUTCDATETIME();
+DECLARE @Desired TABLE(name NVARCHAR(50),permission NVARCHAR(100),sort INT,parent_id BIGINT);
+INSERT INTO @Desired VALUES
+(N'期初查询',N'cost:opening:query',101,@OpeningParent),
+(N'期初执行',N'cost:opening:execute',102,@OpeningParent),
+(N'期初重置',N'cost:opening:reset',103,@OpeningParent),
+(N'期初正式重置',N'cost:opening:official-reset',104,@OpeningParent),
+(N'费用修正查询',N'cost:correction:query',1,@CorrectionParent),
+(N'费用修正编辑',N'cost:correction:edit',2,@CorrectionParent),
+(N'费用修正导入',N'cost:correction:import',3,@CorrectionParent);
+DECLARE @Name NVARCHAR(50),@Permission NVARCHAR(100),@Sort INT,@Parent BIGINT,@Id BIGINT;
+DECLARE permissions CURSOR LOCAL FAST_FORWARD FOR SELECT name,permission,sort,parent_id FROM @Desired ORDER BY permission;
+OPEN permissions;
+FETCH NEXT FROM permissions INTO @Name,@Permission,@Sort,@Parent;
+WHILE @@FETCH_STATUS=0
+BEGIN
+    SET @Id=NULL;
+    SELECT @Count=COUNT(*),@Id=MAX(id) FROM dbo.system_menu WHERE permission=@Permission AND deleted=0;
+    IF @Count>1 THROW 51420,'cost_permission_duplicate',1;
+    IF @Id IS NULL AND EXISTS(SELECT 1 FROM dbo.system_menu WHERE permission=@Permission AND deleted<>0)
+        THROW 51420,'cost_permission_deleted_collision',1;
+    IF @Id IS NOT NULL
+    BEGIN
+        -- 已由管理员手工建过：不搬迁、不改名，只要求仍是按钮类型
+        IF EXISTS(SELECT 1 FROM dbo.system_menu WHERE id=@Id AND type<>3)
+            THROW 51420,'cost_permission_contract_conflict',1;
+    END
+    ELSE IF @Identity=1
+        INSERT INTO dbo.system_menu(name,permission,type,sort,parent_id,path,icon,component,status,visible,keep_alive,creator,create_time,updater,update_time,deleted)
+        VALUES(@Name,@Permission,3,@Sort,@Parent,N'',N'',N'',0,'1','1',N'flyway',@Now,N'flyway',@Now,0);
+    ELSE
+    BEGIN
+        INSERT INTO dbo.system_menu(id,name,permission,type,sort,parent_id,path,icon,component,status,visible,keep_alive,creator,create_time,updater,update_time,deleted)
+        VALUES(@Next,@Name,@Permission,3,@Sort,@Parent,N'',N'',N'',0,'1','1',N'flyway',@Now,N'flyway',@Now,0);
+        SET @Next+=1;
+    END;
+    FETCH NEXT FROM permissions INTO @Name,@Permission,@Sort,@Parent;
+END;
+CLOSE permissions;
+DEALLOCATE permissions;
+
+-- 授权规则：持有页面（type=2，按 component 匹配）的角色 → 对应按钮。
+--   期初任一页面 → query；试运行/正式执行页、收入事件页 → execute；试运行/正式执行页 → reset（/reset）；
+--   仅正式执行页 → official-reset（/official/reset）；费用修正页 → query/edit/import
+DECLARE @Rule TABLE(permission NVARCHAR(100),page_like NVARCHAR(200),page_not_like NVARCHAR(200));
+INSERT INTO @Rule VALUES
+(N'cost:opening:query',N'%costopenning/%',N'%costCorrection%'),
+(N'cost:opening:execute',N'%costopenning/execute%',NULL),
+(N'cost:opening:execute',N'%costopenning/revenueEvents%',NULL),
+(N'cost:opening:reset',N'%costopenning/execute%',NULL),
+(N'cost:opening:official-reset',N'%costopenning/executeOfficial%',NULL),
+(N'cost:correction:query',N'%costopenning/costCorrection%',NULL),
+(N'cost:correction:edit',N'%costopenning/costCorrection%',NULL),
+(N'cost:correction:import',N'%costopenning/costCorrection%',NULL);
+DECLARE @RoleMenuIdentity BIT=CONVERT(BIT,COLUMNPROPERTY(OBJECT_ID(N'dbo.system_role_menu'),N'id',N'IsIdentity'));
+DECLARE @NextRoleMenu BIGINT=(SELECT ISNULL(MAX(id),0)+1 FROM dbo.system_role_menu);
+DECLARE @RoleId BIGINT,@MenuId BIGINT,@TenantId BIGINT;
+DECLARE grants CURSOR LOCAL FAST_FORWARD FOR
+    SELECT DISTINCT rm.role_id,b.id,rm.tenant_id
+    FROM @Rule r
+    JOIN dbo.system_menu b ON b.permission=r.permission AND b.deleted=0 AND b.type=3
+    JOIN dbo.system_menu p ON p.deleted=0 AND p.type=2 AND p.component LIKE r.page_like
+        AND (r.page_not_like IS NULL OR p.component NOT LIKE r.page_not_like)
+    JOIN dbo.system_role_menu rm ON rm.menu_id=p.id AND rm.deleted=0
+    JOIN dbo.system_role ro ON ro.id=rm.role_id AND ro.deleted=0
+    WHERE NOT EXISTS(SELECT 1 FROM dbo.system_role_menu x
+                     WHERE x.role_id=rm.role_id AND x.menu_id=b.id AND x.tenant_id=rm.tenant_id AND x.deleted=0)
+    ORDER BY rm.role_id,b.id,rm.tenant_id;
+OPEN grants;
+FETCH NEXT FROM grants INTO @RoleId,@MenuId,@TenantId;
+WHILE @@FETCH_STATUS=0
+BEGIN
+    IF @RoleMenuIdentity=1
+        INSERT INTO dbo.system_role_menu(role_id,menu_id,creator,create_time,updater,update_time,tenant_id,deleted)
+        VALUES(@RoleId,@MenuId,N'flyway',@Now,N'flyway',@Now,@TenantId,0);
+    ELSE
+    BEGIN
+        INSERT INTO dbo.system_role_menu(id,role_id,menu_id,creator,create_time,updater,update_time,tenant_id,deleted)
+        VALUES(@NextRoleMenu,@RoleId,@MenuId,N'flyway',@Now,N'flyway',@Now,@TenantId,0);
+        SET @NextRoleMenu+=1;
+    END;
+    FETCH NEXT FROM grants INTO @RoleId,@MenuId,@TenantId;
+END;
+CLOSE grants;
+DEALLOCATE grants;
