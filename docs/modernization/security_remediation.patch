@@ -0,0 +1,62 @@
+package cn.iocoder.yudao.gateway.filter.security;
+
+import cn.iocoder.yudao.framework.common.enums.RpcConstants;
+import org.springframework.cloud.gateway.filter.GatewayFilterChain;
+import org.springframework.cloud.gateway.filter.GlobalFilter;
+import org.springframework.core.Ordered;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.server.reactive.ServerHttpRequest;
+import org.springframework.stereotype.Component;
+import org.springframework.web.server.ServerWebExchange;
+import reactor.core.publisher.Mono;
+
+import java.util.Locale;
+
+/**
+ * 内部调用凭证边界（SEC-107 / SEC-113）。
+ *
+ * <ol>
+ *     <li>删除客户端自带的 {@code X-PSA-Internal-Token} 与 {@code login-user}：下游只在带有效凭证时采信 login-user，
+ *     客户端伪造的两者都必须在这里去掉（{@link TokenAuthenticationFilter} 中的 removeLoginUser 返回值被丢弃，并未生效）；</li>
+ *     <li>拒绝路径中含 {@code /rpc-api} 的请求，内部接口不经网关对外。</li>
+ * </ol>
+ *
+ * <p>本过滤器<b>不</b>给转发请求附内部凭证。凭证只在网关确实写入 login-user 时由 {@link TokenAuthenticationFilter} 一并附上；
+ * 网关当前跳过令牌解析、从不写 login-user，因此转发到下游的外部请求不带凭证，由下游按 Authorization 自行校验。
+ */
+@Component
+public class InternalTokenRelayFilter implements GlobalFilter, Ordered {
+
+    static final String LOGIN_USER_HEADER = "login-user";
+
+    @Override
+    public Mono<Void> filter(ServerWebExchange exchange, GatewayFilterChain chain) {
+        if (isRpcPath(exchange.getRequest())) {
+            exchange.getResponse().setStatusCode(HttpStatus.NOT_FOUND);
+            return exchange.getResponse().setComplete();
+        }
+        ServerHttpRequest request = exchange.getRequest().mutate().headers(headers -> {
+            headers.remove(RpcConstants.INTERNAL_TOKEN_HEADER);
+            headers.remove(LOGIN_USER_HEADER);
+        }).build();
+        return chain.filter(exchange.mutate().request(request).build());
+    }
+
+    private static boolean isRpcPath(ServerHttpRequest request) {
+        String rawPath = request.getURI().getRawPath();
+        String decodedPath = request.getURI().getPath();
+        String marker = RpcConstants.RPC_API_PREFIX.toLowerCase(Locale.ROOT);
+        return (rawPath != null && rawPath.toLowerCase(Locale.ROOT).contains(marker))
+                || (decodedPath != null && decodedPath.toLowerCase(Locale.ROOT).contains(marker));
+    }
+
+    /**
+     * 紧随 {@link ClientIpHeaderFilter}，早于 {@link TokenAuthenticationFilter}（-100），
+     * 后者写入的 login-user 与内部凭证不会被本过滤器删除
+     */
+    @Override
+    public int getOrder() {
+        return Ordered.HIGHEST_PRECEDENCE + 1;
+    }
+
+}
