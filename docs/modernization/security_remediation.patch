+package cn.iocoder.yudao.module.system.framework.sso;
+
+import cn.hutool.core.lang.Validator;
+import cn.hutool.core.net.NetUtil;
+import cn.hutool.core.util.StrUtil;
+import cn.hutool.crypto.SecureUtil;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.data.redis.core.StringRedisTemplate;
+import org.springframework.stereotype.Component;
+
+import javax.annotation.PostConstruct;
+import javax.annotation.Resource;
+import javax.servlet.http.HttpServletRequest;
+import java.net.InetAddress;
+import java.net.UnknownHostException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+import static cn.iocoder.yudao.framework.common.exception.util.ServiceExceptionUtil.exception;
+import static cn.iocoder.yudao.module.system.enums.ErrorCodeConstants.AUTH_TRUSTED_CALLER_REJECTED;
+
+/**
+ * 外部系统免密登录入口的调用方校验：HMAC-SHA256 签名 + 时间窗 + nonce 一次性 + 按调用方限定入口与来源 IP。
+ *
+ * <p>签名串：{@code caller \n timestamp \n nonce \n endpoint \n subject}，
+ * timestamp 为 13 位毫秒时间戳，nonce 为 16~64 位 [A-Za-z0-9_-]，sign 为小写十六进制；subject 为请求里携带的用户标识原值。
+ * 参数名：{@code caller} / {@code timestamp} / {@code nonce} / {@code sign}，与用户标识放在同一载体（JSON 体或查询参数）。
+ */
+@Component
+@Slf4j
+public class TrustedCallerVerifier {
+
+    public static final String PARAM_CALLER = "caller";
+    public static final String PARAM_TIMESTAMP = "timestamp";
+    public static final String PARAM_NONCE = "nonce";
+    public static final String PARAM_SIGN = "sign";
+    /**
+     * yudao-gateway ClientIpHeaderFilter 写入的对端地址头：网关先删除客户端自带的同名头，再按 TCP 对端地址重写
+     */
+    public static final String HEADER_CLIENT_IP = "X-PSA-Client-IP";
+
+    public static final String ENDPOINT_CUSTOMIZATION_LOGIN = "customization-login";
+    public static final String ENDPOINT_CUSTOMIZATION_LOGIN_ID = "customization-login/id";
+    public static final String ENDPOINT_A8_LOGIN = "a8-login";
+    public static final String ENDPOINT_YD_GET = "singleSignOn/YD-get";
+
+    private static final Set<String> ENDPOINTS = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(
+            ENDPOINT_CUSTOMIZATION_LOGIN, ENDPOINT_CUSTOMIZATION_LOGIN_ID, ENDPOINT_A8_LOGIN, ENDPOINT_YD_GET)));
+    /**
+     * 浏览器跳转入口：来源 IP 是终端用户浏览器，IP 白名单无意义，必须签名（或改走 /seeyon-sso）
+     */
+    private static final Set<String> SIGNATURE_ONLY_ENDPOINTS = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(
+            ENDPOINT_A8_LOGIN, ENDPOINT_YD_GET)));
+
+    private static final String NONCE_KEY_PREFIX = "trusted_caller_sso:nonce:";
+    private static final Pattern NONCE_PATTERN = Pattern.compile("^[A-Za-z0-9_-]{16,64}$");
+    private static final Pattern TIMESTAMP_PATTERN = Pattern.compile("^\\d{13}$");
+    private static final int LEGACY_MIN_CIDR_PREFIX = 29;
+
+    @Resource
+    private TrustedCallerProperties properties;
+    @Resource
+    private StringRedisTemplate stringRedisTemplate;
+
+    /**
+     * gateway-addresses 的规整结果（InetAddress 规整后的字面量），配置经 Nacos 刷新后按原始列表变化重新规整
+     */
+    private volatile List<String> cachedGatewayRaw = Collections.emptyList();
+    private volatile Set<String> cachedGatewayAddresses = Collections.emptySet();
+
+    @PostConstruct
+    public void checkConfig() {
+        Set<String> gateways = gatewayAddresses();
+        for (String entry : properties.getGatewayAddresses()) {
+            if (normalizeIp(entry) == null) {
+                log.error("[checkConfig][gateway-addresses 中的({}) 不是 IP 字面量，已忽略]", entry);
+            }
+        }
+        if (properties.isRequireSignature() && properties.getCallers().isEmpty()) {
+            log.error("[checkConfig][psa.sso.trusted-callers 未配置任何调用方且 require-signature=true，免密登录入口 {} 将全部拒绝]",
+                    ENDPOINTS);
+        }
+        if (!properties.isRequireSignature() && properties.getGatewayAddresses().isEmpty()) {
+            log.error("[checkConfig][require-signature=false 但未配置 gateway-addresses，未签名请求将全部拒绝]");
+        }
+        properties.getCallers().forEach((code, caller) -> {
+            for (String endpoint : caller.getEndpoints()) {
+                if (!ENDPOINTS.contains(endpoint)) {
+                    log.error("[checkConfig][调用方({}) 登记了未知入口({})，可选值 {}]", code, endpoint, ENDPOINTS);
+                }
+            }
+            for (String rule : caller.getLegacyAllowedIps()) {
+                if (isTooWideLegacyRule(rule)) {
+                    log.error("[checkConfig][调用方({}) 的 legacy-allowed-ips 规则({}) 宽于 /{}，已忽略]",
+                            code, rule, LEGACY_MIN_CIDR_PREFIX);
+                } else if (coversLoopbackOrGateway(rule, gateways)) {
+                    // nginx / 网关同机时经它们进入的请求来源都是回环或网关地址，此类规则等于对所有经代理的请求开放
+                    log.error("[checkConfig][调用方({}) 的 legacy-allowed-ips 规则({}) 包含回环地址或 gateway-addresses 中的地址，"
+                            + "会让经 nginx / 网关进入的任意请求免签名通过，已忽略]", code, rule);
+                }
+            }
+        });
+    }
+
+    /**
+     * 校验不通过抛 {@code AUTH_TRUSTED_CALLER_REJECTED}；只做调用方鉴别，用户存在/启用/角色校验由登录服务负责
+     *
+     * @param endpoint 入口标识（本类 ENDPOINT_* 常量），参与签名，防止跨入口复用
+     * @param subject  请求携带的用户标识原值
+     * @param params   携带签名参数的载体
+     */
+    public void verify(HttpServletRequest request, String endpoint, String subject, Map<?, ?> params) {
+        String clientIp = resolveClientIp(request);
+        String callerCode = str(params, PARAM_CALLER);
+        if (StrUtil.isBlank(subject) || StrUtil.containsAny(subject, '\r', '\n')) {
+            throw reject(endpoint, clientIp, "bad subject from caller " + callerCode);
+        }
+        String sign = str(params, PARAM_SIGN);
+        if (StrUtil.isBlank(sign)) {
+            verifyUnsigned(request, endpoint, subject, callerCode, clientIp);
+            return;
+        }
+        TrustedCallerProperties.Caller caller = callerCode == null ? null : properties.getCallers().get(callerCode);
+        if (caller == null || StrUtil.isBlank(caller.getSecret())) {
+            throw reject(endpoint, clientIp, "unknown caller " + callerCode);
+        }
+        if (!caller.getEndpoints().contains(endpoint)) {
+            throw reject(endpoint, clientIp, "endpoint not granted to caller " + callerCode);
+        }
+        if (!caller.getAllowedIps().isEmpty() && !matchesAny(clientIp, caller.getAllowedIps(), false, null)) {
+            throw reject(endpoint, clientIp, "ip not allowed for caller " + callerCode);
+        }
+        String timestamp = str(params, PARAM_TIMESTAMP);
+        String nonce = str(params, PARAM_NONCE);
+        if (timestamp == null || !TIMESTAMP_PATTERN.matcher(timestamp).matches()
+                || nonce == null || !NONCE_PATTERN.matcher(nonce).matches()) {
+            throw reject(endpoint, clientIp, "malformed signature params from caller " + callerCode);
+        }
+        long ts = Long.parseLong(timestamp);
+        long now = System.currentTimeMillis();
+        long skewMillis = properties.getMaxClockSkew().toMillis();
+        if (ts < now - skewMillis || ts > now + skewMillis) {
+            throw reject(endpoint, clientIp, "timestamp out of window from caller " + callerCode);
+        }
+        String payload = String.join("\n", callerCode, timestamp, nonce, endpoint, subject);
+        String expected = SecureUtil.hmacSha256(caller.getSecret()).digestHex(payload);
+        if (!MessageDigest.isEqual(expected.getBytes(StandardCharsets.UTF_8),
+                sign.toLowerCase().getBytes(StandardCharsets.UTF_8))) {
+            throw reject(endpoint, clientIp, "bad signature from caller " + callerCode);
+        }
+        // 验签通过后再占用 nonce，避免伪造请求刷占 Redis
+        Boolean firstUse = stringRedisTemplate.opsForValue().setIfAbsent(
+                NONCE_KEY_PREFIX + callerCode + ":" + nonce, endpoint, properties.getMaxClockSkew().multipliedBy(2));
+        if (!Boolean.TRUE.equals(firstUse)) {
+            throw reject(endpoint, clientIp, "nonce replayed by caller " + callerCode);
+        }
+    }
+
+    /**
+     * 过渡期未签名请求：必须经由已登记网关（且带网关写入的对端地址头）、来源 IP 命中某个登记了此入口的调用方
+     */
+    private void verifyUnsigned(HttpServletRequest request, String endpoint, String subject,
+                                String callerCode, String clientIp) {
+        if (properties.isRequireSignature()) {
+            throw reject(endpoint, clientIp, "missing signature");
+        }
+        if (SIGNATURE_ONLY_ENDPOINTS.contains(endpoint)) {
+            throw reject(endpoint, clientIp, "browser endpoint requires signature");
+        }
+        Set<String> gateways = gatewayAddresses();
+        if (!gateways.contains(normalizeIp(request.getRemoteAddr()))) {
+            throw reject(endpoint, clientIp, "unsigned request not via registered gateway " + request.getRemoteAddr());
+        }
+        if (StrUtil.isBlank(request.getHeader(HEADER_CLIENT_IP))) {
+            throw reject(endpoint, clientIp, "unsigned request without gateway client ip header");
+        }
+        for (Map.Entry<String, TrustedCallerProperties.Caller> entry : properties.getCallers().entrySet()) {
+            if (callerCode != null && !callerCode.equals(entry.getKey())) {
+                continue;
+            }
+            TrustedCallerProperties.Caller caller = entry.getValue();
+            if (caller.getEndpoints().contains(endpoint)
+                    && matchesAny(clientIp, caller.getLegacyAllowedIps(), true, gateways)) {
+                log.warn("[verify][未签名的免密登录请求按过渡期白名单放行 caller({}) endpoint({}) ip({}) subject({})]",
+                        safe(entry.getKey()), endpoint, safe(clientIp), safe(subject));
+                return;
+            }
+        }
+        throw reject(endpoint, clientIp, "unsigned request from unlisted ip, caller " + callerCode);
+    }
+
+    /**
+     * 不解析 X-Forwarded-For（客户端可预置任意段）。仅当 TCP 对端是已登记网关时，采用网关按其 TCP 对端地址写入的
+     * {@link #HEADER_CLIENT_IP}；其余情况一律取 TCP 对端地址
+     */
+    private String resolveClientIp(HttpServletRequest request) {
+        String remoteAddr = request.getRemoteAddr();
+        String normalizedRemote = normalizeIp(remoteAddr);
+        if (normalizedRemote != null && gatewayAddresses().contains(normalizedRemote)) {
+            String gatewaySeen = normalizeIp(request.getHeader(HEADER_CLIENT_IP));
+            if (gatewaySeen != null) {
+                return gatewaySeen;
+            }
+        }
+        return normalizedRemote != null ? normalizedRemote : remoteAddr;
+    }
+
+    /**
+     * gateway-addresses 按 InetAddress 规整后的集合（{@code ::1} 与 {@code 0:0:0:0:0:0:0:1} 视为同一地址）；
+     * 非 IP 字面量的条目被忽略
+     */
+    private Set<String> gatewayAddresses() {
+        List<String> raw = properties.getGatewayAddresses();
+        if (raw == null) {
+            return Collections.emptySet();
+        }
+        if (!raw.equals(cachedGatewayRaw)) {
+            Set<String> normalized = new HashSet<>();
+            for (String entry : raw) {
+                String ip = normalizeIp(entry);
+                if (ip != null) {
+                    normalized.add(ip);
+                }
+            }
+            cachedGatewayAddresses = Collections.unmodifiableSet(normalized);
+            cachedGatewayRaw = new ArrayList<>(raw);
+        }
+        return cachedGatewayAddresses;
+    }
+
+    /**
+     * IP 字面量按 InetAddress 规整；非字面量（含主机名，避免触发 DNS）返回 null
+     */
+    static String normalizeIp(String value) {
+        String trimmed = StrUtil.trim(value);
+        if (StrUtil.isBlank(trimmed) || !(Validator.isIpv4(trimmed) || Validator.isIpv6(trimmed))) {
+            return null;
+        }
+        try {
+            return InetAddress.getByName(trimmed).getHostAddress();
+        } catch (UnknownHostException e) {
+            return null;
+        }
+    }
+
+    /**
+     * 过渡期规则是否覆盖回环地址或任一网关地址（SEC-108）：精确 IP 规整后比较，CIDR 按网段包含判断
+     */
+    private static boolean coversLoopbackOrGateway(String rule, Set<String> gateways) {
+        String trimmed = StrUtil.trim(rule);
+        if (StrUtil.isBlank(trimmed)) {
+            return false;
+        }
+        if (!trimmed.contains("/")) {
+            String ip = normalizeIp(trimmed);
+            if (ip == null) {
+                return false;
+            }
+            try {
+                return InetAddress.getByName(ip).isLoopbackAddress() || gateways.contains(ip);
+            } catch (UnknownHostException e) {
+                return false;
+            }
+        }
+        try {
+            if (NetUtil.isInRange("127.0.0.1", trimmed)) {
+                return true;
+            }
+            for (String gateway : gateways) {
+                if (Validator.isIpv4(gateway) && NetUtil.isInRange(gateway, trimmed)) {
+                    return true;
+                }
+            }
+        } catch (RuntimeException e) {
+            return true;
+        }
+        return false;
+    }
+
+    private static boolean matchesAny(String ip, List<String> rules, boolean legacy, Set<String> gateways) {
+        String normalizedIp = normalizeIp(ip);
+        if (normalizedIp == null || rules == null) {
+            return false;
+        }
+        for (String rule : rules) {
+            if (StrUtil.isBlank(rule) || (legacy && (isTooWideLegacyRule(rule)
+                    || coversLoopbackOrGateway(rule, gateways)))) {
+                continue;
+            }
+            try {
+                if (rule.contains("/") ? NetUtil.isInRange(normalizedIp, rule.trim())
+                        : normalizedIp.equals(normalizeIp(rule))) {
+                    return true;
+                }
+            } catch (RuntimeException e) {
+                log.warn("[matchesAny][无法匹配 ip({}) 与规则({})]", safe(ip), rule, e);
+            }
+        }
+        return false;
+    }
+
+    /**
+     * 过渡期白名单只允许精确 IP 或不宽于 /29 的网段，无法解析的前缀按过宽处理
+     */
+    private static boolean isTooWideLegacyRule(String rule) {
+        int slash = rule.indexOf('/');
+        if (slash < 0) {
+            return false;
+        }
+        try {
+            return Integer.parseInt(rule.substring(slash + 1).trim()) < LEGACY_MIN_CIDR_PREFIX;
+        } catch (NumberFormatException e) {
+            return true;
+        }
+    }
+
+    private static String str(Map<?, ?> params, String key) {
+        Object value = params == null ? null : params.get(key);
+        return value == null ? null : value.toString();
+    }
+
+    /**
