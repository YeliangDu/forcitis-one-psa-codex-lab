+package cn.iocoder.yudao.module.system.api.social;
+
+import cn.iocoder.yudao.framework.common.enums.RpcConstants;
+import org.junit.jupiter.api.Test;
+import org.springframework.core.annotation.AnnotatedElementUtils;
+import org.springframework.web.bind.annotation.RequestMapping;
+
+import java.lang.reflect.Method;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * SEC-115：SocialUserApi 的映射必须带 {@link SocialUserApi#PREFIX}，落在 /rpc-api 下由内部凭证过滤器保护，
+ * 不能再暴露在 /bind、/unbind 等根路径
+ */
+class SocialUserApiMappingTest {
+
+    @Test
+    void everyMappingIsUnderRpcPrefix() {
+        assertEquals(RpcConstants.RPC_API_PREFIX + "/system/social-user", SocialUserApi.PREFIX);
+        int mappings = 0;
+        for (Method method : SocialUserApi.class.getDeclaredMethods()) {
+            RequestMapping mapping = AnnotatedElementUtils.findMergedAnnotation(method, RequestMapping.class);
+            assertNotNull(mapping, method.getName());
+            for (String path : mapping.path()) {
+                assertTrue(path.startsWith(SocialUserApi.PREFIX + "/"), method.getName() + " -> " + path);
+                mappings++;
+            }
+        }
+        assertEquals(4, mappings);
+    }
+}
