+package cn.iocoder.yudao.gateway.filter.security;
+
+import lombok.Data;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.stereotype.Component;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * 网关前置代理配置（SEC-108）。
+ *
+ * <p>48088 由 nginx 反代到网关，网关看到的 TCP 对端恒为 nginx（同机即 127.0.0.1）。只有对端属于
+ * {@link #trustedProxies} 时，才采用 nginx 用 {@code proxy_set_header X-Real-IP $remote_addr} 写入的地址作为客户端 IP。
+ */
+@Component
+@ConfigurationProperties(prefix = "psa.gateway")
+@Data
+public class ClientIpProperties {
+
+    /**
+     * 前置代理的地址（精确 IP，IPv4 或 IPv6，按 InetAddress 规整后比较）；为空时一律以 TCP 对端为客户端 IP
+     */
+    private List<String> trustedProxies = new ArrayList<>();
+
+}
