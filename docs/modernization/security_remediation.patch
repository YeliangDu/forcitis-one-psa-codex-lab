+package cn.iocoder.yudao.framework.security.config;
+
+import cn.iocoder.yudao.framework.common.enums.RpcConstants;
+import cn.iocoder.yudao.framework.common.enums.WebFilterOrderEnum;
+import cn.iocoder.yudao.framework.security.core.filter.InternalRpcTokenFilter;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.AutoConfiguration;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnWebApplication;
+import org.springframework.boot.web.servlet.FilterRegistrationBean;
+import org.springframework.context.annotation.Bean;
+
+/**
+ * 为引入 security starter 的每个 Servlet 服务（system、infra、bpm、fst）注册 {@code /rpc-api/*} 内部调用凭证过滤器
+ * （SEC-107 / SEC-111）。配置项只在启动时读取，Nacos 刷新不会更新，修改后需重启。
+ *
+ * <p>顺序排在 Spring Security 过滤器链（{@code DelegatingFilterProxy}，默认 -100）和租户等过滤器之前（SEC-114），
+ * 无有效凭证的请求在进入 Spring Security 前即返回 401。
+ */
+@AutoConfiguration
+@ConditionalOnWebApplication(type = ConditionalOnWebApplication.Type.SERVLET)
+public class YudaoInternalRpcTokenAutoConfiguration {
+
+    @Bean
+    public FilterRegistrationBean<InternalRpcTokenFilter> internalRpcTokenFilter(
+            @Value("${" + RpcConstants.INTERNAL_TOKEN_PROPERTY + ":}") String token,
+            @Value("${" + RpcConstants.INTERNAL_TOKEN_PREVIOUS_PROPERTY + ":}") String previousToken) {
+        FilterRegistrationBean<InternalRpcTokenFilter> registration = new FilterRegistrationBean<>();
+        registration.setFilter(new InternalRpcTokenFilter(token, previousToken));
+        registration.addUrlPatterns(InternalRpcTokenFilter.PROTECTED_URL_PATTERN);
+        registration.setOrder(WebFilterOrderEnum.INTERNAL_RPC_TOKEN_FILTER);
+        return registration;
+    }
+
+}
