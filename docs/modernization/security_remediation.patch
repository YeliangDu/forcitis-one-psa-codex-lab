+package cn.iocoder.yudao.module.fst.controller.admin.wecom;
+
+import cn.iocoder.yudao.module.fst.enums.fst.FSTConstant;
+import lombok.AllArgsConstructor;
+import lombok.Getter;
+
+/**
+ * 任务卡片按钮的 EventKey：{@code task_{1接受|0拒绝}_{任务ID}_{卡片接收人ID}}（见 MessageServiceImpl 发卡片处）。
+ * <p>只做格式解析；身份以 FromUserName 为准，接收人段仅用于与之比对（SEC-119）。
+ */
+@Getter
+@AllArgsConstructor
+final class WeComTaskCardKey {
+
+    private final String result;
+    private final Long taskId;
+    private final Long recipientUserId;
+
+    /**
+     * @return 格式不符（段数不是 4、业务类型不是 task、结果不是接受或拒绝、ID 不是数字）时返回 null
+     */
+    static WeComTaskCardKey parse(String eventKey) {
+        if (eventKey == null) {
+            return null;
+        }
+        String[] parts = eventKey.split("_", -1);
+        if (parts.length != 4 || !"task".equals(parts[0])) {
+            return null;
+        }
+        String result = parts[1];
+        if (!FSTConstant.WeComCallbackResult.接受.equals(result) && !FSTConstant.WeComCallbackResult.拒绝.equals(result)) {
+            return null;
+        }
+        try {
+            return new WeComTaskCardKey(result, Long.valueOf(parts[2]), Long.valueOf(parts[3]));
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+}
