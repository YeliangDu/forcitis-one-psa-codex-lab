+package cn.iocoder.yudao.framework.rpc.core.feign;
+
+import cn.iocoder.yudao.framework.common.enums.RpcConstants;
+import cn.iocoder.yudao.framework.common.util.rpc.InternalRpcTokenUtils;
+import feign.RequestInterceptor;
+import feign.RequestTemplate;
+
+/**
+ * 全局 Feign 拦截器：所有指向 {@code /rpc-api/**} 的服务间调用都附上内部调用凭证。
+ *
+ * <p>被调方据此判断请求来自 PSA 内部组件（system 的 /rpc-api 鉴权、各服务对 login-user 头的采信）。
+ * 只对 /rpc-api 路径附加，避免将来接入第三方 Feign 客户端时把凭证发到外部。
+ * 先删除再设置，与个别客户端自带的同名拦截器叠加时也只保留一个值。
+ */
+public class InternalRpcTokenRequestInterceptor implements RequestInterceptor {
+
+    private final String token;
+
+    public InternalRpcTokenRequestInterceptor(String token) {
+        this.token = token;
+    }
+
+    @Override
+    public void apply(RequestTemplate template) {
+        if (!InternalRpcTokenUtils.isConfigured(token)) {
+            return;
+        }
+        String path = template.path();
+        if (path == null || !path.startsWith(RpcConstants.RPC_API_PREFIX + "/")) {
+            return;
+        }
+        template.removeHeader(RpcConstants.INTERNAL_TOKEN_HEADER);
+        template.header(RpcConstants.INTERNAL_TOKEN_HEADER, token);
+    }
+
+}
