+package cn.iocoder.yudao.module.bpm.service.oa;
+
+import cn.iocoder.yudao.framework.common.exception.ServiceException;
+import cn.iocoder.yudao.module.bpm.dal.dataobject.oa.CustomizedBpmOADO;
+import cn.iocoder.yudao.module.bpm.dal.mysql.oa.CustomizedBpmOAMapper;
+import cn.iocoder.yudao.module.bpm.service.task.BpmProcessInstanceService;
+import org.flowable.engine.history.HistoricProcessInstance;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import static cn.iocoder.yudao.framework.common.exception.enums.GlobalErrorCodeConstants.*;
+import static org.assertj.core.api.Assertions.assertThatCode;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * SEC-117：HTTP 发起入口不能借「重新提交」分支操作他人的流程
+ */
+class CustomizedBpmOAServiceImplHttpOwnerTest {
+
+    private final CustomizedBpmOAServiceImpl service = new CustomizedBpmOAServiceImpl();
+    private final CustomizedBpmOAMapper mapper = mock(CustomizedBpmOAMapper.class);
+    private final BpmProcessInstanceService processInstanceService = mock(BpmProcessInstanceService.class);
+
+    @BeforeEach
+    void setUp() {
+        ReflectionTestUtils.setField(service, "customizedBpmOAMapper", mapper);
+        ReflectionTestUtils.setField(service, "processInstanceService", processInstanceService);
+    }
+
+    @Test
+    void firstSubmissionIsAllowed() {
+        when(mapper.selectOne("params_id", 1L)).thenReturn(null);
+
+        assertThatCode(() -> service.validateHttpSubmitOwner(1L, 100L)).doesNotThrowAnyException();
+    }
+
+    @Test
+    void starterMayResubmit() {
+        bind(1L, "pi-1", "100");
+
+        assertThatCode(() -> service.validateHttpSubmitOwner(1L, 100L)).doesNotThrowAnyException();
+    }
+
+    @Test
+    void otherUserCannotResubmitSomeoneElsesInstance() {
+        bind(1L, "pi-1", "100");
+
+        assertThatThrownBy(() -> service.validateHttpSubmitOwner(1L, 200L))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(FORBIDDEN.getCode());
+    }
+
+    @Test
+    void missingHistoricInstanceIsTreatedAsNotOwned() {
+        CustomizedBpmOADO binding = new CustomizedBpmOADO();
+        binding.setProcessInstanceId("pi-gone");
+        when(mapper.selectOne("params_id", 1L)).thenReturn(binding);
+        when(processInstanceService.getHistoricProcessInstance("pi-gone")).thenReturn(null);
+
+        assertThatThrownBy(() -> service.validateHttpSubmitOwner(1L, 100L))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(FORBIDDEN.getCode());
+    }
+
+    @Test
+    void anonymousAndMissingParamsIdAreRejected() {
+        assertThatThrownBy(() -> service.validateHttpSubmitOwner(1L, null))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(UNAUTHORIZED.getCode());
+        assertThatThrownBy(() -> service.validateHttpSubmitOwner(null, 100L))
+                .isInstanceOf(ServiceException.class)
+                .extracting("code").isEqualTo(BAD_REQUEST.getCode());
+    }
+
+    private void bind(Long paramsId, String processInstanceId, String startUserId) {
+        CustomizedBpmOADO binding = new CustomizedBpmOADO();
+        binding.setProcessInstanceId(processInstanceId);
+        when(mapper.selectOne("params_id", paramsId)).thenReturn(binding);
+        HistoricProcessInstance instance = mock(HistoricProcessInstance.class);
+        when(instance.getStartUserId()).thenReturn(startUserId);
+        when(processInstanceService.getHistoricProcessInstance(processInstanceId)).thenReturn(instance);
+    }
+
+}
