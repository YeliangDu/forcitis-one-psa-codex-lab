+package cn.iocoder.yudao.framework.common.util.rpc;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+/**
+ * 服务间内部调用凭证（{@link cn.iocoder.yudao.framework.common.enums.RpcConstants#INTERNAL_TOKEN_HEADER}）的校验工具。
+ *
+ * <p>失败即拒绝：期望值未配置时任何请求都不算合法；比较使用常量时间，避免按响应时长逐字节猜测。
+ */
+public class InternalRpcTokenUtils {
+
+    private InternalRpcTokenUtils() {
+    }
+
+    public static boolean isConfigured(String expectedToken) {
+        return expectedToken != null && !expectedToken.trim().isEmpty();
+    }
+
+    public static boolean matches(String expectedToken, String suppliedToken) {
+        if (!isConfigured(expectedToken) || suppliedToken == null) {
+            return false;
+        }
+        return MessageDigest.isEqual(expectedToken.getBytes(StandardCharsets.UTF_8),
+                suppliedToken.getBytes(StandardCharsets.UTF_8));
+    }
+
+    /**
+     * 轮换期间同时接受当前值与 previous 值。当前值未配置时一律拒绝（只配 previous 视为配置错误）；
+     * previous 未配置时不参与匹配。两个值都参与比较，不因先命中而提前返回
+     */
+    public static boolean matchesAny(String currentToken, String previousToken, String suppliedToken) {
+        if (!isConfigured(currentToken)) {
+            return false;
+        }
+        boolean current = matches(currentToken, suppliedToken);
+        boolean previous = matches(previousToken, suppliedToken);
+        return current | previous;
+    }
+
+}
