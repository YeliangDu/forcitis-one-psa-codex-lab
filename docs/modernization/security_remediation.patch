+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.util.Collections;
+
+import static cn.iocoder.yudao.framework.common.exception.enums.GlobalErrorCodeConstants.BAD_REQUEST;
+import static cn.iocoder.yudao.framework.common.exception.enums.GlobalErrorCodeConstants.FORBIDDEN;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyCollection;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * SEC-119 / SEC-120：只有任务的应处理人可以接受或拒绝（卡片回调、PC、App 共用）
+ */
+class ResourceServiceTaskResponderTest {
+
+    private final ResourceServiceImpl service = new ResourceServiceImpl();
+    private final TaskMapper taskMapper = mock(TaskMapper.class);
+
+    @Test
+    void memberInitiatedTaskIsHandledByManager() {
+        stub(task("100", 100L, 900L));
+
+        assertThat(service.isTaskResponder(1L, 900L)).isTrue();
+        assertThat(service.isTaskResponder(1L, 100L)).isFalse();
+    }
+
+    @Test
+    void managerAssignedTaskIsHandledByMember() {
+        stub(task("900", 100L, 900L));
+
+        assertThat(service.isTaskResponder(1L, 100L)).isTrue();
+        assertThat(service.isTaskResponder(1L, 900L)).isFalse();
+        assertThat(service.isTaskResponder(1L, 555L)).isFalse();
+    }
+
+    @Test
+    void unknownTaskOrUserIsNotAResponder() {
+        ReflectionTestUtils.setField(service, "taskMapper", taskMapper);
+        when(taskMapper.selectById(2L)).thenReturn(null);
+
+        assertThat(service.isTaskResponder(2L, 100L)).isFalse();
+        assertThat(service.isTaskResponder(null, 100L)).isFalse();
+        assertThat(service.isTaskResponder(1L, null)).isFalse();
+    }
+
+    @Test
+    void acceptAndRefuseRejectNonResponders() {
+        // SEC-120：PC / App 的接受、拒绝接口原先不校验处理人
+        TaskDO taskDO = task("100", 100L, 900L);
+        taskDO.setId(1L);
+        ReflectionTestUtils.setField(service, "taskMapper", taskMapper);
+        when(taskMapper.selectList(any(SFunction.class), anyCollection())).thenReturn(Collections.singletonList(taskDO));
+        WebFrameworkUtils.setLoginUserIdOverride(100L);
+        try {
+            assertThatThrownBy(() -> service.acceptTask(Collections.singletonList(1L)))
+                    .isInstanceOf(ServiceException.class)
+                    .extracting("code").isEqualTo(FORBIDDEN.getCode());
+            assertThatThrownBy(() -> service.refuseTask(Collections.singletonList(1L)))
+                    .isInstanceOf(ServiceException.class)
+                    .extracting("code").isEqualTo(FORBIDDEN.getCode());
+        } finally {
+            WebFrameworkUtils.clearLoginUserIdOverride();
+        }
+    }
+
+    @Test
+    void unknownTaskIdIsRejected() {
+        ReflectionTestUtils.setField(service, "taskMapper", taskMapper);
+        when(taskMapper.selectList(any(SFunction.class), anyCollection())).thenReturn(Collections.emptyList());
+        WebFrameworkUtils.setLoginUserIdOverride(900L);
+        try {
+            assertThatThrownBy(() -> service.acceptTask(Collections.singletonList(1L)))
+                    .isInstanceOf(ServiceException.class)
+                    .extracting("code").isEqualTo(BAD_REQUEST.getCode());
+        } finally {
+            WebFrameworkUtils.clearLoginUserIdOverride();
+        }
+    }
+
+    private void stub(TaskDO taskDO) {
+        ReflectionTestUtils.setField(service, "taskMapper", taskMapper);
+        when(taskMapper.selectById(1L)).thenReturn(taskDO);
+    }
+
+    private static TaskDO task(String creator, Long personId, Long managerId) {
+        TaskDO taskDO = new TaskDO();
+        taskDO.setCreator(creator);
+        taskDO.setPersonId(personId);
+        taskDO.setManagerId(managerId);
+        return taskDO;
+    }
+
+}
