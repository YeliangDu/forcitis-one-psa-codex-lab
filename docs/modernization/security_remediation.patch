+package cn.iocoder.yudao.module.fst.service.common;
+
+import cn.hutool.core.util.StrUtil;
+
+import java.util.Map;
+
+/**
+ * 企业微信应用消息的接收人收口（SEC-118）。
+ * <p>PSA 的应用消息都是发给单个审批人或申请人的；toparty / totag 一律去掉，
+ * touser 为空或含 {@code @all}（企业微信约定的「全部成员」）时不发送，避免审批内容广播到全员。
+ */
+public final class WeComMessageRecipientGuard {
+
+    private static final String ALL = "@all";
+
+    private WeComMessageRecipientGuard() {
+    }
+
+    /**
+     * @param contentObj message/send 请求体，会被原地修改
+     * @return true 表示可以发送
+     */
+    public static boolean restrictToUsers(Map<String, Object> contentObj) {
+        if (contentObj == null) {
+            return false;
+        }
+        contentObj.remove("toparty");
