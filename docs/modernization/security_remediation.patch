+package cn.iocoder.yudao.module.fst.service.common;
+
+import com.alibaba.fastjson.JSONObject;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * SEC-118：应用消息只发给 touser，不广播
+ */
+class WeComMessageRecipientGuardTest {
+
+    @Test
+    void stripsPartyAndTagAndKeepsSingleUser() {
+        JSONObject content = new JSONObject();
+        content.put("touser", "zhangsan");
+        content.put("toparty", "@all");
+        content.put("totag", "@all");
+
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(content)).isTrue();
+        assertThat(content).doesNotContainKeys("toparty", "totag");
+        assertThat(content.get("touser")).isEqualTo("zhangsan");
+    }
+
+    @Test
+    void refusesBlankOrAllRecipients() {
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with(null))).isFalse();
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with(" "))).isFalse();
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with("@all"))).isFalse();
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with("@ALL"))).isFalse();
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with("zhangsan|@all"))).isFalse();
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with("zhangsan||lisi"))).isFalse();
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(null)).isFalse();
+    }
+
+    @Test
+    void allowsMultipleNamedUsers() {
+        assertThat(WeComMessageRecipientGuard.restrictToUsers(with("zhangsan|lisi"))).isTrue();
+    }
+
+    private static JSONObject with(String touser) {
+        JSONObject content = new JSONObject();
+        content.put("touser", touser);
+        content.put("toparty", "@all");
+        return content;
+    }
+
+}
