+package cn.iocoder.yudao.module.bpm.controller.admin.oa;
+
+import cn.iocoder.yudao.module.bpm.controller.admin.oa.vo.BpmOACreateReqVO;
+import com.alibaba.fastjson.JSON;
+import com.alibaba.fastjson.JSONArray;
+import com.alibaba.fastjson.JSONObject;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+import static cn.iocoder.yudao.framework.common.exception.enums.GlobalErrorCodeConstants.BAD_REQUEST;
+import static cn.iocoder.yudao.framework.common.exception.util.ServiceExceptionUtil.exception0;
+
+/**
+ * HTTP 发起自定义流程的入参收口（SEC-005）。
+ *
+ * <p>creator / processInstanceVariables 只供进程内 / RPC 调用方（BpmProcessTaskApiImpl）透传，HTTP 入参一律丢弃；
+ * 流程变量改由本类按白名单从 dataStamp 派生（聚合规则与 CustomizedBpmOAServiceImpl#submitApprovalInstance 一致），
+ * dataStamp 原文不变，仍作为审批留痕。
+ */
+public final class CustomizedBpmCreateReqSanitizer {
+
+    /**
+     * 前端经 HTTP 发起的流程：仅 PC 工时单（psa-front-desk-pc/src/api/public.js#createWorkflow）
+     */
+    private static final Set<String> ALLOWED_PROCESS_KEYS = Collections.singleton("TIMESHEET");
+    /**
+     * 可派生为流程变量的工时明细字段（对齐 fst ManHourUpdateVO）；发起人维度变量由服务端补齐，不在此列
+     */
+    private static final Set<String> ALLOWED_VARIABLE_KEYS = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(
+            "id", "taskId", "declareHours", "approvalHours", "progress", "worksDate", "projectCode", "projectName",
+            "type", "workPackageType", "workPackageId", "remarks", "managerId", "termNumber", "stageId", "oppStageId",
+            "costOrgId", "projectOrgId", "profitCenterId")));
+
+    private CustomizedBpmCreateReqSanitizer() {
+    }
+
+    public static void sanitize(BpmOACreateReqVO reqVO) {
+        reqVO.setCreator(null);
+        reqVO.setProcessInstanceVariables(null);
+        if (!ALLOWED_PROCESS_KEYS.contains(reqVO.getProcessKey())) {
+            throw exception0(BAD_REQUEST.getCode(), "不支持发起该流程");
+        }
+        JSONObject variables = new JSONObject();
+        Object stamp;
+        try {
+            stamp = JSON.parse(reqVO.getDataStamp());
+        } catch (RuntimeException e) {
+            throw exception0(BAD_REQUEST.getCode(), "单据数据格式不正确");
+        }
+        if (stamp instanceof JSONObject) {
+            for (Map.Entry<String, Object> entry : ((JSONObject) stamp).entrySet()) {
+                if (ALLOWED_VARIABLE_KEYS.contains(entry.getKey())) {
+                    variables.put(entry.getKey(), entry.getValue());
+                }
+            }
+        } else if (stamp instanceof JSONArray) {
+            for (Object row : (JSONArray) stamp) {
+                if (!(row instanceof JSONObject)) {
+                    continue;
+                }
+                for (Map.Entry<String, Object> entry : ((JSONObject) row).entrySet()) {
+                    if (ALLOWED_VARIABLE_KEYS.contains(entry.getKey())) {
+                        ((Set<Object>) variables.computeIfAbsent(entry.getKey(), k -> new LinkedHashSet<>()))
+                                .add(entry.getValue());
+                    }
+                }
+            }
+        }
+        // 变量为空时服务层会回退为按 dataStamp 全量派生，故必须拦截
+        if (variables.isEmpty()) {
+            throw exception0(BAD_REQUEST.getCode(), "单据数据缺少流程所需字段");
+        }
+        reqVO.setProcessInstanceVariables(variables);
+    }
+
+}
