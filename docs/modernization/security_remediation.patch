+package cn.iocoder.yudao.module.system.framework.sso;
+
+import lombok.Data;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * 外部系统免密登录入口（customization-login / a8-login / singleSignOn/YD-get）的调用方校验配置。
+ * 密钥只放 Nacos，本类不含任何凭据。
+ */
+@ConfigurationProperties(prefix = "psa.sso.trusted-callers")
+@Data
+public class TrustedCallerProperties {
+
+    /**
+     * 是否强制要求签名。过渡期可置 false：未签名请求仅当来源 IP 命中某调用方的 {@link Caller#legacyAllowedIps}
+     * 且该调用方登记了此入口时放行并告警（浏览器跳转入口 a8-login / singleSignOn/YD-get 除外，始终要求签名）；
+     * 改造完成后必须改回 true
+     */
+    private boolean requireSignature = true;
+    /**
+     * PSA 网关在业务服务侧看到的地址（request.getRemoteAddr()，精确 IP）。
+     * 只有来自这些地址的请求才信任网关写入的 {@code X-PSA-Client-IP}；未签名请求只有经由这些网关进入时才可能放行，
+     * 为空时未签名请求一律拒绝
+     */
+    private List<String> gatewayAddresses = new ArrayList<>();
+    /**
+     * 签名时间戳允许的最大偏差；nonce 防重放标记保留其两倍时长
+     */
+    private Duration maxClockSkew = Duration.ofMinutes(5);
+    /**
+     * 调用方编码 → 配置
+     */
+    private Map<String, Caller> callers = new LinkedHashMap<>();
+
+    @Data
+    public static class Caller {
+
+        /**
+         * HMAC-SHA256 共享密钥（Nacos 注入，禁止写入仓库）
+         */
+        private String secret;
+        /**
+         * 该调用方可使用的入口标识（customization-login / customization-login/id / a8-login / singleSignOn/YD-get）；
+         * 为空表示不可使用任何入口
+         */
+        private Set<String> endpoints = new LinkedHashSet<>();
+        /**
+         * 签名请求允许的来源 IP（精确 IP 或 CIDR）；为空表示不限来源，仅凭签名
+         */
+        private List<String> allowedIps = new ArrayList<>();
+        /**
+         * 过渡期未签名请求允许的来源 IP（精确 IP 或不宽于 /29 的 CIDR）；仅 requireSignature=false 时生效
+         */
+        private List<String> legacyAllowedIps = new ArrayList<>();
+
+    }
+
+}
