+@Component("fstLegacyCredentialBinder")
+@Slf4j
+public class LegacyCredentialBinder {
+
+    @Value("${psa.wecom.secret.psa:}")
+    private String weComSecretPsa;
+    @Value("${psa.wecom.secret.psa-prod:}")
+    private String weComSecretPsaProd;
+    @Value("${psa.wecom.callback.encoding-aes-key:}")
+    private String callbackEncodingAesKey;
+    @Value("${psa.wecom.callback.token:}")
+    private String callbackToken;
+
+    @PostConstruct
+    public void bind() {
+        CommonConstants.WeComSecret.PSA = bindOrKeep("psa.wecom.secret.psa", weComSecretPsa, CommonConstants.WeComSecret.PSA);
+        CommonConstants.WeComSecret.PSA_prod = bindOrKeep("psa.wecom.secret.psa-prod", weComSecretPsaProd, CommonConstants.WeComSecret.PSA_prod);
+        FSTConstant.WeComCallback.ENCODING_AES_KEY = bindOrKeep("psa.wecom.callback.encoding-aes-key", callbackEncodingAesKey, FSTConstant.WeComCallback.ENCODING_AES_KEY);
+        FSTConstant.WeComCallback.TOKEN = bindOrKeep("psa.wecom.callback.token", callbackToken, FSTConstant.WeComCallback.TOKEN);
+    }
+
+    /**
+     * 配置缺失时保留字段现值（仓库字面量移除前即原值，移除后为 null），避免先合并本类时把可用凭据覆盖为空
+     */
+    private static String bindOrKeep(String key, String value, String current) {
+        if (StrUtil.isBlank(value)) {
+            log.warn("[bind][凭据配置项({}) 未下发，{}]", key, current == null ? "依赖它的功能将不可用" : "沿用代码内置值");
+            return current;
+        }
+        return value;
+    }
+
+}
