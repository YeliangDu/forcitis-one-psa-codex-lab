+package cn.iocoder.yudao.framework.rpc.config;
+
+import cn.iocoder.yudao.framework.common.enums.RpcConstants;
+import cn.iocoder.yudao.framework.common.util.rpc.InternalRpcTokenUtils;
+import cn.iocoder.yudao.framework.rpc.core.feign.InternalRpcTokenRequestInterceptor;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.autoconfigure.AutoConfiguration;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
+import org.springframework.context.annotation.Bean;
+import org.springframework.core.env.Environment;
+
+/**
+ * RPC 公共自动配置：为所有 Feign 客户端注册内部调用凭证拦截器（父上下文的 RequestInterceptor 对每个客户端生效）
+ */
+@AutoConfiguration
+@ConditionalOnClass(name = "feign.RequestInterceptor")
+public class YudaoRpcAutoConfiguration {
+
+    private static final Logger log = LoggerFactory.getLogger(YudaoRpcAutoConfiguration.class);
+
+    @Bean
+    public InternalRpcTokenRequestInterceptor internalRpcTokenRequestInterceptor(Environment environment) {
+        String token = environment.getProperty(RpcConstants.INTERNAL_TOKEN_PROPERTY);
+        if (!InternalRpcTokenUtils.isConfigured(token)) {
+            log.error("[internalRpcTokenRequestInterceptor][{} 未配置，本服务发出的 /rpc-api 调用不带内部凭证，"
+                    + "将被 system 拒绝（401），下游也不会采信 login-user 头]", RpcConstants.INTERNAL_TOKEN_PROPERTY);
+        }
+        return new InternalRpcTokenRequestInterceptor(token);
+    }
+
+}
