{
  "name": "psa-fe-guardrails-vue",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.{css,vue}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "check:structure": "node scripts/check-structure.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:structure && pnpm build"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.26.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
