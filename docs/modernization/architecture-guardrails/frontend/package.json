{
  "name": "psa-fe-guardrails",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "check:structure": "node scripts/check-structure.mjs",
    "check:lint-config": "node scripts/check-lint-config.mjs",
    "verify": "pnpm typecheck && pnpm check:lint-config && pnpm lint && pnpm check:structure && pnpm build"
  },
  "dependencies": {
    "antd": "^5.29.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "stylelint": "^16.26.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7"
  }
}
