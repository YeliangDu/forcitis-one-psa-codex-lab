<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Docker 停了自动拉起（OPS-1022-OPS-02）。安装：mkdir -p ~/.modernize/psa/ops/bin ~/.modernize/psa/ops/docker-watch；cp scripts/ops/docker_ensure.sh 到 ~/.modernize/psa/ops/bin/；把 __HOME__ 换成用户主目录后放 ~/Library/LaunchAgents/，launchctl bootstrap gui/$(id -u) 该文件；脚本更新后重新 cp 并 cmp 核对。临时停 Docker：touch ~/.modernize/psa/ops/docker-watch/pause，用完删。撤销见 RESOURCES.md -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.forcitis.docker-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.modernize/psa/ops/bin/docker_ensure.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>90</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/.modernize/psa/ops/docker-watch/launchd.err.log</string>
  <key>StandardOutPath</key><string>__HOME__/.modernize/psa/ops/docker-watch/launchd.out.log</string>
</dict>
</plist>
