        "one_legacy_names_ro",
        "one_evidence_ro"
      ],
      "note": "生产只读账号名：出现即视为连生产（只读用法放行）"
    },
    {
      "id": "legacy-ecs",
      "kind": "ecs",
      "patterns": [
        "i-bp1b34hcl0g1cnkdtrb9",
        "i-bp1dqbdqgf4vj53qd1q9",
        "172.16.10.52",
        "172.16.235.83"
      ],
      "note": "老系统与 A8 应用服务器实例 ID 与私网 IP；i-bp122xlpar8w2uylmal2 名叫 production 实为 dev，不入表"
