    ],
    "slots": {
      "seconds": "[0-9]{1,3}",
      "local_url": "(?:http://)?(?:localhost|127\\.0\\.0\\.1):[0-9]{2,5}(?:/[A-Za-z0-9._~/?=&%+-]*)?"
