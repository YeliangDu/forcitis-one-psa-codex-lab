{
  "name": "forcitis-one-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "check:generated": "node scripts/generate-api.mjs --check",
    "typecheck": "node scripts/api-artifacts.mjs --check && pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "eslint . --max-warnings 0 && stylelint \"{apps,packages}/*/src/**/*.css\"",
    "check:structure": "node scripts/check-structure.mjs",
    "check:copy": "node scripts/check-copy-glossary.mjs",
    "test:scripts": "node scripts/api-artifacts.mjs --check && node --test \"scripts/*.test.mjs\"",
    "check:lint-config": "node scripts/check-lint-config.mjs",
    "test": "node scripts/api-artifacts.mjs --check && pnpm -r --workspace-concurrency=1 run test",
    "build": "pnpm generate:api && pnpm -r --workspace-concurrency=1 run build",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "openapi-typescript": "^7.13.0",
    "stylelint": "^16.26.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=24"
  }
}
